// @test: Result type
// @description: Result<T,E> is a built-in generic enum with Ok/Err variants, constructible via Result<Int,String>::Ok/::Err or inferred bare Ok(e)/Err(e), and dispatchable via match.
// @category: types, result, error_handling
// @expect: pass
// @expect-return: 0

main()<Int> -> {
    r<Result<Int,String>> = Ok(42)
    e<Result<Int,String>> = Err("bad")
    got<Int> = 0
    gotErr<Int> = 0
    match (r) {
        Ok(val) -> { got = val },
        Err(msg) -> { got = -1 }
    }
    match (e) {
        Ok(val) -> { gotErr = val },
        Err(msg) -> { gotErr = -1 }
    }
    if (got == 42 && gotErr == -1) {
        return 0
    }
    return 1
}
