// @test: Aspect inheritance
// @description: Aspect inheritance (`aspect Printable : Display`) composes a sub-aspect with a super-aspect; the core `Display` aspect is auto-imported, so the super-aspect reference resolves without an explicit import.
// @category: aspect, types
// @expect: pass
// @expect-return: 0

aspect Printable : Display {
    render(self)<String>
}

main()<Int> -> {
    return 0
}
