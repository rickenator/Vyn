// @test: ensure statement
// @description: ensure is a post-condition statement that runs its handling when the condition is false
// @category: control_flow, error_handling
// @tags: future
// @expect: pass
// @expect-return: 0

// `ensure cond else handling` desugars to `if (cond) { } else { handling }`
// and integrates with the fail/trap system. See test/units/test_ensure_contract.vyb
// for the full coverage set.

main()<Int> -> {
    x<Int> = 10
    ensure x > 0 else return -1
    return 0
}
