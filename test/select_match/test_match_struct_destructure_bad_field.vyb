// @test: struct destructuring rejects unknown fields
// @description: Referencing a field the struct does not have in a destructuring pattern is a semantic error
// @category: pattern matching, match, structs
// @expect: fail
// @expect-error: has no field 'z'

struct Point {
    x<Int>,
    y<Int>
}

main()<Int> -> {
    p<Point> = Point { x = 3, y = 4 }
    match (p) {
        Point { z } -> {
            return z
        }
    }
    return -1
}
