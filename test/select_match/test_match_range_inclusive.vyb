// @test: range patterns are inclusive at both endpoints
// @description: A value equal to the upper (or lower) bound is matched by the range
// @category: pattern matching, match, ranges
// @expect: pass
// @expect-return: 42

main()<Int> -> {
    v<Int> = 3
    match (v) {
        1..3 -> {
            return 42
        },
        ? -> {
            return 0
        }
    }
    return -1
}
