// @test: guard clauses can read destructured struct fields
// @description: A guard can reference fields bound by a preceding struct pattern
// @category: pattern matching, match, guards, structs
// @expect: pass
// @expect-return: 19

struct Point {
    x<Int>,
    y<Int>
}

main()<Int> -> {
    p<Point> = Point { x = 15, y = 4 }
    match (p) {
        Point { x, y } if x > 10 -> {
            return x + y
        },
        Point { x, y } -> {
            return x * y
        }
    }
    return -1
}
