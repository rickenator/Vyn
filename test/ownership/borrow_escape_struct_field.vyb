// @test: struct-field read through an escaped borrow is rejected (#149)
// @description: A `their<Struct>` borrowed from a block-local, read after the
//   local dies, dispatches through freed stack. The compiler now rejects this lexically, so the escaped field read is a
//   borrow-escape error.
// @category: ownership, borrow, escape, lifetime
// @expect: fail
// @expect-error: escapes its scope

struct Counter { c<Int>, name<String> }

main()<Int> -> {
    tmp<Counter> = Counter { c = 0, name = "" }
    r<their<Counter>> = borrow(tmp)
    {
        ctr<Counter> = Counter { c = 42, name = "alive" }
        r = borrow(ctr)
    }
    v<Int> = r.c
    return v
}
