// @test: borrow escape via an inner scope is rejected (#149)
// @description: A `their<T>` borrowed from a block-local that goes out of scope
//   must not be readable afterward. The compiler now rejects it lexically: a `their<T>` value is only valid while
//   the scope that recorded its `borrow()` is still open, so using `r` after the
//   block has gone out of scope is a borrow-escape error.
// @category: ownership, borrow, escape, lifetime
// @expect: fail
// @expect-error: escapes its scope

main()<Int> -> {
    r<their<Int>> = my(0)
    {
        x<Int> = 7
        r = borrow(x)
    }
    # x is gone; reading through the escaped borrow is use-after-free.
    v<Int> = r
    return v
}
