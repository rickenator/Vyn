// @test: mild grab upgrades live owner
// @description: mild<T>.grab() returns the native our<T>? -- present (a retained our<T>)
//   while the target is live, absent once released; consumed with the optional match.
// @category: ownership, mild
// @expect: pass
// @expect-return: 0

struct Node {
    value<Int>
}

main()<Int> -> {
    owner<our<Node>> = our(Node { value: 33 })
    weak<mild<Node>> = soft(owner)
    grabbed<our<Node>?> = weak.grab()
    match (grabbed) {
        o -> {
            if (o.value == 33) {
                return 0
            }
        }
        ? -> { }
    }
    return 1
}
