// @test: mild grab upgrades live owner
// @description: mild<T>.grab() returns Option<our<T>> -- Some(our<T>) while the target is live, None once released
// @category: ownership, mild
// @expect: pass
// @expect-return: 0

struct Node {
    value<Int>
}

main()<Int> -> {
    owner<our<Node>> = our(Node { value: 33 })
    weak<mild<Node>> = soft(owner)
    grabbed<Option<our<Node>>> = weak.grab()
    got<our<Node>> = grabbed.value   // live grab is Some(our<Node>)
    if (got.value == 33) {
        return 0
    }
    return 1
}
