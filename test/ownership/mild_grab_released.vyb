// @test: mild grab released target upgrades to None
// @description: mild<T>.grab() on a released target returns None (the failed-upgrade
// path), safely detectable by match without dereferencing a null handle.
// @category: ownership, mild
// @expect: pass
// @expect-return: 0

struct Node {
    value<Int>
}

make_weak()<mild<Node>> -> {
    owner<our<Node>> = our(Node { value: 44 })
    weak<mild<Node>> = soft(owner)
    return weak
}

main()<Int> -> {
    weak<mild<Node>> = make_weak()
    grabbed<Option<our<Node>>> = weak.grab()
    r<Int> = match(grabbed) {
        Some(o) -> 0
        None -> 1
    }
    if (r == 1 && weak.released()) {
        return 0
    }
    return 1
}
