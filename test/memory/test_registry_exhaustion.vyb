// @test: string reference-count registry exhaustion fails deterministically (#162)
// @env: VYB_STR_REG_CAP=16
// @expect: fail
// @expect-error: string reference-count registry exhausted
// @execute-jit: true
// @description: With the registry capacity forced low (16 slots), sustained
//   string allocation churn (concat + from_byte) exhausts the table. It must
//   fail loudly and deterministically instead of silently leaving an
//   allocation untracked (which would leak / corrupt reference counts).
main()<Int> -> {
    s<String> = ""
    i<Int> = 0
    while (i < 1000) {
        s = s.concat(String::from_byte(i % 256))
        i += 1
    }
    return 0
}