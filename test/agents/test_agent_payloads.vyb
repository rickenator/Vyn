# Agents - payload breadth (Stage 2): Bool, Float, and String messages.
#   - Int/Bool/Float ride the agent's int-slot mailbox
#   - String messages use a refcounted strchan mailbox (owned transfer)
#   - lifecycle (close/free/alive/len) is payload-agnostic
// @test: Agents - Bool, Float, String payloads
// @category: agents,concurrency,stdlib
// @expect: pass
// @expect-return: 0

import agents
import channels

main()<Int> -> {
    # Bool messages
    bres<Int> = chan_new() else 0
    ba<Int> = agent_start_bool(|message<Bool?>| -> {
        match (message) {
            b -> { if (b) { chan_send(bres, 1) } else { chan_send(bres, 0) } }
            ? -> { }
        }
    }) else 0
    agent_send_bool(ba, true)
    agent_send_bool(ba, false)
    b1<Int> = chan_recv(bres) else -1
    b2<Int> = chan_recv(bres) else -1
    println("bool1=" + b1.to_string() + " bool2=" + b2.to_string())
    agent_close(ba)
    agent_free(ba)
    chan_free(bres)

    # Float messages (exact value round-trip verified via to_string)
    frep<Int> = strchan_new() else 0
    fa<Int> = agent_start_float(|message<Float?>| -> {
        match (message) {
            f -> { strchan_send(frep, f.to_string()) }
            ? -> { }
        }
    }) else 0
    agent_send_float(fa, 1.25)
    agent_send_float(fa, -0.5)
    f1<String> = strchan_recv(frep) else ""
    f2<String> = strchan_recv(frep) else ""
    println("float1=" + f1 + " float2=" + f2)
    agent_close(fa)
    agent_free(fa)
    strchan_free(frep)

    # String messages (owned transfer; behavior echoes an uppercased result)
    srep<Int> = strchan_new() else 0
    sa<Int> = agent_start_string(|message<String?>| -> {
        match (message) {
            sv -> { strchan_send(srep, sv + "!") }
            ? -> { }
        }
    }) else 0
    agent_send_string(sa, "hello")
    agent_send_string(sa, "agent")
    s1<String> = strchan_recv(srep) else ""
    s2<String> = strchan_recv(srep) else ""
    println("str1=" + s1 + " str2=" + s2)
    agent_close(sa)
    agent_free(sa)
    strchan_free(srep)

    return 0
}
