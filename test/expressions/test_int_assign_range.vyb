// @test: Integer constant out-of-range is an error
// @description: assigning a constant that does not fit the target integer range
//   is a compile error instead of a silent truncation.
// @category: expressions, types
// @expect: fail
// @semantic-only: true
// @expect-error: out of range for type

main()<Int> -> {
    x<Int8> = 300          // 300 does not fit Int8 (-128..127)
    return 0
}
