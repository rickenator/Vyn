// @test: threaded HTTP server - concurrent accept + per-connection workers
// @description: http_serve starts a detached accept-loop thread and serves each
//   connection on its own detached worker, so the server keeps accepting while
//   earlier connections are handled. Verified by standing up a server and
//   answering two simultaneous clients (each gets its own path echoed back).
// @category: modules, http, threads, concurrency, network, stdlib
// @expect: pass
// @expect-output: ok
// @expect-return: 0
// @env: VYB_STDLIB=stdlib

import http
import network::{socket_open, socket_connect, socket_send, socket_recv,
                 socket_close, Socket}
import time::{sleep_ms}

main()<Int> -> {
    srv<Int> = http_serve(0, 16)
    if (srv < 0) { return 1 }
    port<Int> = http_local_port(srv)
    if (port <= 0) { return 2 }

    // Two concurrent clients connect while the accept thread is still looping.
    c1<Int> = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, 0)
    c2<Int> = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, 0)
    if (c1 < 0 || c2 < 0) { return 3 }
    if (socket_connect(c1, "127.0.0.1", port) < 0) { return 4 }
    if (socket_connect(c2, "127.0.0.1", port) < 0) { return 5 }

    socket_send(c1, "GET /one HTTP/1.1\r\nHost: t\r\n\r\n")
    socket_send(c2, "GET /two HTTP/1.1\r\nHost: t\r\n\r\n")

    // Give the worker threads time to read + answer (concurrent handling).
    sleep_ms(300)

    r1<String> = ""
    while (r1.len() < 512) {
        chunk<String> = socket_recv(c1, 256)
        if (chunk.len() == 0) { break }
        r1 = r1.concat(chunk)
    }
    r2<String> = ""
    while (r2.len() < 512) {
        chunk<String> = socket_recv(c2, 256)
        if (chunk.len() == 0) { break }
        r2 = r2.concat(chunk)
    }
    socket_close(c1)
    socket_close(c2)

    if (!r1.starts_with("HTTP/1.1 200 OK")) { return 6 }
    if (!r2.starts_with("HTTP/1.1 200 OK")) { return 7 }
    if (r1.index_of("hi from vyb: /one") < 0) { return 8 }
    if (r2.index_of("hi from vyb: /two") < 0) { return 9 }

    println("ok")
    return 0
}
