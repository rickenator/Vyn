// @test: http module HttpError shared across modules via fail/trap
// @description: a failed http_get_full (absent HttpResponse? against a dead
//   port) is escalated from a failable helper with http::http_error -> an
//   HttpError caught by main's trap; the fields carry op/target/message.
// @category: http, modules, stdlib, error_handling, fail, trap
// @expect: pass
// @expect-output: http-error-trap: ok
// @expect-return: 0
// @env: VYB_STDLIB=stdlib

import network::{socket_open, socket_bind, socket_listen, socket_local_port,
                 socket_close, Socket}
import http::{http_get_full, http_error, HttpError}

# Failable helper: an absent HttpResponse? is escalated into an HttpError so the
# caller can trap the real typed value (the fail is in this callee, so main's own
# return serialization stays intact).
try_fetch(port<Int>)<Void> -> {
    match (http_get_full("127.0.0.1", port, "/nope")) {
        r -> { }
        ? -> { fail http_error("get", "127.0.0.1:" + port.to_string()) }
    }
}

main()<Int> -> {
    // Reserve + close an ephemeral port so connecting to it deterministically
    // refuses (an absent HttpResponse? instead of a valid page).
    fd<Int> = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, 0) else -1
    if (fd < 0) { return 1 }
    if (!(socket_bind(fd, "127.0.0.1", 0) else false)) { return 2 }
    if (!(socket_listen(fd, 1) else false)) { return 3 }
    port<Int> = socket_local_port(fd) else -1
    socket_close(fd)

    op = ""
    tgt = ""
    msg = ""
    caught<Bool> = false
    { try_fetch(port) } trap (e<HttpError>) -> {
        caught = true
        op = e.op
        tgt = e.target
        msg = e.message
    }
    expect<String> = "127.0.0.1:" + port.to_string()
    if (!caught) { println("http-error-trap: failed"); return 4 }
    if (op != "get") { println("http-error-trap: failed"); return 4 }
    if (tgt != expect) { println("http-error-trap: failed"); return 4 }
    if (msg == "") { println("http-error-trap: failed"); return 4 }
    println("http-error-trap: ok")
    return 0
}
