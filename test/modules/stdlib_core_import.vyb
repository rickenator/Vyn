// @test: Stdlib core module import via VYB_STDLIB
// @description: import core::math resolves from VYB_STDLIB without --module-path
// @category: modules
// @expect: pass
// @expect-output: 7
// @env: VYB_STDLIB=stdlib

import core::math::{clamp}

main()<Int> -> {
    println_int(clamp(7, 1, 10))
    return 0
}
