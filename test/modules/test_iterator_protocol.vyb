// @test: Iterator aspect protocol (core::iter)
// @description: a type that binds core::iter::Iterator (setting associated type
//   Item) is consumable by repeated .next() calls returning the native optional
//   `Item?` (present bare value / absent); a by-ref receiver advances internal
//   cursor state in place. Consumed with the optional match surface
//   (`v -> ...; ? -> break`), and the surface the `for`-loop desugar targets.
// @category: stdlib, iterator, aspect, modules
// @expect: pass
// @expect-output: iter-ok
// @expect-return: 0
// @env: VYB_STDLIB=stdlib

import core::iter

struct RangeIter {
    cur<Int>,
    end<Int>
}

bind Iterator -> RangeIter {
    type Item = Int
    next(self<their<RangeIter>>)<Int?> -> {
        if (self.cur < self.end) {
            v<Int> = self.cur
            self.cur = self.cur + 1
            return Int?(v)
        }
        return Int?()
    }
}

struct FloatStepIter {
    cur<Float>,
    end<Float>,
    step<Float>
}

bind Iterator -> FloatStepIter {
    type Item = Float
    next(self<their<FloatStepIter>>)<Float?> -> {
        if (self.cur < self.end) {
            v<Float> = self.cur
            self.cur = self.cur + self.step
            return Float?(v)
        }
        return Float?()
    }
}

main()<Int> -> {
    r<RangeIter> = RangeIter { cur = 0, end = 5 }
    total<Int> = 0
    while (true) {
        match (r.next()) {
            v -> { total = total + v }
            ? -> { break }
        }
    }
    s<Int> = total
    if (s != 10) {
        println("iter-fail-sum:" + s)
        return 1
    }

    f<FloatStepIter> = FloatStepIter { cur = 0.0, end = 3.0, step = 1.0 }
    fsum<Float> = 0.0
    while (true) {
        match (f.next()) {
            x -> { fsum = fsum + x }
            ? -> { break }
        }
    }
    if (fsum != 3.0) {
        println(fsum)
        return 2
    }

    println("iter-ok")
    return 0
}
