// @test: pure-Vyb UdpSocket wrapper over loopback datagrams
// @description: two bound UdpSockets talk: A sends a datagram to B, B receives
//   it and the last-peer probes report where it came from (A's address/port).
//   udp_bind returns a native optional; the `?` arm is a failed bind.
// @expect: pass
// @expect-output: ok
// @expect-return: 0
// @env: VYB_STDLIB=stdlib

import network

main()<Int> -> {
    match (udp_bind("127.0.0.1", 0)) {
        a -> {
            match (udp_bind("127.0.0.1", 0)) {
                b -> {
                    ap<Int> = a.local_port()
                    bp<Int> = b.local_port()
                    # send_to returns Int? -- present holding bytes sent, absent
                    # on failure; `else -1` keeps the "failure" signal visible.
                    n<Int> = a.send_to("127.0.0.1", bp, "ping udp") else -1
                    if (n < 0) { return 3 }

                    msg<String> = b.recv_from(4096) else ""
                    if (msg != "ping udp") { return 4 }
                    pip<String> = udp_last_peer_ip() else ""
                    pport<Int> = udp_last_peer_port() else 0
                    if (pip != "127.0.0.1") { return 5 }
                    if (pport != ap) { return 6 }

                    a.close()
                    b.close()
                    println("ok")
                    return 0
                }
                ? -> { return 2 }
            }
        }
        ? -> { return 1 }
    }
}
