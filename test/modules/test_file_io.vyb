// @test: File I/O open/close/read_all/write_str
// @description: write a file, reopen read, read it back, check content/close, and
//   exercise the error surface (a missing path is the absent `File?`, with a
//   non-zero error code for the diagnostic message).
// @category: io, stdlib, files
// @expect: pass
// @expect-output: io-ok
// @expect-return: 0
// @env: VYB_STDLIB=stdlib

import io

main()<Int> -> {
    path<String> = "/tmp/vyb_file_io_test.txt"
    content<String> = ""

    match (open_write(path)) {
        w -> {
            # write_str returns Int? -- present holding bytes written, absent on
            # failure; `else -1` recovers the old sentinel view.
            n<Int> = write_str(w, "hello vyb") else -1
            if (n != 9) {
                println("io-fail-write:" + error_message())
                close(w)
                return 2
            }
            # close returns Bool? -- absent on failure.
            if (!(close(w) else false)) {
                println("io-fail-close:" + error_message())
                return 3
            }
        }
        ? -> {
            println("io-fail-open-write:" + error_message())
            return 1
        }
    }

    match (open_read(path)) {
        r -> {
            # read_all returns String? -- present holding the content (possibly
            # empty), absent on failure.
            content = read_all(r) else ""
            close(r)
        }
        ? -> {
            println("io-fail-open-read:" + error_message())
            return 4
        }
    }
    if (content != "hello vyb") {
        println("io-fail-content:" + content)
        return 5
    }

    # A missing file is the absent optional (no sentinel fd to test).
    missing<Bool> = false
    match (open_read("/tmp/vyb_does_not_exist_xyz")) {
        x -> { missing = true }
        ? -> { missing = false }
    }
    if (missing || error_code() == 0) {
        println("io-fail-missing:" + error_message())
        return 6
    }

    println("io-ok")
    return 0
}
