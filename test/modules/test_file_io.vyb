// @test: File I/O open/close/read_all/write_str
// @description: write a file, reopen read, read it back, check content/close, and
//   exercise the error surface (missing path reports a non-zero error code).
// @category: io, stdlib, files
// @expect: pass
// @expect-output: io-ok
// @expect-return: 0
// @env: VYB_STDLIB=stdlib

import io

main()<Int> -> {
    path<String> = "/tmp/vyb_file_io_test.txt"

    w<File> = open_write(path)
    if (w.fd < 0) {
        println("io-fail-open-write:" + error_message())
        return 1
    }
    n<Int> = write_str(w, "hello vyb")
    if (n != 9) {
        println("io-fail-write:" + error_message())
        close(w)
        return 2
    }
    if (close(w) != 0) {
        println("io-fail-close:" + error_message())
        return 3
    }

    r<File> = open_read(path)
    if (r.fd < 0) {
        println("io-fail-open-read:" + error_message())
        return 4
    }
    content<String> = read_all(r)
    close(r)
    if (content != "hello vyb") {
        println("io-fail-content:" + content)
        return 5
    }

    bad<File> = open_read("/tmp/vyb_does_not_exist_xyz")
    ec<Int> = error_code()
    if (bad.fd >= 0 || ec == 0) {
        close(bad)
        println("io-fail-missing:" + error_message())
        return 6
    }

    println("io-ok")
    return 0
}
