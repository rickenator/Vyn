// @test: threads stdlib module - pthread spawn/join + mutex
// @description: the `threads` module wraps POSIX threads: thread_spawn runs a
//   `fn() -> Int` closure on a fresh pthread, thread_join blocks for its result,
//   thread_detach makes a fire-and-forget thread self-reap its slot, and a Mutex
//   provides mutual exclusion. Verified: per-thread results, overlap (three
//   ~60ms sleeps joined in reverse finish in well under the 180ms a sequential
//   run would take), invalid/already-joined/detached handles, slot reclamation
//   past the 256 cap, and a full mutex lock/unlock/free round-trip.
// @category: modules, threads, concurrency, stdlib
// @expect: pass
// @expect-output: ok
// @expect-return: 0
// @env: VYB_STDLIB=stdlib

import threads
import time::{sleep_ms, time_mono_millis}

main()<Int> -> {
    // Correctness: each thread returns its own result; sum matches.
    a<Int> = thread_join(thread_spawn(|| -> 10) else -1) else -2
    b<Int> = thread_join(thread_spawn(|| -> 20) else -1) else -2
    c<Int> = thread_join(thread_spawn(|| -> 12) else -1) else -2
    if (a + b + c != 42) { return 1 }

    // Edge cases: unknown handle and already-joined handle both report -2.
    if ((thread_join(9999) else -2) != -2) { return 2 }
    d<Int> = thread_spawn(|| -> 7) else -1
    if ((thread_join(d) else -2) != 7) { return 3 }
    if ((thread_join(d) else -2) != -2) { return 4 }

    // Detach semantics: a detached thread is not joinable (-2), detaching it
    // again reports -1, and a handle already reclaimed by join detaches to -2.
    e<Int> = thread_spawn(|| -> 0) else -1
    if (e < 0) { return 12 }
    if (!(thread_detach(e) else false)) { return 13 }
    if ((thread_join(e) else -2) != -2) { return 14 }
    if (thread_detach(e) else false) { return 15 }   # already detached -> absent
    f<Int> = thread_spawn(|| -> 0) else -1
    if (f < 0) { return 16 }
    if ((thread_join(f) else -2) != 0) { return 17 }
    if (thread_detach(f) else false) { return 18 }   # already reaped -> absent
    if (thread_detach(9999) else false) { return 19 }   # bad handle -> absent

    // Reaper: spawn+detach more than the 256-slot cap sequentially; the
    // detached reaper frees each slot as its body returns, so no spawn fails.
    k<Int> = 0
    while (k < 260) {
        g<Int> = thread_spawn(|| -> 0) else -1
        if (g < 0) { return 20 }  // table would be full without the reaper
        thread_detach(g)
        sleep_ms(1)
        k = k + 1
    }

    // True parallelism: three ~60ms threads joined in reverse finish in far less
    // than the 180ms a sequential run would take (>=30ms overlap => concurrent).
    hs<Vec<Int>> = Vec<Int>()
    start<Int> = time_mono_millis()
    hs.push(thread_spawn(|| -> sleep_ms(60)) else -1)
    hs.push(thread_spawn(|| -> sleep_ms(60)) else -1)
    hs.push(thread_spawn(|| -> sleep_ms(60)) else -1)
    if (hs.get(0) < 0 || hs.get(1) < 0 || hs.get(2) < 0) { return 5 }
    j<Int> = 2
    while (j >= 0) {
        thread_join(hs.get(j))
        j = j - 1
    }
    elapsed<Int> = time_mono_millis() - start
    if (elapsed >= 150) { return 6 }  // not concurrent (>=180 would be sequential)
    if (elapsed < 30) { return 7 }    // implausibly instant

    // Mutex round-trip.
    m<Int> = mutex_new() else 0
    if (m == 0) { return 8 }
    if (!(mutex_lock(m) else false)) { return 9 }
    if (!(mutex_unlock(m) else false)) { return 10 }
    if (!(mutex_free(m) else false)) { return 11 }

    println("ok")
    return 0
}
