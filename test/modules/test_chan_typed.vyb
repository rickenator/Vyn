// @test: typed chan<T> channels - Int and String payloads
// @description: `chan<T>` is a built-in typed channel. `chan<Int>()` /
//   `chan<Int>(cap)` construct an unbounded/bounded channel. The typed surface
//   is `send(v)`, `recv()` (blocking), `poll()` (non-blocking -> `T?` optional,
//   consumed via `poll() else default`), `len()`, `handle()` (raw Int handle for
//   select), and `free()`. A String payload uses the refcounted string-channel
//   runtime; scalar Int uses the int-slot runtime.
// @category: modules, threads, channels, concurrency, stdlib
// @expect: pass
// @expect-output: ok
// @expect-return: 0

main()<Int> -> {
    ch<chan<Int>> = chan<Int>()
    if (ch == 0) { return 1 }
    if (ch.len() != 0) { return 2 }
    if (ch.send(42) != 1) { return 3 }
    if (ch.len() != 1) { return 4 }
    v<Int> = ch.recv()
    if (v != 42) { return 5 }
    if (ch.send(7) != 1) { return 6 }
    te<Int> = ch.poll() else 0
    if (te != 7) { return 7 }
    if (ch.handle() == 0) { return 8 }
    if (ch.free() != 0) { return 9 }

    # Bounded channel: fixed capacity, a full send returns 0, order preserved.
    bc<chan<Int>> = chan<Int>(2)
    if (bc == 0) { return 10 }
    if (bc.send(1) != 1) { return 11 }
    if (bc.send(2) != 1) { return 12 }
    if (bc.send(3) != 0) { return 13 }        # full
    if (bc.len() != 2) { return 14 }
    if (bc.recv() != 1) { return 15 }
    if ((bc.poll() else 0) != 2) { return 16 }
    if (bc.send(9) != 1) { return 17 }        # space freed by recv/poll
    if ((bc.poll() else 0) != 9) { return 18 }
    if (bc.len() != 0) { return 19 }
    if (bc.free() != 0) { return 20 }

    # String payloads: an unbounded String channel round-trips strings.
    sc<chan<String>> = chan<String>(4)
    if (sc == 0) { return 21 }
    if (sc.send("hi") != 1) { return 22 }
    s<String> = sc.recv()
    if (s != "hi") { return 23 }
    if (sc.len() != 0) { return 24 }
    if (sc.send("a") != 1) { return 25 }
    if (sc.send("b") != 1) { return 26 }
    if (sc.send("c") != 1) { return 27 }
    if (sc.send("d") != 1) { return 28 }
    if (sc.send("e") != 0) { return 29 }      # bounded String channel full
    if (sc.poll() != "a") { return 30 }
    if (sc.recv() != "b") { return 31 }
    if (sc.free() != 0) { return 32 }

    println("ok")
    return 0
}
