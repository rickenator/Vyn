// @test: io module IoError shared across modules via fail/trap
// @description: an absent File? is escalated with io::io_error -> an IoError
//   caught by a cross-module trap; the fields carry operation/path/message.
// @category: io, modules, stdlib, error_handling, fail, trap
// @expect: pass
// @expect-return: 0
// @execute-jit: true
// @env: VYB_STDLIB=stdlib

import io::{open_read, read_all, open_write, write_str, close, io_error, IoError}

open_data(path<String>)<String> -> {
    match (open_read(path)) {
        f -> {
            s<String> = read_all(f) else ""
            close(f)
            return s
        }
        ? -> {
            fail io_error("open", path)
        }
    }
}

main()<Int> -> {
    # A missing file escalates into an IoError that a caller can trap.
    caught<Bool> = false
    op = ""
    pth = ""
    msg = ""
    {
        s<String> = open_data("/tmp/vyb_no_such_file_xyz_12345")
        println("unexpected: " + s)
    } trap (e<IoError>) -> {
        caught = true
        op = e.operation
        pth = e.path
        msg = e.message
    }

    if (!caught || op != "open" || pth != "/tmp/vyb_no_such_file_xyz_12345" || msg == "") {
        println("io-error-trap: failed")
        return 1
    }

    # The happy path must not raise, and the IoError literal is available
    # cross-module (partial-field struct literal).
    direct<IoError> = IoError { operation = "read", path = "/tmp/x" }
    # Create the file first so the read path is the true happy path.
    match (open_write("/tmp/vyb_io_ok_test.txt")) {
        w -> { write_str(w, "ok"); close(w) }
        ? -> { println("io-error-trap: setup-failed"); return 3 }
    }
    ok<Int> = {
        content<String> = open_data("/tmp/vyb_io_ok_test.txt")
        content.len()
    } trap (e<IoError>) -> { -77 }
    if (ok != 2 || direct.operation != "read") {
        println("io-error-trap: happy-path failed")
        return 2
    }

    println("io-error-trap: ok")
    return 0
}
