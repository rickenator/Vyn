// @test: channels stdlib module - String-payload channels
// @description: `import channels` gives strchan_new/send/recv/try/free for Vyb
//   String payloads over the same pthread ring-buffer model. On send the data
//   pointer is retained so the string outlives the sender; recv/try transfer
//   that reference to the caller. Verified: a producer thread enqueues a String
//   the consumer blocks on recv for and reads back intact, strchan_try reports
//   absence (else "" recovers the old sentinel) when nothing is buffered, a
//   bounded String channel respects its capacity, a genuine "" payload round-
//   trips losslessly, and the handle frees cleanly. send returns Bool.
// @category: modules, channels, strings, concurrency, stdlib
// @expect: pass
// @expect-output: ok
// @expect-return: 0
// @env: VYB_STDLIB=stdlib

import channels
import threads
import time::{sleep_ms}

main()<Int> -> {
    # Blocking recv of a String delivered by a worker thread.
    sc<Int> = strchan_new()
    if (sc == 0) { return 1 }
    if (strchan_len(sc) != 0) { return 2 }
    # Empty channel: try reports absence; `else ""` recovers the old sentinel.
    if ((strchan_try(sc) else "") != "") { return 3 }

    w<Int> = thread_spawn(|| -> { sleep_ms(5); strchan_send(sc, "hello from worker"); return 0 }) else -1
    if (w < 0) { return 4 }
    if ((strchan_recv(sc) else "") != "hello from worker") { return 5 }
    if ((thread_join(w) else -2) != 0) { return 6 }

    # Bounded String channel: full send returns 0, order preserved.
    bs<Int> = strchan_bounded(2)
    if (bs == 0) { return 7 }
    if (!strchan_send(bs, "one")) { return 8 }
    if (!strchan_send(bs, "two")) { return 9 }
    if (strchan_send(bs, "three")) { return 10 }   # full -> false
    if (strchan_len(bs) != 2) { return 11 }
    if ((strchan_recv(bs) else "") != "one") { return 12 }
    if ((strchan_recv(bs) else "") != "two") { return 13 }
    if (strchan_len(bs) != 0) { return 14 }

    # Lossless payloads: a genuine "" String is data, not "empty".
    es<Int> = strchan_new()
    if (es == 0) { return 15 }
    if (!strchan_send(es, "")) { return 16 }
    if ((strchan_recv(es) else "missing") != "") { return 17 }   # "" read back
    strchan_close(es)
    if ((strchan_recv(es) else "") != "") { return 18 }          # drained -> absent
    if (!(strchan_free(es) else false)) { return 19 }

    if (!(strchan_free(sc) else false)) { return 20 }
    if (!(strchan_free(bs) else false)) { return 21 }

    println("ok")
    return 0
}
