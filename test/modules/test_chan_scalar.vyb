// @test: typed chan<T> channels - Float, Bool, and Char payloads
// @description: chan<Float>, chan<Bool>, and chan<Char> carry scalar payloads
//   through the int-slot channel runtime. A Float travels as its IEEE bit
//   pattern, Bool as 0/1, and Char as its code unit, so send/recv round-trip
//   exactly. Scalar poll() returns the native optional `T?`: present when a
//   value is buffered, absent when empty, consumed via `poll() else default`.
// @category: modules, threads, channels, concurrency, stdlib
// @expect: pass
// @expect-output: ok
// @expect-return: 0

main()<Int> -> {
    fc<chan<Float>> = chan<Float>()
    if (fc == 0) { return 1 }
    if (fc.send(2.5) != 1) { return 2 }
    f<Float> = fc.recv()
    if (f != 2.5) { return 3 }
    if ((fc.poll() else -999.0) != -999.0) { return 4 }   # empty -> absent
    if (fc.send(-1.25) != 1) { return 5 }
    fo<Float> = fc.poll() else -999.0
    if (fo != -1.25) { return 6 }                          # present -> payload
    if (fc.send(0.0) != 1) { return 7 }
    if (fc.recv() != 0.0) { return 8 }
    if (fc.free() != 0) { return 9 }

    bc<chan<Bool>> = chan<Bool>()
    if (bc == 0) { return 10 }
    if (bc.send(true) != 1) { return 11 }
    if (bc.recv() != true) { return 12 }
    # Empty poll is absent: the default is used and nothing is consumed.
    if (bc.len() != 0) { return 13 }
    if ((bc.poll() else true) != true) { return 14 }
    if (bc.len() != 0) { return 15 }
    # A present false is delivered as the bare value (not confused with absent).
    if (bc.send(false) != 1) { return 16 }
    bo<Bool> = bc.poll() else true
    if (bo != false) { return 17 }
    if (bc.send(true) != 1) { return 18 }
    if (bc.recv() != true) { return 19 }
    if (bc.free() != 0) { return 20 }

    cc<chan<Char>> = chan<Char>()
    if (cc == 0) { return 21 }
    if (cc.send(65) != 1) { return 22 }
    if (cc.recv() != 65) { return 23 }
    if ((cc.poll() else 0) != 0) { return 24 }             # empty -> absent
    if (cc.send(66) != 1) { return 25 }
    co<Char> = cc.poll() else 0
    if (co != 66) { return 26 }                            # present -> payload
    if (cc.free() != 0) { return 27 }

    println("ok")
    return 0
}
