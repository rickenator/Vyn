// @test: process stdlib module - run commands and capture output
// @description: exec_run / exec_output are freedom-gated capabilities, so these
//   deterministic exit-code + stdout-capture checks run inside `freedom` blocks;
//   exec_status (the read-only probe) is callable from ordinary code.
// @category: process, stdlib
// @expect: pass
// @expect-return: 0
// @env: VYB_STDLIB=stdlib

import process::{exec_run, exec_output, exec_status}

main()<Int> -> {
    // Exit codes flow through directly; exec requires an explicit freedom block.
    freedom {
        if (exec_run("true") != 0) { return 1 }
        if (exec_run("false") != 1) { return 2 }
        if (exec_run("exit 7") != 7) { return 3 }
    }

    // exec_output captures stdout; also freedom-gated.
    out<String> = ""
    code<Int> = -1
    freedom {
        out = exec_output("printf hello")
        code = exec_run("false")
    }
    if (out != "hello") { return 4 }
    if (code != 1) { return 5 }

    // exec_status is a read-only probe and works from ordinary code.
    if (exec_status() != 1) { return 6 }

    println("process ok")
    return 0
}
