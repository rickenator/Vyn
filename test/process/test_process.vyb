// @test: process stdlib module - run commands and capture output
// @description: exec_run / exec_output are freedom-gated capabilities, so these
//   deterministic exit-code + stdout-capture checks run inside `freedom` blocks;
//   exec_status (the read-only probe) is callable from ordinary code. The T?
//   shapes make a genuinely empty stdout distinct from a failed capture:
//   exec_run gives Int? (absent = could not launch), exec_output gives String?
//   (absent = launch failure; an empty-but-present String = a run that wrote no
//   stdout).
// @category: process, stdlib
// @expect: pass
// @expect-return: 0
// @env: VYB_STDLIB=stdlib

import process::{exec_run, exec_output, exec_status}

main()<Int> -> {
    // Exit codes flow through directly.
    freedom {
        if ((exec_run("true") else 999) != 0) { return 1 }
        if ((exec_run("false") else 999) != 1) { return 2 }
        if ((exec_run("exit 7") else 999) != 7) { return 3 }
    }

    // exec_output captures stdout; also freedom-gated.
    out<String> = ""
    empty_ok<String> = "SENTINEL"
    code<Int> = -1
    freedom {
        out = exec_output("printf hello") else ""
        empty_ok = exec_output("true") else "SENTINEL"   # empty stdout, still present
        code = exec_run("false") else -1
    }
    if (out != "hello") { return 4 }
    if (empty_ok != "") { return 5 }
    if (code != 1) { return 6 }

    # exec_status is a read-only probe and works from ordinary code.
    if (exec_status() != 1) { return 7 }

    println("process ok")
    return 0
}
