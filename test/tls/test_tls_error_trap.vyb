// @test: tls module TlsError shared across modules via fail/trap
// @description: a failed verified handshake (wrong hostname against a pinned
//   self-signed cert) is escalated with tls::tls_error -> a TlsError caught by a
//   cross-module trap; the fields carry op/host/message. A correct-hostname
//   round-trip is the happy path and must not raise.
// @category: tls, modules, stdlib, error_handling, fail, trap
// @expect: pass
// @expect-output: tls-error-trap: ok
// @expect-return: 0
// @execute-jit: true
// @env: VYB_STDLIB=stdlib

import network::{socket_open, socket_bind, socket_listen, socket_accept,
                 socket_connect, socket_close, socket_local_port, Socket}
import threads::{thread_spawn, thread_join}
import tls::{tls_client_context_verified, tls_server_context, tls_stream,
             tls_read, tls_write, tls_close, tls_free_context,
             tls_error, TlsError, TlsStreamOps}


# Bring up one verified client handshake against `host`. A verification/handshake
# failure arrives as an absent `connect()` and is escalated into a TlsError.
connect_verified(host<String>, port<Int>, cert<String>) -> {
    match (tls_client_context_verified(cert)) {
        vctx -> {
            cfd<Int> = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, Socket::IPPROTO_TCP) else -1
            if (cfd < 0) { fail tls_error("connect", host) }
            if (!(socket_connect(cfd, "127.0.0.1", port) else false)) { socket_close(cfd); fail tls_error("connect", host) }
            match (tls_stream(vctx, cfd, host)) {
                s -> {
                    match (s.connect()) {
                        okc -> { tls_write(okc, "ping"); tls_close(okc); tls_free_context(vctx) }
                        ? -> { tls_close(s); tls_free_context(vctx); fail tls_error("connect", host) }
                    }
                }
                ? -> { socket_close(cfd); tls_free_context(vctx); fail tls_error("stream", host) }
            }
        }
        ? -> { fail tls_error("context", host) }
    }
}

main()<Int> -> {
    cert<String> = "-----BEGIN CERTIFICATE-----
MIIDJTCCAg2gAwIBAgIUQSza8Jzq6eaC7QZxN6SWUUkl46UwDQYJKoZIhvcNAQEL
BQAwFDESMBAGA1UEAwwJbG9jYWxob3N0MB4XDTI2MDgxNzA1Mzg0NVoXDTM2MDgx
NDA1Mzg0NVowFDESMBAGA1UEAwwJbG9jYWxob3N0MIIBIjANBgkqhkiG9w0BAQEF
AAOCAQ8AMIIBCgKCAQEAry4PgJdCc+380uIK416p3WwKNCXyHcgtbEhoYRF49lYD
IdvNAfuDSPFymNRQhYxnzwR6zX6Qs9eCzaz6wRdWlgrM0ZWwM4ntGE+LvHbks9BS
740cMvBV+dT5Emeu7eAoI5K0/VSqnOca7SAjt4mgB2y+E7FM7oqlFHtNnmB//PzW
ykVexrVEd4WwqZm2sClGedcITCns+wYDkx0OSQ1TIqUMhydQvd+KxvOtgux4nnqI
AqJ2Yk7vuCRm2GGaFs4hpR/IkoVhx2nsSbJqDd7QDS4ECHjdwrG9i94ZxyBEcQNG
K4Eo/uXS9AfWOEO9so1Xa5gTCwzZS8h/tXFVFwm7EQIDAQABo28wbTAdBgNVHQ4E
