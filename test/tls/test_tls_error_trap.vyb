nAY/pxgCXhYWRpT6KduLkwaQxLilIFotVMlmvyQGgnvhmt7Ml645T4pd6QKBgHeb
0eKuEqPiehIPblw6greFAoc6M+zzgD7fqppS6h4vs8y+FQ/eL97RI/2Fs+aXLnx8
o0JIAAP8J5Ov0pRGboFG0ivpifbyHiHiCcnC062nuUFP1hvhy3yMwmOPnmDhsQie
BYjVtTChZKT+8InEEy6NhaD4mt9TszO3hswuqCg9AoGBAJM6mJ0tg4g4Dh9OuVEt
Aq0cwymlPoxxCyl8hH7Kl0HEJuraLq0vLytwHddAymIenif5HZgSm2qAVVqblv38
tNJ+gvTsNS/Y3DSoPu0E6tgr5EjK/FV0H/GIGWz9hAWYHV3dx2grL7GS2MOMu7n8
QsM4qhE7CXh5EW4f/zlKqRoL
-----END PRIVATE KEY-----"
    srv<Int> = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, Socket::IPPROTO_TCP) else -1
    if (srv < 0) { return 1 }
    if (!(socket_bind(srv, "127.0.0.1", 0) else false)) { return 2 }
    port<Int> = socket_local_port(srv) else -1
    if (!(socket_listen(srv, 2) else false)) { return 3 }
    # The wrong hostname (against the pinned cert) must escalate via TlsError.
    match (tls_server_context(cert, key)) {
        scx -> {
            th<Int> = thread_spawn(|| -> {
                n<Int> = 0
                while (n < 2) {
                    c<Int> = socket_accept(srv) else -1
                    if (c < 0) { continue }
                    match (tls_stream(scx, c, "")) {
                        s -> {
                            match (s.accept()) {
                                ok -> { tls_read(ok, 16); tls_close(ok) }
                                ? -> { tls_close(s) }
                            }
                        }
                        ? -> { socket_close(c) }
                    }
                    n = n + 1
                }
                return 0
}) else -1
            # Happy path first (served by the worker's first accept): the pinned
            # self-signed cert is trusted and the name matches, so a correct-hostname
            # handshake must NOT raise a TlsError.
            {
                connect_verified("localhost", port, cert)
            } trap (e<TlsError>) -> {
                println("tls-error-trap: happy raised")
                return 5
            }

            # Wrong hostname (served by the second accept): against the same pinned
            # cert the verification fails, connect() comes back absent, and the
            # helper escalates it as a cross-module TlsError we trap right here.
            op = ""
            tgt = ""
            msg = ""
            caught<Bool> = false
            {
                connect_verified("wrong-host.invalid", port, cert)
            } trap (e<TlsError>) -> {
                caught = true
                op = e.op
                tgt = e.host
                msg = e.message
            }
            if (!caught || op != "connect" || tgt != "wrong-host.invalid" || msg == "") {
                println("tls-error-trap: failed")
                return 4
            }
            thread_join(th)
            tls_free_context(scx)
            socket_close(srv)
        }
        ? -> { socket_close(srv); return 7 }
    }
    println("tls-error-trap: ok")
    return 0
}
