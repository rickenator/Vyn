// Test file to demonstrate struct syntax and field access

struct Point {
    x<Int>,
    y<Int>
}

struct Rectangle {
    width<Int>,
    height<Int>
}

main()<Int> -> {
    p<Point> = Point { x=10, y=20 };
    r<Rectangle> = Rectangle { width=100, height=50 };
    
    // Modify fields
    p.x = p.x * 2;
    r.height = r.height + 25;
    
    if (p.x != 20) { return 1 }
    if (r.height != 75) { return 2 }
    
    return 0;
}
