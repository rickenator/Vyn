# For Loop Tests (converted to range-based syntax)
# These tests verify for loop functionality using Vyb's canonical range-based syntax

## Simple counting loop (0 to 4)
test_basic_for()<Int> -> {
    sum<Int> = 0
    for (i in 0..4) {
        sum = sum + i
    }
    return sum  # Expected: 0+1+2+3+4 = 10
}

## Step increment (even numbers 0 to 8)
test_step_for()<Int> -> {
    sum<Int> = 0
    for (i in 0..8, 2) {
        sum = sum + i
    }
    return sum  # Expected: 0+2+4+6+8 = 20
}

## Countdown using while loop
test_countdown_for()<Int> -> {
    sum<Int> = 0
    i<Int> = 5
    while (i > 0) {
        sum = sum + i
        i = i - 1
    }
    return sum  # Expected: 5+4+3+2+1 = 15
}

## Nested loops using range-based syntax
test_nested_for()<Int> -> {
    sum<Int> = 0
    for (i in 1..3) {
        for (j in 1..2) {
            sum = sum + (i * j)
        }
    }
    return sum  # Expected: (1*1+1*2) + (2*1+2*2) + (3*1+3*2) = 3 + 6 + 9 = 18
}

main()<Int> -> {
    r1<Int> = test_basic_for()
    r2<Int> = test_step_for()
    r3<Int> = test_countdown_for()
    r4<Int> = test_nested_for()
    if (r1 != 10) { return 1 }
    if (r2 != 20) { return 2 }
    if (r3 != 15) { return 3 }
    if (r4 != 18) { return 4 }
    return 0
}
