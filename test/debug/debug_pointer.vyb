// @test: Debug: Pointer Return
// @description: Debug: Pointer Return
// @category: debug
// @expect: pass
// @expect-return: 100
// Debug pointer assignment step by step
main()<Int> -> {
    x<Int> = 42;
    println("Initial x:", x);

    freedom {
        p<loc<Int>> = loc(x);
        println("Before at(p) assignment, x:", x);
        at(p) = 100;
        println("After at(p) assignment, x:", x);
    }

    return x;
}
