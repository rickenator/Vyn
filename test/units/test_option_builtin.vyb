// @test: built-in Option<T> enum with Some/None
// @description: the built-in generic data enum Option<T> constructs via qualified
//   (Option<Int>::Some(...)) and bare (Some(...)/None, inferred from an enclosing
//   Option<T> annotation), and match/select dispatch on the payload with the
//   concrete substituted bindings.
// @category: enum, generics, option, match, select, sum-types
// @expect: pass
// @expect-return: -77
// @execute-jit: true

unwrap(o<Option<Int>>)<Int> -> {
    match (o) {
        Some(x) -> { return x }
        None -> { return -1 }
    }
}

pick_string(o<Option<String>>)<Int> -> {
    return select(o) -> {
        Some(x) -> x.len(),
        None -> -5
    }
}

find_first(v<Vec<Int>>, target<Int>)<Option<Int>> -> {
    i<Int> = 0
    while (i < v.len()) {
        if (v.get(i) == target) {
            return Some(v.get(i))
        }
        i = i + 1
    }
    return None
}

main()<Int> -> {
    a<Int> = unwrap(Option<Int>::Some(42))
    b<Int> = unwrap(Option<Int>::None)

    c<Option<Int>> = Some(7)
    e<Int> = unwrap(c)

    d<Option<Int>> = None
    f<Int> = unwrap(d)

    s<Int> = pick_string(Option<String>::Some("hello"))
    t<Int> = pick_string(Option<String>::None)

    v<Vec<Int>> = Vec::new()
    v.push(10)
    v.push(20)
    r<Option<Int>> = find_first(v, 20)
    n<Option<Int>> = find_first(v, 99)
    found<Int> = unwrap(r)
    missing<Int> = unwrap(n)

    if (a == 42 && b == -1 && e == 7 && f == -1 && s == 5 && t == -5 &&
        found == 20 && missing == -1) {
        return -77
    }
    return 1
}
