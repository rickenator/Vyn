// @test: a wildcard must remain the last select arm
// @description: an arm (including a {...} set) that follows the '?' arm is
//   unreachable and is reported as an error.
// @category: select, semantic, error
// @expect: fail
// @expect-error: Pattern after wildcard

main()<Int> -> {
    v<Int> = select(1) -> {
        ?    -> 1,
        {1, 2} -> 2
    }
    return v
}
