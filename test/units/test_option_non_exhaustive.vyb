// @test: non-exhaustive match on built-in Option<T> is rejected
// @description: a match on the built-in Option enum that covers only the Some
//   variant is reported as not exhaustive (None must be covered by an unguarded
//   arm or wildcard '?').
// @category: enum, generics, option, match, semantic, error
// @expect: fail
// @expect-error: not exhaustive

unwrap(o<Option<Int>>)<Int> -> {
    match (o) {
        Some(x) -> { return x }
    }
}

main()<Int> -> {
    return 0
}
