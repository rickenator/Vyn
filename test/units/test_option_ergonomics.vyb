// @test: bare Some/None/Ok/Err as call arguments (expected-type propagation)
// @description: bare builtin enum constructors infer from the callee's parameter /
//   container element type, so they work as subexpressions (unwrap(Some(7)),
//   classify(Ok(11)), and v.push(Some(x)) on a Vec<Option<Int>>), not just in
//   annotated variable declarations and returns.
// @category: enum, generics, option, result, inference, match
// @expect: pass
// @expect-return: -77
// @execute-jit: true

unwrap(o<Option<Int>>)<Int> -> {
    return match (o) {
        Some(x) -> x
        None -> -1
    }
}

grab(x<Option<Int>>)<Int> -> {
    return unwrap(x)
}

classify(r<Result<Int, String>>)<Int> -> {
    return match (r) {
        Ok(v) -> v
        Err(e) -> -1
    }
}

main()<Int> -> {
    a<Int> = unwrap(Some(7))
    b<Int> = grab(Some(9))
    c<Int> = grab(None)

    d<Int> = classify(Ok(11))
    e<Int> = classify(Err("boom"))

    v<Vec<Option<Int>>> = Vec()
    v.push(Some(5))
    v.push(None)
    v.push(Some(9))
    p0<Int> = unwrap(v.get(0))
    p1<Int> = unwrap(v.get(1))
    p2<Int> = unwrap(v.get(2))

    if (a == 7 && b == 9 && c == -1 && d == 11 && e == -1 &&
        p0 == 5 && p1 == -1 && p2 == 9) {
        return -77
    }
    return 1
}
