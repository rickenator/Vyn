// @test: select with brace-delimited set patterns matches any element
// @description: A single select arm may list several discrete values in a
//   brace-delimited set; it matches if the target equals ANY element.
// @category: select, pattern-matching, jit
// @execute-jit: true
// @expect: pass
// @expect-output: odd
// @expect-return: 0

classify(x<Int>)<String> -> {
    return select(x) -> {
        {1, 3, 5, 7, 9} -> "odd",
        {2, 4, 6, 8}    -> "even",
        ?               -> "out of bounds"
    }
}

main()<Int> -> {
    println(classify(1))
    println(classify(8))
    println(classify(11))
    return 0
}
