// @test: Result native .value payload accessor
// @description: a value of the built-in Result<T,E> enum exposes `.value`, reading
//   the primary (success) data variant's payload as T. When the runtime variant is
//   the primary one the payload is returned; otherwise a default T is produced
//   (matching the "return default on invalid access" style of Vec.get).
//   match/select remain the exhaustiveness-checked path.
// @category: enum, result, accessor, generics
// @expect: pass
// @expect-return: 0
// @execute-jit: true

main()<Int> -> {
    okv<Result<Int, String>> = Result<Int, String>::Ok(5)
    errv<Result<Int, String>> = Result<Int, String>::Err("boom")

    // Read every accessor up front (declarations precede the reads), then check.
    r<Int> = okv.value
    s<Int> = errv.value
    t<Int> = okv.value + 3

    if (r != 5 || s != 0 || t != 8) {
        return 1
    }
    return 0
}
