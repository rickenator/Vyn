// Async I/O multiplexing: three echo sessions run concurrently on one listener.
// All three client fibers block in async_connect/async_recv on different
// non-blocking fds at the same time, so the poll pump must watch several
// sockets at once while the pool keeps every fiber moving.
// @env: VYB_STDLIB=stdlib
// @expect: pass

import network::{socket_open, socket_bind, socket_listen, socket_local_port,
                 socket_close, Socket}
import asyncs::{async_spawn, async_await, async_run_all, async_accept,
                async_connect, async_send, async_recv, async_sleep_ms}

MSG0<String> = "zero"
MSG1<String> = "one"
MSG2<String> = "two"

main()<Int> -> {
    srv<Int> = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, Socket::IPPROTO_TCP)
    if (socket_bind(srv, "127.0.0.1", 0) != 0) { return 1 }
    if (socket_listen(srv, 3) != 0) { return 2 }
    port<Int> = socket_local_port(srv)

    # One echo-server fiber: sequentially async-accept + echo each connection.
    st<Int> = async_spawn(|| -> {
        c0<Int> = async_accept(srv); e0<String> = async_recv(c0, 4096); async_send(c0, e0); socket_close(c0)
        c1<Int> = async_accept(srv); e1<String> = async_recv(c1, 4096); async_send(c1, e1); socket_close(c1)
        c2<Int> = async_accept(srv); e2<String> = async_recv(c2, 4096); async_send(c2, e2); socket_close(c2)
        return 0
    })

    ca<Int> = async_spawn(|| -> {
        async_sleep_ms(5)
        cli<Int> = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, Socket::IPPROTO_TCP)
        if (async_connect(cli, "127.0.0.1", port) != 0) { return 10 }
        async_send(cli, MSG0)
        b<String> = async_recv(cli, 4096)
        socket_close(cli)
        if (b == MSG0) { return 0 }
        return 20
    })
    cb<Int> = async_spawn(|| -> {
        async_sleep_ms(8)
        cli<Int> = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, Socket::IPPROTO_TCP)
        if (async_connect(cli, "127.0.0.1", port) != 0) { return 11 }
        async_send(cli, MSG1)
        b<String> = async_recv(cli, 4096)
        socket_close(cli)
        if (b == MSG1) { return 0 }
        return 21
    })
    cc<Int> = async_spawn(|| -> {
        async_sleep_ms(11)
        cli<Int> = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, Socket::IPPROTO_TCP)
        if (async_connect(cli, "127.0.0.1", port) != 0) { return 12 }
        async_send(cli, MSG2)
        b<String> = async_recv(cli, 4096)
        socket_close(cli)
        if (b == MSG2) { return 0 }
        return 22
    })

    rca<Int> = async_await(ca)
    rcb<Int> = async_await(cb)
    rcc<Int> = async_await(cc)
    rs<Int> = async_await(st)
    socket_close(srv)
    async_run_all()

    if (rs != 0) { return 3 }
    if (rca + rcb + rcc != 0) { return 4 }
    println("ok")
    return 0
}
