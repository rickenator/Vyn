// @test: C-like enum variant produces a distinct typed value
// @description: enum variants are first-class typed values (not raw Int); println renders Enum::Variant
// @category: types, enum
// @expect: pass
// @expect-output: Color::Red
// @expect-output: Color::Green
// @expect-return: 0

enum Color { Red, Green, Blue }

main()<Int> -> {
    r<Color> = Color::Red
    g<Color> = Color::Green
    println(r)
    println(g)
    return 0
}
