// @test: Enum with match statement
// @description: C-like enum variants are matched by name and dispatch on the runtime tag
// @category: types, enum, match
// @expect: pass
// @expect-output: East
// @expect-return: 0

enum Direction { North, South, East, West }

main()<Int> -> {
    d<Direction> = Direction::East
    match (d) {
        North -> println("North"),
        East -> println("East"),
        ? -> println("Other")
    }
    return 0
}
