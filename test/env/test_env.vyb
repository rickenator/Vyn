// @test: env stdlib module - get/set/unset
// @description: deterministic process-environment checks within this process.
//   env_get returns String? -- absent when unset, present holding the value (which
//   may legitimately be empty), so "unset" and "set to empty" are distinguishable.
// @category: env, stdlib
// @expect: pass
// @expect-return: 0
// @env: VYB_STDLIB=stdlib

import env

main()<Int> -> {
    // An unset variable reads back as absent; `else ""` recovers the old "" view.
    if ((env_get("VYB_TEST_PROBE_ASDF") else "") != "") { return 1 }
    // A real variable (HOME or PATH) is present and never empty.
    if ((env_get("PATH") else "") == "") { return 2 }

    // Set then read back the same value. env_set returns Bool? -- present on
    // success, absent on failure; `else false` recovers a boolean view.
    if (!(env_set("VYB_TEST_PROBE_ASDF", "hello") else false)) { return 3 }
    if ((env_get("VYB_TEST_PROBE_ASDF") else "") != "hello") { return 4 }

    // A variable set to an empty string is present -- NOT indistinguishable from
    // unset.
    if (!(env_set("VYB_TEST_PROBE_EMPTY", "") else false)) { return 5 }
    if ((env_get("VYB_TEST_PROBE_EMPTY") else "absent") != "") { return 6 }

    // Overwrite, then unset.
    if (!(env_set("VYB_TEST_PROBE_ASDF", "world") else false)) { return 7 }
    if ((env_get("VYB_TEST_PROBE_ASDF") else "") != "world") { return 8 }
    if (!(env_unset("VYB_TEST_PROBE_ASDF") else false)) { return 9 }
    if ((env_get("VYB_TEST_PROBE_ASDF") else "") != "") { return 10 }

    println("env ok")
    return 0
}
