// @test: enum methods via bind (built-in Result execution)
// @description: an aspect bind onto the built-in generic enum Result<T,E>
//   (bind Describe -> Result<Int, String>) is accepted without an import and
//   dispatches on the concrete variant in both positions.
// @category: aspect, bind, enum, result, match, execution
// @expect: pass
// @expect-return: 0
// @execute-jit: true

aspect Describe {
    is_ok(self)<Bool>
}

bind Describe -> Result<Int, String> {
    is_ok(self)<Bool> -> {
        return match (self) {
            Ok(v) -> true
            Err(e) -> false
        }
    }
}

main()<Int> -> {
    r1<Result<Int, String>> = Result<Int, String>::Ok(3)
    r2<Result<Int, String>> = Result<Int, String>::Err("x")

    c1<Bool> = r1.is_ok()
    c2<Bool> = r2.is_ok()

    if (c1 && !c2) {
        return 0
    }
    return 1
}
