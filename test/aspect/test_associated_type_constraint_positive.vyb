// @test: associated type with aspect bound accepts a conforming type
// @description: type Item<Display> requires the assigned type to implement Display
// @category: aspect, associated types, bounds
// @expect: pass
// @expect-return: 0

aspect Display {
    show(self) -> { }
}

struct Point {
    x<Int>
}

bind Display -> Point {
    show(self) -> { return }
}

aspect Iterator {
    type Item<Display>
    next(self)<Self::Item>
}

bind Iterator -> Point {
    type Item = Point
    next(self)<Point> -> { return self }
}

main()<Int> -> {
    p<Point> = Point { x = 1 }
    q<Point> = p.next()
    return 0
}
