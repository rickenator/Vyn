// @test: associated type bound rejects a non-conforming assignment
// @description: Binding type Item = Plain when Item requires Display is rejected
// @category: aspect, associated types, bounds, diagnostics
// @expect: fail
// @expect-error: Associated type 'Item' of type 'Plain' in bind 'Itr -> Plain' does not implement aspect 'Display'.
// @semantic-only: true

aspect Display {
    show(self)<Void> -> { }
}

struct Plain {
    x<Int>
}

aspect Itr {
    type Item<Display>
    next(self)<Self::Item>
}

bind Itr -> Plain {
    type Item = Plain
    next(self)<Plain> -> { return self }
}

main()<Int> -> {
    return 0
}
