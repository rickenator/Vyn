// @test: concrete bind method returning Self::Item resolves the associated type
// @description: A concrete bind whose method return type is Self::Item resolves to the bound associated type (Int) in the signature and body
// @category: aspect, associated types, monomorphization
// @expect: pass
// @expect-return: 5

aspect Iterator {
    type Item
    next(self)<Self::Item>
}

struct CounterIter {
    value<Int>
}

bind Iterator -> CounterIter {
    type Item = Int
    next(self)<Self::Item> -> {
        return self.value
    }
}

main()<Int> -> {
    c<CounterIter> = CounterIter { value = 5 }
    r<Int> = c.next()
    return r
}
