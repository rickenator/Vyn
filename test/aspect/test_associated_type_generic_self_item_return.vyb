// @test: generic bind method returning Self::Item resolves the associated type
// @description: A generic bind (type Item = T) whose method return type is Self::Item substitutes the concrete type argument at the call site
// @category: aspect, associated types, generics, monomorphization
// @expect: pass
// @expect-return: 11

aspect Iterator {
    type Item
    next(self)<Self::Item>
}

struct Boxer<T> {
    value<T>
}

bind<T> Iterator -> Boxer<T> {
    type Item = T
    next(self)<Self::Item> -> {
        return self.value
    }
}

main()<Int> -> {
    b<Boxer<Int>> = Boxer<Int> { value = 11 }
    r<Int> = b.next()
    return r
}
