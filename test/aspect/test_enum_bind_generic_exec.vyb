// @test: enum methods via bind (generic enum execution)
// @description: an aspect bind onto a generic enum instantiation (bind Render -> Box<Int>)
//   is accepted by the compiler and dispatches on the concrete variant, unwrapping the
//   substituted payload.
// @category: aspect, bind, enum, generics, match, execution
// @expect: pass
// @expect-return: 0
// @execute-jit: true

aspect Render {
    to_int(self)<Int>
}

enum Box<T> {
    Value(T),
    Empty
}

bind Render -> Box<Int> {
    to_int(self)<Int> -> {
        return match (self) {
            Value(v) -> v * 10
            Empty -> -1
        }
    }
}

main()<Int> -> {
    b<Box<Int>> = Box<Int>::Value(42)
    e<Box<Int>> = Box<Int>::Empty
    vb<Int> = b.to_int()
    ve<Int> = e.to_int()
    if (vb == 420 && ve == -1) {
        return 0
    }
    return 1
}
