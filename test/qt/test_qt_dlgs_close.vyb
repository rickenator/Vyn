// @test: qt stdlib module - non-blocking async dialogs (programmatic close)
// @description: Without VYB_QT_DIALOG_AUTO a qt_dlg_* dialog stays open until
//   the user acts (or qt_dlg_close rejects it). This test uses qt_dlg_close to
//   finish dialogs deterministically and verify the QtEvent::dialog result (0)
//   handoff, plus the bad-handle / empty-selection paths, all offscreen.
// @category: qt, stdlib, gui
// @expect: pass
// @expect-output: qt-dlgs-close-ok
// @env: VYB_STDLIB=stdlib; QT_QPA_PLATFORM=offscreen

import qt

// Drain queued events, returning the first QtEvent::dialog payload for `h` (or
// -1 if none).
drain_dialog(h<Int>)<Int> -> {
    result<Int> = -1
    while (qt_event_count() > 0) {
        if (qt_event_kind() == QtEvent::dialog && qt_event_handle() == h) {
            result = qt_event_result()
        }
        qt_event_pop()
    }
    return result
}

main()<Int> -> {
    if (qt_init() == false) {
        println("qt-dlgs-close-ok (Qt5 unavailable)")
        return 0
    }
    w<Int> = qt_window_create()
    if (w == 0) { return 1 }

    // Warn box: programmatic close -> rejected -> result 0.
    d1<Int> = qt_dlg_warn(w, "Warn", "careful")
    if (d1 == 0) { return 2 }
    if (qt_dlg_close(d1) != 0) { return 3 }
    if (drain_dialog(d1) != 0) { return 4 }

    // Question box: closing without a choice is a rejection -> result 0.
    d2<Int> = qt_dlg_question(w, "Ask", "really?")
    if (d2 == 0) { return 5 }
    if (qt_dlg_close(d2) != 0) { return 6 }
    if (drain_dialog(d2) != 0) { return 7 }

    // Directory picker: close -> 0; no path was selected.
    d3<Int> = qt_dlg_dir(w, "Pick")
    if (d3 == 0) { return 8 }
    if (qt_dlg_close(d3) != 0) { return 9 }
    if (drain_dialog(d3) != 0) { return 10 }
    if (qt_dlg_selected(d3) != "") { return 11 }

    // Bad-handle paths.
    if (qt_dlg_close(0) != -1) { return 12 }
    if (qt_dlg_selected(0) != "") { return 13 }

    qt_window_close(w)
    println("qt-dlgs-close-ok")
    return 0
}
