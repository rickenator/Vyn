// @test: qt stdlib module - Qt5 Widgets native GUI smoke
// @description: Headless-deterministic Qt5 Widgets smoke: initialize the app,
//   create a window + label, set/get title, resize, show/hide, pump the event
//   loop, and arm/poll the deadline timer. Runs on the offscreen QPA platform so
//   it needs no X server. When Qt5 is unavailable the module degrades
//   gracefully (stub shims report init=false) and the test still passes.
// @category: qt, stdlib, gui
// @expect: pass
// @expect-output: qt-ok
// @env: VYB_STDLIB=stdlib
// @env: QT_QPA_PLATFORM=offscreen

import qt
import time::{sleep_ms}

main()<Int> -> {
    if (qt_init() == false) {
        // Qt5 not linked into this build (stub shims): degrade gracefully.
        println("qt-ok (Qt5 unavailable)")
        return 0
    }
    if (qt_active() == false) { return 1 }

    w<Int> = qt_window_create() else 0
    if (w == 0) { return 2 }
    if (!(qt_window_set_title(w, "Test Window") else false)) { return 3 }
    if (qt_window_title(w) != "Test Window") { return 4 }
    if (!(qt_window_resize(w, 320, 200) else false)) { return 5 }
    if ((qt_window_width(w) else -1) != 320) { return 6 }
    if ((qt_window_height(w) else -1) != 200) { return 7 }

    l<Int> = qt_label_create(w, "Hello, Qt") else 0
    if (l == 0) { return 8 }
    if (qt_label_text(l) != "Hello, Qt") { return 9 }
    if (!(qt_label_set_text(l, "Bye") else false)) { return 10 }
    if (qt_label_text(l) != "Bye") { return 11 }

    if (!(qt_window_show(w) else false)) { return 12 }
    if (qt_window_visible(w) == false) { return 13 }
    if (!(qt_process_events() else false)) { return 14 }

    // Polled deadline timer: must fire within ~a second of a 30ms interval.
    if (!(qt_set_timer(30) else false)) { return 15 }
    fired<Bool> = false
    poll<Int> = 0
    while (poll < 200) {
        if (!(qt_process_events() else false)) { return 16 }
        if (qt_timer_fired()) { fired = true }
        if (fired) { poll = 999 }
        sleep_ms(10)
        poll = poll + 1
    }
    if (fired == false) { return 17 }

    if (!(qt_window_hide(w) else false)) { return 18 }
    if (qt_window_visible(w)) { return 19 }
    if (!(qt_window_close(w) else false)) { return 20 }

    qt_quit()
    println("qt-ok")
    return 0
}
