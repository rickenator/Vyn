// @test: qt stdlib module - modal dialogs, rich-text editor, font/color helpers
// @description: Headless-deterministic coverage for the fourth qt tier: native
//   modal QMessageBox/QFileDialog dialog pickers (auto-accepted via the opt-in
//   VYB_QT_DIALOG_AUTO=1 bridge seam so they resolve without a user), a
//   QTextEdit rich-text editor (html/plain/append/clear/color + TextChanged),
//   and generic font size/bold and palette text-color helpers on any widget.
// @category: qt, stdlib, gui
// @expect: pass
// @expect-output: qt-dialogs-ok
// @env: VYB_STDLIB=stdlib; QT_QPA_PLATFORM=offscreen; VYB_QT_DIALOG_AUTO=1

import qt

main()<Int> -> {
    if (qt_init() == false) {
        println("qt-dialogs-ok (Qt5 unavailable)")
        return 0
    }
    if (qt_active() == false) { return 1 }

    w<Int> = qt_window_create() else 0
    if (w == 0) { return 2 }

    // --- Modal dialogs (auto-accepted under VYB_QT_DIALOG_AUTO=1) ------------
    if (!(qt_msg_info(w, "Info", "hello") else false)) { return 10 }
    if (!(qt_msg_warn(w, "Warn", "careful") else false)) { return 11 }
    if (!(qt_msg_error(w, "Error", "boom") else false)) { return 12 }
    if (!(qt_msg_about(w, "About", "tiny") else false)) { return 13 }
    mq<Int> = qt_msg_question(w, "Ask", "yes?") else 0
    if (mq != 1) { return 14 }   // auto answers Yes
    // File/dir pickers are auto-accepted; their returned path is platform/
    // mode dependent (Save may pre-fill a name), so we only exercise them.
    o<String> = qt_file_open(w, "Open", "All files (*)") else "sentinel-unreachable"
    s<String> = qt_file_save(w, "Save", "All files (*)") else "sentinel-unreachable"
    d<String> = qt_dir_select(w, "Pick") else "sentinel-unreachable"
    if (o == "sentinel-unreachable") { return 15 }
    if (s == "sentinel-unreachable") { return 16 }
    if (d == "sentinel-unreachable") { return 17 }

    // --- Rich-text editor (QTextEdit) ----------------------------------------
    ed<Int> = qt_rich_create(w) else 0
    if (ed == 0) { return 20 }
    if (qt_kind(ed) != QtWidgetKind::rich) { return 21 }
    if (!(qt_rich_set_html(ed, "<b>hi</b> <i>there</i>") else false)) { return 22 }
    if (qt_rich_plain(ed) != "hi there") { return 23 }
    html<String> = qt_rich_html(ed)
    if (html == "") { return 24 }
    if (!(qt_rich_set_plain(ed, "plain text") else false)) { return 25 }
    if (qt_rich_plain(ed) != "plain text") { return 26 }
    if (!(qt_rich_append(ed, "!") else false)) { return 27 }
    if (!(qt_rich_append(ed, " second") else false)) { return 28 }
    if (!(qt_rich_clear(ed) else false)) { return 29 }
    if (qt_rich_plain(ed) != "") { return 30 }
    if (!(qt_rich_set_text_color(ed, 255, 0, 0) else false)) { return 31 }

    // A rich text edit should have enqueued QtEvent::TextChanged records.
    sawText<Bool> = false
    while (qt_event_count() > 0) {
        if (qt_event_kind() == QtEvent::textChanged && qt_event_handle() == ed) {
            sawText = true
        }
        if (qt_event_pop() != 0) { return 32 }
    }
    if (sawText == false) { return 33 }

    // --- Font / color helpers (any widget) -----------------------------------
    lbl<Int> = qt_label_create(w, "styled") else 0
    if (lbl == 0) { return 40 }
    if (!(qt_widget_set_font_size(lbl, 18) else false)) { return 41 }
    if (!(qt_widget_set_font_bold(lbl, 1) else false)) { return 42 }
    if (!(qt_widget_set_text_color(lbl, 0, 0, 255) else false)) { return 43 }
    if (!(qt_widget_set_font_size(w, 12) else false)) { return 44 }
    if (!(qt_widget_set_text_color(w, 10, 20, 30) else false)) { return 45 }

    // Bad-handle / wrong-kind rejection paths.
    if (qt_rich_set_html(0, "<b>x</b>") else false) { return 50 }
    if (qt_rich_plain(0) != "") { return 51 }
    if (qt_widget_set_font_size(0, 8) else false) { return 52 }
    if (qt_widget_set_text_color(0, 1, 2, 3) else false) { return 53 }
    if (!(qt_msg_info(0, "t", "x") else false)) { return 54 }

    qt_window_close(w)
    println("qt-dialogs-ok")
    return 0
}
