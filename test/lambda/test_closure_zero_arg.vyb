// @test: closure zero-arg lambdas
// @description: Zero-arg lambdas written `|| -> body` parse and run correctly in
//   expression-body, void-block, and value-block (explicit return) forms.
// @category: lambda, closure, parsing
// @expect: pass
// @expect-output: ok
// @expect-return: 0

main()<Int> -> {
    add5<fn() -> Int> = || -> 5 + 2
    if (add5() != 7) { return 1 }

    counter<Int> = 0
    bump<fn() -> Int> = || -> {
        counter = counter + 1
        return counter
    }
    if (bump() != 1) { return 2 }
    if (bump() != 2) { return 3 }
    if (counter != 2) { return 4 }

    println("ok")
    return 0
}
