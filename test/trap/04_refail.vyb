# Test 04: Refail statement
# Tests propagating an error to the caller
// @expect: fail

inner_function()<Int> -> {
    fail NetworkError { message = "Connection timeout" }
    return 0
}

outer_function()<Int> -> {
    {
        inner_function()
    } trap (e<NetworkError>) -> {
        println("Caught in outer, refailing...")
        refail  # Propagate to caller
    }
    return 0
}

main()<Int> -> {
    {
        outer_function()
    } trap (e<NetworkError>) -> {
        println("Finally caught at main level")
        return 1
    }
    return 0
}
