// @expect-return: 15
# Test compute only
divide(a<Int>, b<Int>)<Int> -> {
    if (b == 0) {
        fail DivisionByZero { dividend = a, divisor = b }
    }
    return a / b
}

struct DivisionByZero { dividend: Int, divisor: Int }

compute(x<Int>, y<Int>)<Int> -> {
    result<Int> = { divide(x, y) } trap (e<DivisionByZero>) -> {
        -1
    }
    return result + 10
}

main()<Int> -> {
    result<Int> = { compute(10, 2) } trap (e<DivisionByZero>) -> {
        -1
    }
    return result
}
