# Test 14: Async functions with error handling
# Tests that errors work correctly in async/await contexts:
# a failable async worker's failure is transported to the `await` site and
# recovered by the enclosing trap; a successful await hands back its value.
// @test: Async functions with error handling (failableFuture -> trap at await)
// @category: trap,async,error
// @expect: pass
// @expect-return: 0

struct InvalidURL { url<String> }

async fetch_data(url<String>)<Future<String>> -> {
    if (url.starts_with("invalid")) {
        fail InvalidURL { url = url }
    }
    return "Data from " + url
}

async main()<Int> -> {
    result1<String> = {
        await fetch_data("https://example.com")
    } trap (e<InvalidURL>) -> {
        println("Error: " + e.url)
        ""
    }
    println(result1)

    result2<String> = {
        await fetch_data("invalid://bad")
    } trap (e<InvalidURL>) -> {
        println("Invalid URL: " + e.url)
        ""
    }
    println(result2)

    return 0
}
