// @expect-return: 27
# Test two calls - both success
divide(a<Int>, b<Int>)<Int> -> {
    if (b == 0) {
        fail DivisionByZero { dividend = a, divisor = b }
    }
    return a / b
}

struct DivisionByZero { dividend: Int, divisor: Int }

compute(x<Int>, y<Int>)<Int> -> {
    result<Int> = { divide(x, y) } trap (e<DivisionByZero>) -> {
        -1
    }
    return result + 10
}

main()<Int> -> {
    val1<Int> = { compute(10, 2) } trap (e<DivisionByZero>) -> {
        -1
    }
    val2<Int> = { compute(6, 3) } trap (e<DivisionByZero>) -> {
        -1
    }
    return val1 + val2           # 15 + 12 = 27
}
