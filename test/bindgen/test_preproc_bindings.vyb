// @test: vyb bindgen #define constants
// @description: object-like `#define` macros (numbers, hex, strings, floats) bind as constant enums (integers, file-scoped) or shared constant functions (strings/floats) and are usable from an importing module
// @category: ffi, bindgen
// @expect: pass
// @expect-output: max= 4096
// @expect-return: 0
// @tags: ffi, bindgen, macro, preprocessor

import preproc

main()<Int> -> {
    println("max=", Preproc::MAX_BUFSIZE)
    println("name=", DEFAULT_NAME())
    println("scale=", SCALE_FACTOR())
    println("mask=", Preproc::MASK)
    println("tweak=", Preproc::TWEAK)
    return 0
}
