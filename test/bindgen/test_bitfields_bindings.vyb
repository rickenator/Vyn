// @test: vyb bindgen skips bitfield structs
// @description: a struct containing C bitfields cannot be ABI-represented and is skipped with a warning, while plain structs beside it still bind; the generated module imports
// @category: ffi, bindgen
// @expect: pass
// @expect-return: 0
// @tags: ffi, bindgen, bitfield, struct

import bitfields

main()<Int> -> {
    // The golden fixture proves `Flags` (bitfields) is omitted and PlainHandle
    // binds. Constructing/reading repr(C) struct fields is a separate known
    // codegen gap, so this test only verifies the module imports cleanly.
    return 0
}
