// @test: vyb bindgen function-pointer parameters
// @description: inline and typedef'd C function-pointer params bind as Vyb `loc<fn(...) -> ...>` (a bare C function pointer, ABIs to a single ptr); the generated module imports and a Vyb function can be passed to and called through a loc<fn> param
// @category: ffi, bindgen
// @expect: pass
// @expect-output: square4= 16
// @expect-return: 0
// @tags: ffi, bindgen, function-pointer, callback

import fnpointer

apply(f<loc<fn(CInt) -> CInt>>, x<CInt>)<CInt> -> {
    return f(x)
}

square(a<CInt>)<CInt> -> { return a * a }
cube(a<CInt>)<CInt> -> { return a * a * a }

main()<Int> -> {
    s<CInt> = apply(square, 4)
    println("square4=", s)
    println("cube3=", apply(cube, 3))
    return 0
}
