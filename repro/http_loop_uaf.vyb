# Minimal reproducer for the async http/https fetch-worker String UAF.
# (Confirms under an AddressSanitizer JIT build.)
#
# The full VybLynx app only crashes intermittently because the bug sat in the
# shared runtime's String reference-count registry: it used open addressing with
# linear probing but left a NULL in a slot the moment a buffer was freed. Linear
# probing cannot stop at a deleted slot, so retain() could miss an entry that a
# later release() found, dropping the count and freeing a String the caller
# still held. This http loop is the tightest way to churn enough distinct heap
# buffers to make that probe miss happen reliably.
#
# Run under ASAN (compiler built with -fsanitize=address):
#   VYB_STDLIB=stdlib ASAN_OPTIONS=detect_leaks=0:abort_on_error=1:halt_on_error=1 \
#       ./build-asan/vyb -- repro/http_loop_uaf.vyb
#
# Pre-fix this aborts ~always with:
#   heap-use-after-free: READ of size 6 at offset 9 of a 16-byte region
#   freed by __vyb_string_release -> __vyb_string_free
# The 16-byte buffer is the status line "HTTP/1.1 200 OK" (15 + NUL) returned by
# http_read_line; http_status_code re-reads it (substring(9,15)) for the code.
import http

main()<Int> -> {
    srv<Int> = http_serve(0, 4)
    if (srv < 0) { return 1 }
    port<Int> = http_local_port(srv)
    if (port <= 0) { return 2 }
    round<Int> = 0
    while (round < 8000) {
        resp<HttpResponse> = http_get_full("127.0.0.1", port, "/greet")
        if (resp.status != 200) { return 3 }
        round = round + 1
    }
    http_close(srv)
    println("ok")
    return 0
}
