# core::option
#
# As of v0.5.3, the canonical `Option<T>` built-in generic enum (`Some(T)` /
# `None`) is implemented in the compiler core and needs no import. This module
# retains the transitional `OptionInt` struct/helper bridge for source-compat
# with code written against the earlier provisional API.

share(all)
struct OptionInt {
    is_some<Bool>,
    value<Int>
}

share(all)
option_int_none()<OptionInt> -> {
    return OptionInt{ is_some = false, value = 0 }
}

share(all)
option_int_some(value<Int>)<OptionInt> -> {
    return OptionInt{ is_some = true, value = value }
}

share(all)
option_int_is_some(option<OptionInt>)<Bool> -> {
    return option.is_some
}

share(all)
option_int_unwrap_or(option<OptionInt>, fallback<Int>)<Int> -> {
    if (option.is_some) {
        return option.value
    }
    return fallback
}
