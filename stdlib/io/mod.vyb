# io - File input/output module.
#
# Provides the `File` value plus the `open` / `close` / `read_all` / `write_str`
# syscall-backed helpers and the portable `FILE_*` open-mode helpers. All I/O
# crosses the runtime's `__vyb_file_*` functions in `runtime/vyb_runtime.c`; the
# Vyb surface stays allocation/pointer-free — a `File` only carries a plain
# `Int` descriptor and the path it was opened on.
#
# Usage:
#   import io::{open_write, write_str, close, open_read, read_all}
#   match (open_write("data.txt")) {
#       f -> {
#           match (write_str(f, "hello")) {
#               n -> { println("wrote " + n.to_string() + " bytes") }
#               ? -> { println("write failed: " + error_message()) }
#           }
#           close(f)
#       }
#       ? -> { println("open failed: " + error_message()) }
#   }
#   match (open_read("data.txt")) {
#       r -> {
#           match (read_all(r)) {
#               s -> { println(s) }
#               ? -> { println("read failed: " + error_message()) }
#           }
#           close(r)
#       }
#       ? -> { println("open failed: " + error_message()) }
#   }
#   # Or escalate the absent File? into the fail/trap framework:
#   match (open_read("data.txt")) {
#       r -> { println(read_all(r)) }
#       ? -> { fail io_error("open", "data.txt") }
#   }
#
# Diagnostic surface: `error_code()` (0 = no error) and `error_message()` report
# the result of the last file operation.

# Open-mode helper flags (a portable bitmask understood by the runtime helper).
# A constant enum: `FileFlag::READ` is an `Int` and combines with `|`.
share(all)
enum FileFlag {
    READ = 1
    WRITE = 2
    RDWR = 4
    CREATE = 128
    TRUNC = 512
    APPEND = 1024
}

# An open file. Only ever constructed valid; `path` records the target. The open
# functions return `File?` (absent when opening failed), so a `File` carries no
# sentinel "failed" state.
share(all)
struct File {
    fd<Int>,
    path<String>
}

# A shared error value for escalating a failed file operation into the
# fail/trap framework. `operation` names the failing call ("open", "read",
# "write", "close"); `path` is the affected file; `message` is the last
# diagnostic from `error_message()`. Build it directly with a struct literal or
# via the `io_error()` convenience.
share(all)
struct IoError {
    operation<String>,
    path<String>,
    message<String>
}

# Open (or create) `path` with the given `FileFlag` flags. Returns the file as
# `File?` -- present when the open succeeds, absent when it fails. The wrap
# happens here in the module, so callers never touch a sentinel `fd`. Use `else`
# for a local default, `match` to shape the absent arm into a `fail`, or
# diagnose via `error_message()`.
share(all)
open(path<String>, flags<Int>)<File?> -> {
    fd<Int> = vyb_io_open(path, flags)
    if (fd < 0) { return File?() }
    return File?(File { fd = fd, path = path })
}

# Convenience: open an existing file for reading (`File?`, absent on failure).
share(all)
open_read(path<String>)<File?> -> {
    return open(path, FileFlag::READ)
}

# Convenience: create/truncate a file for writing (`File?`, absent on failure).
share(all)
open_write(path<String>)<File?> -> {
    return open(path, FileFlag::WRITE | FileFlag::CREATE | FileFlag::TRUNC)
}

# Convenience: open for appending, creating the file if absent (`File?`).
share(all)
open_append(path<String>)<File?> -> {
    return open(path, FileFlag::APPEND | FileFlag::CREATE)
}

# Close an open file. Returns `Bool?` -- present on success, absent on failure.
share(all)
close(f<File>)<Bool?> -> {
    r<Int> = vyb_io_close(f.fd)
    if (r != 0) { return Bool?() }
    return Bool?(true)
}

# Write `s` to the file. Returns `Int?` -- present holding the number of bytes
# written, absent on failure.
share(all)
write_str(f<File>, s<String>)<Int?> -> {
    n<Int> = vyb_io_write(f.fd, s)
    if (n < 0) { return Int?() }
    return Int?(n)
}

# Read the whole file into a `String?` -- present holding the full content
# (which may legitimately be empty) when the read succeeds, absent when it
# fails.
share(all)
read_all(f<File>)<String?> -> {
    return vyb_io_read_all_opt(f.fd)
}

# Read up to `n` bytes at absolute byte `off` of the open file, without moving
# the file cursor (stateless `pread`, thread-safe). Returns `String?` -- absent
# only if the read fails (bad/negative offset, closed fd, ...); present holding
# the bytes actually read, which may be FEWER than `n` at (or past) EOF, so
# callers detect truncation by length. Lets a loader pull just, say, the
# metadata + tensor-index prefix of a multi-GB file without reading the whole
# thing into memory (#207).
share(all)
read_at(f<File>, off<Int>, n<Int>)<String?> -> {
    return vyb_io_read_at(f.fd, off, n)
}

# Numeric error code of the last file operation (0 = no error).
share(all)
error_code()<Int> -> {
    return vyb_io_error_code()
}

# Human-readable message for the last file operation error.
share(all)
error_message()<String> -> {
    return vyb_io_error_message()
}

# Build an `IoError` carrying the current `error_message()` diagnostic for the
# named `operation` on `path`. Typical use is shaping an absent `File?` into a
# fail:
#   match (open_read(p)) { f -> body(pay(f)), ? -> { fail io_error("open", p) } }
share(all)
io_error(operation<String>, path<String>)<IoError> -> {
    return IoError { operation = operation, path = path, message = error_message() }
}

# Compatibility status probe (kept for the module-surface import test).
share(all)
io_status_message()<String> -> {
    return "io: File open/close/read_all/write_str available via `import io`"
}
