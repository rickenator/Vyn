# https - TLS-secured HTTP/1.1 client that layers the `tls` module over the
# pure-`http` client.
#
# Imports `network` for the raw TCP connect, `tls` for the encrypted channel, and
# `http` for its pure request/parse helpers (the status/header/int parsers and
# the shared `HttpResponse` type). Because TLS runs on top of a socket, this
# module does its own TLS-aware I/O (reading the same byte shapes the http
# client does, but from the SSL stream), then reuses http's parsers to build an
# HttpResponse identically to http_get_full. The shared response type is
# re-exported so consumers can name it, and `https_selfhost` gives a no-external-
# server diagnostic of the whole tls+http wiring.
#
#   https_get(host, port, path) -> String        full GET round-trip -> body
#   https_get_full(host, port, path) -> HttpResponse   parsed status/headers/body

import threads::{thread_spawn, thread_join}
import network::{socket_open, socket_bind, socket_listen, socket_accept,
             socket_connect, socket_close, socket_local_port, socket_resolve}
import tls::{tls_client_context, tls_client_context_verified, tls_server_context,
             tls_stream, tls_connect, tls_accept, tls_write, tls_read, tls_close,
             tls_free_context, TlsContext, TlsStream}
# Note: http's helpers and its shared HttpResponse type are imported together in a
# single subset import. Two separate subset imports of the same module are not
# yet spliced independently, so a second subset import of http would be ignored.
share(all) import http::{HttpResponse, http_status_code, http_header_value,
             http_index_of, http_parse_int}

# Read one CRLF-terminated line (without the CRLF) from a TLS stream. One byte
# per read, stopping exactly at the line end, mirroring http's reader but over
# the encrypted channel.
share(all)
tls_read_line(s<TlsStream>)<String> -> {
    buf<String> = ""
    crlf<String> = "\r\n"
    while (true) {
        chunk<String> = tls_read(s, 1)
        if (chunk.len() == 0) { break }
        buf = buf.concat(chunk)
        idx<Int> = buf.index_of(crlf)
        if (idx >= 0) { return buf.substring(0, idx) }
    }
    return buf
}

# Read exactly `length` bytes from a TLS stream.
share(all)
tls_read_exact(s<TlsStream>, length<Int>)<String> -> {
    buf<String> = ""
    while (buf.len() < length) {
        chunk<String> = tls_read(s, length - buf.len())
        if (chunk.len() == 0) { break }
        buf = buf.concat(chunk)
    }
    return buf
}

# Read until the peer closes (used when a response has no Content-Length).
share(all)
tls_read_all(s<TlsStream>, max<Int>)<String> -> {
    buf<String> = ""
    while (buf.len() < max) {
        chunk<String> = tls_read(s, 1024)
        if (chunk.len() == 0) { break }
        buf = buf.concat(chunk)
    }
    return buf
}

# Full HTTPS/1.1 GET round-trip. Returns an HttpResponse with the parsed status,
# reason, headers, and body; status is -1 if the round-trip could not be
# completed (e.g. connection/handshake failure).
share(all)
# Shared round-trip: connect to `connect_ip` on `port`, bring up a TLS session
# over it that verifies the peer against the `verify_host` (SNI + hostname check
# on verifying contexts), send a GET for `path`, and parse the response. Owns
# and frees `ctx`.
# socket_open(AF_INET=2, SOCK_STREAM=1, IPPROTO_TCP=6).
https_fetch(verify_host<String>, connect_ip<String>, port<Int>, path<String>,
            ctx<TlsContext>)<HttpResponse> -> {
    bad<HttpResponse> = HttpResponse { status = -1, reason = "",
                                        headers = Vec<String>(), body = "" }
    fd<Int> = socket_open(2, 1, 6)
    if (fd < 0) { return bad }
    if (socket_connect(fd, connect_ip, port) < 0) {
        socket_close(fd)
        return bad
    }
    s<TlsStream> = tls_stream(ctx, fd, verify_host)
    if (s.ssl < 0) {
        tls_free_context(ctx)
        socket_close(fd)
        return bad
    }
    if (tls_connect(s) != 0) {
        tls_close(s)
        tls_free_context(ctx)
        return bad
    }
    req<String> = "GET " + path + " HTTP/1.1" + "\r\n" + "Host: " + verify_host +
                  "\r\n" + "Connection: close" + "\r\n" + "\r\n"
    tls_write(s, req)
    line<String> = tls_read_line(s)
    code<Int> = http_status_code(line)
    if (code < 0) {
        tls_close(s)
        tls_free_context(ctx)
        return bad
    }
    hs<Vec<String>> = Vec<String>()
    length<Int> = -1
    has_len<Bool> = false
    h<String> = tls_read_line(s)
    while (h.len() > 0) {
        hs.push(h)
        lv<String> = http_header_value(h, "content-length")
        if (lv.len() > 0) {
            length = http_parse_int(lv)
            has_len = true
        }
        h = tls_read_line(s)
    }
    body<String> = ""
    if (has_len) {
        body = tls_read_exact(s, length)
    } else {
        body = tls_read_all(s, 65536)
    }
    reason<String> = ""
    sp<Int> = http_index_of(line, " ")
    if (sp >= 0) {
        rest<String> = line.substring(sp + 1, line.len())
        sp2<Int> = http_index_of(rest, " ")
        if (sp2 >= 0) {
            reason = rest.substring(sp2 + 1, rest.len())
        }
    }
    tls_close(s)
    tls_free_context(ctx)
    return HttpResponse { status = code, reason = reason, headers = hs, body = body }
}

# Full HTTPS/1.1 GET round-trip over an unverified client context (self-signed
# / loopback). `host` must be an IP literal (connect target == verify name).
share(all)
https_get_full(host<String>, port<Int>, path<String>)<HttpResponse> -> {
    ctx<TlsContext> = tls_client_context()
    if (ctx.ctx < 0) { return HttpResponse { status = -1, reason = "", headers = Vec<String>(), body = "" } }
    return https_fetch(host, host, port, path, ctx)
}

# Full HTTPS/1.1 GET round-trip with peer verification. `host` is a hostname:
# it is resolved to an IP for the connection while being verified against the
# certificate (SNI + hostname check). `ca_pem` pins a CA cert or is "" to use
# the system default CA paths.
share(all)
https_get_full_verified(host<String>, port<Int>, path<String>, ca_pem<String>)<HttpResponse> -> {
    bad<HttpResponse> = HttpResponse { status = -1, reason = "",
                                        headers = Vec<String>(), body = "" }
    ip<String> = socket_resolve(host)
    if (ip.len() == 0) { return bad }
    ctx<TlsContext> = tls_client_context_verified(ca_pem)
    if (ctx.ctx < 0) { return bad }
    return https_fetch(host, ip, port, path, ctx)
}


# Convenience wrapper returning just the response body ("" on failure).
share(all)
https_get(host<String>, port<Int>, path<String>)<String> -> {
    resp<HttpResponse> = https_get_full(host, port, path)
    return resp.body
}

# Verified convenience wrapper returning just the response body ("" on failure).
share(all)
https_get_verified(host<String>, port<Int>, path<String>, ca_pem<String>)<String> -> {
    resp<HttpResponse> = https_get_full_verified(host, port, path, ca_pem)
    return resp.body
}

# Diagnostics: stand up a throwaway TLS server that answers one request with a
# well-formed response, fetch it over TLS, and report whether the round-trip
# parsed as expected. Returns 0 on success, -1 on any failure. Useful as a
# self-test of the tls+http wiring without standing up an external server.
share(all)
https_selfhost(cert_pem<String>, key_pem<String>)<Int> -> {
    srv<Int> = socket_open(2, 1, 6)
    if (srv < 0) { return -1 }
    if (socket_bind(srv, "127.0.0.1", 0) < 0) { socket_close(srv); return -1 }
    port<Int> = socket_local_port(srv)
    if (port <= 0) { socket_close(srv); return -1 }
    if (socket_listen(srv, 1) < 0) { socket_close(srv); return -1 }
    scx<TlsContext> = tls_server_context(cert_pem, key_pem)
    if (scx.ctx < 0) { socket_close(srv); return -1 }
    th<Int> = thread_spawn(|| -> {
        c<Int> = socket_accept(srv)
        if (c < 0) { return 1 }
        s<TlsStream> = tls_stream(scx, c, "")
        if (tls_accept(s) != 0) { return 2 }
        got<String> = ""
        while (got.len() < 2048 && got.index_of("\r\n\r\n") < 0) {
            chunk<String> = tls_read(s, 256)
            if (chunk.len() == 0) { break }
            got = got.concat(chunk)
        }
        pk<String> = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 11\r\nConnection: close\r\n\r\nsecure body"
        tls_write(s, pk)
        tls_close(s)
        return 0
    })
    if (th < 0) { tls_free_context(scx); socket_close(srv); return -1 }
    resp<HttpResponse> = https_get_full("127.0.0.1", port, "/secure")
    io<Int> = thread_join(th)
    tls_free_context(scx)
    socket_close(srv)
    if (io != 0) { return -1 }
    if (resp.status != 200) { return -1 }
    if (resp.body != "secure body") { return -1 }
    if (resp.reason != "OK") { return -1 }
    return 0
}

# Diagnostics like https_selfhost, but the client uses a verified context pinned
# to the server's own cert and connects by name so the hostname is checked.
share(all)
https_selfhost_verified(cert_pem<String>, key_pem<String>)<Int> -> {
    srv<Int> = socket_open(2, 1, 6)
    if (srv < 0) { return -1 }
    if (socket_bind(srv, "127.0.0.1", 0) < 0) { socket_close(srv); return -1 }
    port<Int> = socket_local_port(srv)
    if (port <= 0) { socket_close(srv); return -1 }
    if (socket_listen(srv, 1) < 0) { socket_close(srv); return -1 }
    scx<TlsContext> = tls_server_context(cert_pem, key_pem)
    if (scx.ctx < 0) { socket_close(srv); return -1 }
    th<Int> = thread_spawn(|| -> {
        c<Int> = socket_accept(srv)
        if (c < 0) { return 1 }
        s<TlsStream> = tls_stream(scx, c, "")
        if (tls_accept(s) != 0) { return 2 }
        got<String> = ""
        while (got.len() < 2048 && got.index_of("\r\n\r\n") < 0) {
            chunk<String> = tls_read(s, 256)
            if (chunk.len() == 0) { break }
            got = got.concat(chunk)
        }
        pk<String> = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 11\r\nConnection: close\r\n\r\nsecure body"
        tls_write(s, pk)
        tls_close(s)
        return 0
    })
    if (th < 0) { tls_free_context(scx); socket_close(srv); return -1 }
    resp<HttpResponse> = https_get_full_verified("localhost", port, "/secure", cert_pem)
    io<Int> = thread_join(th)
    tls_free_context(scx)
    socket_close(srv)
    if (io != 0) { return -1 }
    if (resp.status != 200) { return -1 }
    if (resp.body != "secure body") { return -1 }
    if (resp.reason != "OK") { return -1 }
    return 0
}
