# https - TLS-secured HTTP/1.1 client that layers the `tls` module over the
# pure-`http` client.
#
# Imports `network` for the raw TCP connect, `tls` for the encrypted channel, and
# `http` for its pure request/parse helpers (the status/header/int parsers and
# the shared `HttpResponse` type). Because TLS runs on top of a socket, this
# module does its own TLS-aware I/O (reading the same byte shapes the http
# client does, but from the SSL stream), then reuses http's parsers to build an
# HttpResponse identically to http_get_full. The shared response type is
# re-exported so consumers can name it, and `https_selfhost` gives a no-external-
# server diagnostic of the whole tls+http wiring.
#
#   https_get(host, port, path) -> String?             full GET round-trip -> body (absent on failure)
#   https_get_full(host, port, path) -> HttpResponse?   parsed status/headers/body
#   https_get_full_verified(host, port, path, ca) -> HttpResponse?
#   https_get_verified(host, port, path, ca) -> String?
#
#   Fallibility: an absent `HttpResponse?`/`String?` is a failed round-trip.
#   Escalate via `match`/`else` and `fail http_error(op, host)`.

import threads::{thread_spawn, thread_join}
import network::{socket_open, socket_bind, socket_listen, socket_accept,
             socket_connect, socket_close, socket_local_port, socket_resolve}
import tls::{tls_client_context, tls_client_context_verified, tls_server_context,
             tls_stream, tls_write, tls_read, tls_close,
             tls_free_context, TlsContext, TlsStream, TlsStreamOps}
# http's helpers and its shared HttpResponse type are imported via two separate
# subset imports of http; the module resolver now splices each subset import
# independently (deep-cloning http's body per consumer).
share(all) import http::{HttpResponse}
import http::{http_status_code, http_header_value, http_index_of, http_parse_int,
              http_parse_hex}

# Read one CRLF-terminated line (without the CRLF) from a TLS stream. One byte
# per read, stopping exactly at the line end, mirroring http's reader but over
# the encrypted channel.
share(all)
tls_read_line(s<TlsStream>)<String> -> {
    buf<String> = ""
    crlf<String> = "\r\n"
    while (true) {
        chunk<String> = tls_read(s, 1) else ""
        if (chunk.len() == 0) { break }
        buf = buf.concat(chunk)
        idx<Int> = buf.index_of(crlf)
        if (idx >= 0) { return buf.substring(0, idx) }
    }
    return buf
}

# Read exactly `length` bytes from a TLS stream.
share(all)
tls_read_exact(s<TlsStream>, length<Int>)<String> -> {
    buf<String> = ""
    while (buf.len() < length) {
        chunk<String> = tls_read(s, length - buf.len()) else ""
        if (chunk.len() == 0) { break }
        buf = buf.concat(chunk)
    }
    return buf
}

# Read until the peer closes (used when a response has no Content-Length).
share(all)
tls_read_all(s<TlsStream>, max<Int>)<String> -> {
    buf<String> = ""
    while (buf.len() < max) {
        chunk<String> = tls_read(s, 1024) else ""
        if (chunk.len() == 0) { break }
        buf = buf.concat(chunk)
    }
    return buf
}

# Read a `Transfer-Encoding: chunked` body over TLS, stripping the hex framing
# (mirrors http_read_chunked but through the SSL stream).
share(all)
tls_read_chunked(s<TlsStream>)<String> -> {
    body<String> = ""
    while (true) {
        hdr<String> = tls_read_line(s)
        size<Int> = http_parse_hex(hdr)
        if (size <= 0 || hdr.len() == 0) {
            t<String> = tls_read_line(s)
            while (t.len() > 0) { t = tls_read_line(s) }
            break
        }
        body = body.concat(tls_read_exact(s, size))
        tls_read_exact(s, 2)
    }
    return body
}

# Full HTTPS/1.1 GET round-trip. Returns an HttpResponse with the parsed status,
# reason, headers, and body; status is -1 if the round-trip could not be
# completed (e.g. connection/handshake failure).
share(all)
# Shared round-trip: connect to `connect_ip` on `port`, bring up a TLS session
# over it that verifies the peer against the `verify_host` (SNI + hostname check
# on verifying contexts), send a GET for `path`, and parse the response. Owns
# and frees `ctx`.
# socket_open(AF_INET=2, SOCK_STREAM=1, IPPROTO_TCP=6).
https_fetch(verify_host<String>, connect_ip<String>, port<Int>, path<String>,
            ctx<TlsContext>)<HttpResponse?> -> {
    fd<Int> = socket_open(2, 1, 6) else -1
    if (fd < 0) { return HttpResponse?() }
    if (!(socket_connect(fd, connect_ip, port) else false)) {
        socket_close(fd)
        return HttpResponse?()
    }
    match (tls_stream(ctx, fd, verify_host)) {
        s -> {
            match (s.connect()) {
                c -> {
                    req<String> = "GET " + path + " HTTP/1.1" + "\r\n" + "Host: " + verify_host +
                                  "\r\n" + "Connection: close" + "\r\n" + "\r\n"
                    tls_write(c, req)
                    line<String> = tls_read_line(c)
                    code<Int> = http_status_code(line)
                    if (code < 0) {
                        tls_close(c)
                        tls_free_context(ctx)
                        return HttpResponse?()
                    }
                    hs<Vec<String>> = Vec<String>()
                    length<Int> = -1
                    has_len<Bool> = false
                    chunked<Bool> = false
                    h<String> = tls_read_line(c)
                    while (h.len() > 0) {
                        hs.push(h)
                        lv<String> = http_header_value(h, "content-length")
                        if (lv.len() > 0) {
                            length = http_parse_int(lv)
                            has_len = true
                        }
                        te<String> = http_header_value(h, "transfer-encoding")
                        if (http_index_of(te.to_lower(), "chunked") >= 0) {
                            chunked = true
                        }
                        h = tls_read_line(c)
                    }
                    body<String> = ""
                    if (chunked) {
                        body = tls_read_chunked(c)
                    } else if (has_len) {
                        body = tls_read_exact(c, length)
                    } else {
                        body = tls_read_all(c, 65536)
                    }
                    reason<String> = ""
                    sp<Int> = http_index_of(line, " ")
                    if (sp >= 0) {
                        rest<String> = line.substring(sp + 1, line.len())
                        sp2<Int> = http_index_of(rest, " ")
                        if (sp2 >= 0) {
                            reason = rest.substring(sp2 + 1, rest.len())
                        }
                    }
                    tls_close(c)
                    tls_free_context(ctx)
                    return HttpResponse?(HttpResponse { status = code, reason = reason, headers = hs, body = body })
                }
                ? -> {
                    tls_close(s)
                    tls_free_context(ctx)
                    return HttpResponse?()
                }
            }
        }
        ? -> {
            socket_close(fd)
            tls_free_context(ctx)
            return HttpResponse?()
        }
    }
}

# Full HTTPS/1.1 GET round-trip over an unverified client context (self-signed
# / loopback). `host` must be an IP literal (connect target == verify name).
share(all)
https_get_full(host<String>, port<Int>, path<String>)<HttpResponse?> -> {
    match (tls_client_context()) {
        ctx -> { return https_fetch(host, host, port, path, ctx) }
        ? -> { return HttpResponse?() }
    }
}

# Full HTTPS/1.1 GET round-trip with peer verification. `host` is a hostname:
# it is resolved to an IP for the connection while being verified against the
# certificate (SNI + hostname check). `ca_pem` pins a CA cert or is "" to use
# the system default CA paths.
share(all)
https_get_full_verified(host<String>, port<Int>, path<String>, ca_pem<String>)<HttpResponse?> -> {
    ip<String> = socket_resolve(host) else ""
    if (ip.len() == 0) { return HttpResponse?() }
    match (tls_client_context_verified(ca_pem)) {
        ctx -> { return https_fetch(host, ip, port, path, ctx) }
        ? -> { return HttpResponse?() }
    }
}


# Convenience wrapper returning just the response body as a `String?` (absent on
# failure, so an empty body is still a valid present value).
share(all)
https_get(host<String>, port<Int>, path<String>)<String?> -> {
    match (https_get_full(host, port, path)) {
        resp -> { return String?(resp.body) }
        ? -> { return String?() }
    }
}

# Verified convenience wrapper returning just the response body as a `String?`
# (absent on failure).
share(all)
https_get_verified(host<String>, port<Int>, path<String>, ca_pem<String>)<String?> -> {
    match (https_get_full_verified(host, port, path, ca_pem)) {
        resp -> { return String?(resp.body) }
        ? -> { return String?() }
    }
}

# Diagnostics: stand up a throwaway TLS server that answers one request with a
# well-formed response, fetch it over TLS, and report whether the round-trip
# parsed as expected. Returns 0 on success, -1 on any failure. Useful as a
# self-test of the tls+http wiring without standing up an external server.
share(all)
https_selfhost(cert_pem<String>, key_pem<String>)<Int> -> {
    srv<Int> = socket_open(2, 1, 6) else -1
    if (srv < 0) { return -1 }
    if (!(socket_bind(srv, "127.0.0.1", 0) else false)) { socket_close(srv); return -1 }
    port<Int> = socket_local_port(srv) else -1
    if (port <= 0) { socket_close(srv); return -1 }
    if (!(socket_listen(srv, 1) else false)) { socket_close(srv); return -1 }
    match (tls_server_context(cert_pem, key_pem)) {
        scx -> {
            th<Int> = thread_spawn(|| -> {
                c<Int> = socket_accept(srv) else -1
                if (c < 0) { return 1 }
                match (tls_stream(scx, c, "")) {
                    s -> {
                        match (s.accept()) {
                            ok -> {
                                got<String> = ""
                                while (got.len() < 2048 && got.index_of("\r\n\r\n") < 0) {
                                    chunk<String> = tls_read(ok, 256) else ""
                                    if (chunk.len() == 0) { break }
                                    got = got.concat(chunk)
                                }
                                pk<String> = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 11\r\nConnection: close\r\n\r\nsecure body"
                                tls_write(ok, pk)
                                tls_close(ok)
                                return 0
                            }
                            ? -> { tls_close(s); return 2 }
                        }
                    }
                    ? -> { socket_close(c); return 2 }
                }
}) else -1
            if (th < 0) { tls_free_context(scx); socket_close(srv); return -1 }
            code<Int> = 0
            got<String> = ""
            rs<String> = ""
            match (https_get_full("127.0.0.1", port, "/secure")) {
                resp -> { code = resp.status; got = resp.body; rs = resp.reason }
                ? -> { }
            }
            io<Int> = thread_join(th) else -2
            tls_free_context(scx)
            socket_close(srv)
            if (io != 0) { return -1 }
            if (code != 200) { return -1 }
            if (got != "secure body") { return -1 }
            if (rs != "OK") { return -1 }
            return 0
        }
        ? -> { socket_close(srv); return -1 }
    }
}

# Diagnostics like https_selfhost, but the client uses a verified context pinned
# to the server's own cert and connects by name so the hostname is checked.
share(all)
https_selfhost_verified(cert_pem<String>, key_pem<String>)<Int> -> {
    srv<Int> = socket_open(2, 1, 6) else -1
    if (srv < 0) { return -1 }
    if (!(socket_bind(srv, "127.0.0.1", 0) else false)) { socket_close(srv); return -1 }
    port<Int> = socket_local_port(srv) else -1
    if (port <= 0) { socket_close(srv); return -1 }
    if (!(socket_listen(srv, 1) else false)) { socket_close(srv); return -1 }
    match (tls_server_context(cert_pem, key_pem)) {
        scx -> {
            th<Int> = thread_spawn(|| -> {
                c<Int> = socket_accept(srv) else -1
                if (c < 0) { return 1 }
                match (tls_stream(scx, c, "")) {
                    s -> {
                        match (s.accept()) {
                            ok -> {
                                got<String> = ""
                                while (got.len() < 2048 && got.index_of("\r\n\r\n") < 0) {
                                    chunk<String> = tls_read(ok, 256) else ""
                                    if (chunk.len() == 0) { break }
                                    got = got.concat(chunk)
                                }
                                pk<String> = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 11\r\nConnection: close\r\n\r\nsecure body"
                                tls_write(ok, pk)
                                tls_close(ok)
                                return 0
                            }
                            ? -> { tls_close(s); return 2 }
                        }
                    }
                    ? -> { socket_close(c); return 2 }
                }
}) else -1
            if (th < 0) { tls_free_context(scx); socket_close(srv); return -1 }
            code<Int> = 0
            got<String> = ""
            rs<String> = ""
            match (https_get_full_verified("localhost", port, "/secure", cert_pem)) {
                resp -> { code = resp.status; got = resp.body; rs = resp.reason }
                ? -> { }
            }
            io<Int> = thread_join(th) else -2
            tls_free_context(scx)
            socket_close(srv)
            if (io != 0) { return -1 }
            if (code != 200) { return -1 }
            if (got != "secure body") { return -1 }
            if (rs != "OK") { return -1 }
            return 0
        }
        ? -> { socket_close(srv); return -1 }
    }
}
