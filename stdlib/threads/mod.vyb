# threads - pthread-backed threading and mutexes for Vyb.
#
# A thread runs a `fn() -> Int` closure (no captures / no arguments in this
# first cut — capturing closures are a later follow-on): thread_spawn starts it
# and returns a handle, thread_join blocks until it finishes and returns the
# closure's result. A Mutex provides mutual exclusion. Everything maps 1:1 onto
# POSIX threads underneath, keeping the pthread ABI out of Vyb code.
#
# Usage:
#   import threads
#   h = thread_spawn(|| -> 40 + 2)
#   v = thread_join(h) else -2   // 42
#
#   m = mutex_new() else 0
#   mutex_lock(m); ... shared section ...; mutex_unlock(m)
#   mutex_free(m)
#
#   cv = cond_new() else 0                 // pair a condvar with a Mutex
#   cond_wait(cv, m); cond_signal(cv); cond_broadcast(cv)
#
#   cnt = atomic_new(0) else 0              // lock-free shared Int
#   atomic_add(cnt, 1); atomic_load(cnt); atomic_cas(cnt, old, new)

# Start `work` on a new thread. Returns `Int?` -- present holding the thread
# handle (>= 1) when the thread was created, absent when it could not be spawned
# (thread-table full or pthread_create failed), so callers escalate the failure
# with `else`/`match` instead of a `-1` sentinel. The handle-creators below
# (mutex_new/cond_new/atomic_new) return `Int?`, and the mutex/cond/atomic
# op-status helpers return `Bool?` (present on success). atomic_load,
# atomic_add (returns the new value) and atomic_cas (1/0 probe) keep returning
# their value/probe.
share(all)
thread_spawn(work<fn() -> Int>)<Int?> -> {
    h<Int> = vyb_thread_spawn(work)
    if (h < 1) { return Int?() }
    return Int?(h)
}

# Wait for the thread `handle` to finish. Returns `Int?` -- present holding the
# closure result (which may legitimately be any Int), absent when the handle is
# unknown, detached, or already joined. A spawned thread's slot is only
# reclaimed once it is joined. Unwrap with `else default` or `match`.
share(all)
thread_join(handle<Int>)<Int?> -> {
    return vyb_thread_join_opt(handle)
}

# Detach `handle`: the thread becomes non-joinable and its slot is reclaimed
# automatically once its body returns (a reaper), so fire-and-forget workers
# (e.g. per-connection HTTP handlers) can't exhaust the fixed thread table.
# Returns `Bool?` -- present when detached, absent if the handle is
# unknown/already-reaped or already detached.
share(all)
thread_detach(handle<Int>)<Bool?> -> {
    if (vyb_thread_detach(handle) != 0) { return Bool?() }
    return Bool?(true)
}

# A fresh, unlocked mutex. Returns `Int?` -- present holding the handle, absent
# on allocation/init failure.
share(all)
mutex_new()<Int?> -> {
    m<Int> = vyb_mutex_new()
    if (m == 0) { return Int?() }
    return Int?(m)
}

# Lock `m`, blocking until acquired. Returns `Bool?` -- present on success,
# absent on error.
share(all)
mutex_lock(m<Int>)<Bool?> -> {
    if (vyb_mutex_lock(m) != 0) { return Bool?() }
    return Bool?(true)
}

# Unlock `m`. Returns `Bool?` -- present on success, absent on error.
share(all)
mutex_unlock(m<Int>)<Bool?> -> {
    if (vyb_mutex_unlock(m) != 0) { return Bool?() }
    return Bool?(true)
}

# Destroy and free `m`. Returns `Bool?` -- present on success, absent on error.
share(all)
mutex_free(m<Int>)<Bool?> -> {
    if (vyb_mutex_free(m) != 0) { return Bool?() }
    return Bool?(true)
}


# Condition variable: a lightweight signal/wake primitive that pairs with a
# Mutex. cond_wait atomically releases `m`, sleeps until signalled, then
# reacquires `m` before returning. Usage:
#
#   cv = cond_new() else 0
#   m  = mutex_new() else 0
#   ...
#   mutex_lock(m)
#   while (!ready) { cond_wait(cv, m) }   // releases + reacquires around wait
#   mutex_unlock(m)
#
#   cond_signal(cv)   // wake one waiter
#   cond_broadcast(cv) // wake all waiters
#   cond_free(cv)

# A fresh condition variable. Returns `Int?` -- present holding the handle,
# absent on allocation/init failure.
share(all)
cond_new()<Int?> -> {
    c<Int> = vyb_cond_new()
    if (c == 0) { return Int?() }
    return Int?(c)
}

# Atomically release `m`, block until signalled/broadcast, then reacquire `m`.
# Returns `Bool?` -- present on success, absent on error.
share(all)
cond_wait(cv<Int>, m<Int>)<Bool?> -> {
    if (vyb_cond_wait(cv, m) != 0) { return Bool?() }
    return Bool?(true)
}

# Wake one waiter blocked in cond_wait on `cv` (no-op if none). Returns `Bool?`.
share(all)
cond_signal(cv<Int>)<Bool?> -> {
    if (vyb_cond_signal(cv) != 0) { return Bool?() }
    return Bool?(true)
}

# Wake every waiter blocked in cond_wait on `cv`. Returns `Bool?`.
share(all)
cond_broadcast(cv<Int>)<Bool?> -> {
    if (vyb_cond_broadcast(cv) != 0) { return Bool?() }
    return Bool?(true)
}

# Destroy and free `cv`. Returns `Bool?` -- present on success, absent on error.
share(all)
cond_free(cv<Int>)<Bool?> -> {
    if (vyb_cond_free(cv) != 0) { return Bool?() }
    return Bool?(true)
}

# AtomicInt: a lock-free integer shared across threads (seq_cst). Usage:
#
#   cnt = atomic_new(0) else 0
#   atomic_add(cnt, 1)      // returns the new value
#   v = atomic_load(cnt)
#   atomic_cas(cnt, v, v+1) // 1 if the compare-and-swap succeeded, else 0
#   atomic_free(cnt)

# A fresh atomic int initialized to `init`. Returns `Int?` -- present holding
# the handle, absent on allocation failure.
share(all)
atomic_new(init<Int>)<Int?> -> {
    a<Int> = vyb_atomic_new(init)
    if (a == 0) { return Int?() }
    return Int?(a)
}

# Atomically read and return the stored value.
share(all)
atomic_load(a<Int>)<Int> -> {
    return vyb_atomic_load(a)
}

# Atomically store `v`. Returns `Bool?` -- present on success, absent on error.
share(all)
atomic_store(a<Int>, v<Int>)<Bool?> -> {
    if (vyb_atomic_store(a, v) != 0) { return Bool?() }
    return Bool?(true)
}

# Atomically add `v` to the stored value; returns the *new* value after the add
# (a value return, not an op-status, so it stays Int).
share(all)
atomic_add(a<Int>, v<Int>)<Int> -> {
    return vyb_atomic_add(a, v)
}

# Atomically set the value to `desired` if it is currently `expected`; returns
# a 1/0 probe -- 1 if the swap happened, else 0 (a value, not an op-status, so it
# stays Int).
share(all)
atomic_cas(a<Int>, expected<Int>, desired<Int>)<Int> -> {
    return vyb_atomic_cas(a, expected, desired)
}

# Destroy and free `a`. Returns `Bool?` -- present on success, absent on error.
share(all)
atomic_free(a<Int>)<Bool?> -> {
    if (vyb_atomic_free(a) != 0) { return Bool?() }
    return Bool?(true)
}
