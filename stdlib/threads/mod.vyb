# threads - pthread-backed threading and mutexes for Vyb.
#
# A thread runs a `fn() -> Int` closure (no captures / no arguments in this
# first cut — capturing closures are a later follow-on): thread_spawn starts it
# and returns a handle, thread_join blocks until it finishes and returns the
# closure's result. A Mutex provides mutual exclusion. Everything maps 1:1 onto
# POSIX threads underneath, keeping the pthread ABI out of Vyb code.
#
# Usage:
#   import threads
#   h = thread_spawn(|| -> 40 + 2)
#   v = thread_join(h)     // 42
#
#   m = mutex_new()
#   mutex_lock(m); ... shared section ...; mutex_unlock(m)
#   mutex_free(m)
#
#   cv = cond_new()                 // pair a condvar with a Mutex
#   cond_wait(cv, m); cond_signal(cv); cond_broadcast(cv)
#
#   cnt = atomic_new(0)             // lock-free shared Int
#   atomic_add(cnt, 1); atomic_load(cnt); atomic_cas(cnt, old, new)

# Start `work` on a new thread. Returns `Int?` -- present holding the thread
# handle (>= 1) when the thread was created, absent when it could not be spawned
# (thread-table full or pthread_create failed), so callers escalate the failure
# with `else`/`match` instead of a `-1` sentinel. The mutex/cond/atomic helpers
# below keep their documented Int status/return codes (they are not fallible
# "open"s).
share(all)
thread_spawn(work<fn() -> Int>)<Int?> -> {
    h<Int> = vyb_thread_spawn(work)
    if (h < 1) { return Int?() }
    return Int?(h)
}

# Wait for the thread `handle` to finish and return its closure result. Returns
# -2 if the handle is unknown or already joined. A spawned thread's slot is only
# reclaimed once it is joined.
share(all)
thread_join(handle<Int>)<Int> -> {
    return vyb_thread_join(handle)
}

# Detach `handle`: the thread becomes non-joinable and its slot is reclaimed
# automatically once its body returns (a reaper), so fire-and-forget workers
# (e.g. per-connection HTTP handlers) can't exhaust the fixed thread table.
# Returns 0 on success, -2 for an unknown/already-reaped handle, -1 if it was
# already detached.
share(all)
thread_detach(handle<Int>)<Int> -> {
    return vyb_thread_detach(handle)
}

# A fresh, unlocked mutex handle (0 on allocation/init failure).
share(all)
mutex_new()<Int> -> {
    return vyb_mutex_new()
}

# Lock `m`, blocking until acquired; returns 0 or -1 on error.
share(all)
mutex_lock(m<Int>)<Int> -> {
    return vyb_mutex_lock(m)
}

# Unlock `m`; returns 0 or -1 on error.
share(all)
mutex_unlock(m<Int>)<Int> -> {
    return vyb_mutex_unlock(m)
}

# Destroy and free `m`; returns 0 or -1 on error.
share(all)
mutex_free(m<Int>)<Int> -> {
    return vyb_mutex_free(m)
}


# Condition variable: a lightweight signal/wake primitive that pairs with a
# Mutex. cond_wait atomically releases `m`, sleeps until signalled, then
# reacquires `m` before returning. Usage:
#
#   cv = cond_new()
#   m  = mutex_new()
#   ...
#   mutex_lock(m)
#   while (!ready) { cond_wait(cv, m) }   // releases + reacquires around wait
#   mutex_unlock(m)
#
#   cond_signal(cv)   // wake one waiter
#   cond_broadcast(cv) // wake all waiters
#   cond_free(cv)

# A fresh, unlocked-pair condition variable handle (0 on allocation/init failure).
share(all)
cond_new()<Int> -> {
    return vyb_cond_new()
}

# Atomically release `m`, block until signalled/broadcast, then reacquire `m`.
# Returns 0, or -1 on error.
share(all)
cond_wait(cv<Int>, m<Int>)<Int> -> {
    return vyb_cond_wait(cv, m)
}

# Wake one waiter blocked in cond_wait on `cv` (no-op if none); returns 0 or -1.
share(all)
cond_signal(cv<Int>)<Int> -> {
    return vyb_cond_signal(cv)
}

# Wake every waiter blocked in cond_wait on `cv`; returns 0 or -1.
share(all)
cond_broadcast(cv<Int>)<Int> -> {
    return vyb_cond_broadcast(cv)
}

# Destroy and free `cv`; returns 0 or -1 on error.
share(all)
cond_free(cv<Int>)<Int> -> {
    return vyb_cond_free(cv)
}

# AtomicInt: a lock-free integer shared across threads (seq_cst). Usage:
#
#   cnt = atomic_new(0)
#   atomic_add(cnt, 1)      // returns the new value
#   v = atomic_load(cnt)
#   atomic_cas(cnt, v, v+1) // 1 if the compare-and-swap succeeded, else 0
#   atomic_free(cnt)

# A fresh atomic int initialized to `init` (0 on allocation failure).
share(all)
atomic_new(init<Int>)<Int> -> {
    return vyb_atomic_new(init)
}

# Atomically read and return the stored value.
share(all)
atomic_load(a<Int>)<Int> -> {
    return vyb_atomic_load(a)
}

# Atomically store `v`; returns 0 or -1 on error.
share(all)
atomic_store(a<Int>, v<Int>)<Int> -> {
    return vyb_atomic_store(a, v)
}

# Atomically add `v` to the stored value; returns the *new* value after the add.
share(all)
atomic_add(a<Int>, v<Int>)<Int> -> {
    return vyb_atomic_add(a, v)
}

# Atomically set the value to `desired` if it is currently `expected`; returns
# 1 if the swap happened, else 0.
share(all)
atomic_cas(a<Int>, expected<Int>, desired<Int>)<Int> -> {
    return vyb_atomic_cas(a, expected, desired)
}

# Destroy and free `a`; returns 0 or -1 on error.
share(all)
atomic_free(a<Int>)<Int> -> {
    return vyb_atomic_free(a)
}
