# curses - ncurses terminal UI, wrapped as an opaque-Int surface.
#
# A whole-terminal TUI module over ncursesw, used by programs like the VybLynx
# browser. The ncurses WINDOW*/ABI stays in the runtime (`__vyb_curses_*` shims
# in `runtime/vyb_runtime.c`); Vyb sees only Int keycodes, Int attributes, Int
# dimensions, and String text.
#
# Lifecycle: call curses_init() once, draw, then curses_close(). The screen is a
# single global owned by the active program; exactly one subsystem should mutate
# it (ncurses refresh is not thread-safe). Op-status functions return native
# optionals: curses_init() returns `Int?` (present once the screen is active),
# and the draw/attr/window helpers (curses_refresh, clear, move, addstr,
# move_addstr, start_color, init_pair, attr_on/off, nodelay, timeout, keypad,
# show_cursor, hide_cursor, close) return `Bool?`. Value getters stay Int:
#   * curses_ok()              1 while the screen is initialized, else 0
#   * curses_has_color()       1 if the terminal supports color, else 0
#   * curses_rows/cols         the current terminal size
#   * curses_color_pair(n)     an attribute value for curses_attr_on/off
#   * curses_getch()           the pressed key/KEY_* code, or -1 when a
#                              timeout/no-delay read finds no input
# Input is blocking by default. For a nonblocking UI loop (so the browser can
# keep network/async work moving without stalling on a keypress), call
# curses_nodelay(1) (immediate nonblocking) or curses_timeout(ms) (poll up to
# ms); curses_getch() then returns -1 when nothing is pending -- a timeout is
# "ran but found nothing", not an operation failure, so it stays a sentinel.

# Initialize the terminal. Returns `Int?` -- present once the screen is active,
# absent if stdin is not a TTY or initscr fails. Enables cbreak (immediate
# keypresses), noecho, and the keypad.
share(all)
curses_init()<Int?> -> {
    if (vyb_curses_init() != 0) { return Int?() }
    return Int?(1)
}

# Shut the screen down and restore the terminal. Safe to call when not active.
# Returns `Bool?` -- present on success, absent if the teardown failed.
share(all)
curses_close()<Bool?> -> {
    if (vyb_curses_close() != 0) { return Bool?() }
    return Bool?(true)
}

# 1 while the screen is initialized (curses_init succeeded, curses_close not
# yet called), 0 otherwise.
share(all)
curses_ok()<Int> -> {
    return vyb_curses_ok()
}

# Current terminal row count (Int), or -1 if the screen is not active.
share(all)
curses_rows()<Int> -> {
    return vyb_curses_rows()
}

# Current terminal column count, or -1 if the screen is not active.
share(all)
curses_cols()<Int> -> {
    return vyb_curses_cols()
}

# Flush pending screen changes to the terminal. Call after drawing a frame.
# Returns `Bool?` -- present on success, absent on error.
share(all)
curses_refresh()<Bool?> -> {
    if (vyb_curses_refresh() != 0) { return Bool?() }
    return Bool?(true)
}

# Clear the screen window. Returns `Bool?` -- present on success, absent if the
# screen is not active.
share(all)
curses_clear()<Bool?> -> {
    if (vyb_curses_clear() != 0) { return Bool?() }
    return Bool?(true)
}

# Move the cursor to (row, col) (0-based) before the next addstr. Returns
# `Bool?` -- present on success, absent on error.
share(all)
curses_move(row<Int>, col<Int>)<Bool?> -> {
    if (vyb_curses_move(row, col) != 0) { return Bool?() }
    return Bool?(true)
}

# Write `s` at the cursor. Returns `Bool?` -- present on success, absent if the
# screen is not active.
share(all)
curses_addstr(s<String>)<Bool?> -> {
    if (vyb_curses_addstr(s) != 0) { return Bool?() }
    return Bool?(true)
}

# Move to (row, col) then write `s`. Returns `Bool?` -- present on success,
# absent on any error.
share(all)
curses_move_addstr(row<Int>, col<Int>, s<String>)<Bool?> -> {
    if (vyb_curses_move_addstr(row, col, s) != 0) { return Bool?() }
    return Bool?(true)
}

# 1 if the terminal supports color, else 0. Safe to call before init.
share(all)
curses_has_color()<Int> -> {
    return vyb_curses_has_color()
}

# Enable color support (must call after curses_init, before using color pairs).
# Returns `Bool?` -- present on success, absent if color could not be started.
share(all)
curses_start_color()<Bool?> -> {
    if (vyb_curses_start_color() != 0) { return Bool?() }
    return Bool?(true)
}

# Color-pair n expressed as an attribute value to pass to curses_attr_on.
share(all)
curses_color_pair(n<Int>)<Int> -> {
    return vyb_curses_color_pair(n)
}

# Turn on an attribute value (e.g. A_BOLD | curses_color_pair(n)). Call
# curses_attr_off to clear it before drawing the next text. Returns `Bool?`.
share(all)
curses_attr_on(attrs<Int>)<Bool?> -> {
    if (vyb_curses_attr_on(attrs) != 0) { return Bool?() }
    return Bool?(true)
}

# Turn off an attribute value previously enabled with curses_attr_on. Returns
# `Bool?`.
share(all)
curses_attr_off(attrs<Int>)<Bool?> -> {
    if (vyb_curses_attr_off(attrs) != 0) { return Bool?() }
    return Bool?(true)
}

# Read one keypress (blocking). Returns the key code (a character code or a
# KEY_* value), or -1 on an error or when a timeout / no-delay read has no input.
share(all)
curses_getch()<Int> -> {
    return vyb_curses_getch()
}

# 1: getch returns immediately (-1) when nothing is pending; 0: block for input.
# Returns `Bool?`.
share(all)
curses_nodelay(flag<Bool>)<Bool?> -> {
    if (flag) {
        if (vyb_curses_nodelay(1) != 0) { return Bool?() }
    } else {
        if (vyb_curses_nodelay(0) != 0) { return Bool?() }
    }
    return Bool?(true)
}

# Set getch polling: -1 blocks, 0 no-wait, >0 wait up to ms. Returns `Bool?`.
share(all)
curses_timeout(ms<Int>)<Bool?> -> {
    if (vyb_curses_timeout(ms) != 0) { return Bool?() }
    return Bool?(true)
}

# Enable (1) / disable (0) the keypad so arrow/function keys arrive as KEY_*
# codes. Returns `Bool?`.
share(all)
curses_keypad(flag<Bool>)<Bool?> -> {
    if (flag) {
        if (vyb_curses_keypad(1) != 0) { return Bool?() }
    } else {
        if (vyb_curses_keypad(0) != 0) { return Bool?() }
    }
    return Bool?(true)
}

# Show the terminal cursor. Returns `Bool?` -- present on success, absent if the
# screen is not active.
share(all)
curses_show_cursor()<Bool?> -> {
    if (vyb_curses_show_cursor() != 0) { return Bool?() }
    return Bool?(true)
}

# Hide the terminal cursor (typical for full-screen UIs). Returns `Bool?`.
share(all)
curses_hide_cursor()<Bool?> -> {
    if (vyb_curses_hide_cursor() != 0) { return Bool?() }
    return Bool?(true)
}

# --- Color support ---------------------------------------------------------
# The ncurses COLOR_* values are 0..7 and stable; a 0-based color-pair index is
# defined with curses_init_pair then applied via curses_color_pair(n).
share(all)
enum CursColor {
    Black = 0
    Red = 1
    Green = 2
    Yellow = 3
    Blue = 4
    Magenta = 5
    Cyan = 6
    White = 7
    Default = -1
}

# Define color-pair `pair` as foreground `fg` on background `bg` (both CursColor).
# Only pairs you define here will show color; undefined pairs render as defaults.
# Call after curses_start_color(). Returns `Bool?` -- present on success,
# absent on error.
share(all)
curses_init_pair(pair<Int>, fg<Int>, bg<Int>)<Bool?> -> {
    if (vyb_curses_init_pair(pair, fg, bg) != 0) { return Bool?() }
    return Bool?(true)
}

# --- Attribute constants (ncurses A_* values, resolved by the runtime) ------
share(all)
curses_attr_normal()<Int> -> { return vyb_curses_attr_normal() }
share(all)
curses_attr_bold()<Int> -> { return vyb_curses_attr_bold() }
share(all)
curses_attr_underline()<Int> -> { return vyb_curses_attr_underline() }
share(all)
curses_attr_reverse()<Int> -> { return vyb_curses_attr_reverse() }
share(all)
curses_attr_blink()<Int> -> { return vyb_curses_attr_blink() }

# --- Key codes (ncurses KEY_* values; getch returns these for arrow/f keys) --
# Character codes (newline/tab/escape) may also arrive directly from the keypad.
share(all)
enum CursKey {
    down = 258
    up = 259
    left = 260
    right = 261
    home = 262
    backspace = 263
    pgdown = 338
    pgup = 339
    enter = 343
    end = 360
    tab = 9
    newline = 10
    carriage = 13
    esc = 27
    space = 32
}
