# env - read and write the process environment.
#
# Thin wrappers over the runtime's `__vyb_env_*` functions in
# `runtime/vyb_runtime.c`. A lynx-style browser reads HTTP_PROXY / HOME / TERM
# here instead of hard-coding them. `env_get` follows the engine-wide `T?` shape
# (PROGRAMMERS_GUIDE §3.16): it returns `String?` -- absent when the variable is
# unset, present holding its value (which may legitimately be empty). `env_set` /
# `env_unset` return `Bool?` -- absent on failure (the change applies to this
# process and any children it spawns).
#
# Usage:
#   import env
#   home<String> = env_get("HOME") else "~"
#   match (env_get("UNSET")) { v -> ..., ? -> ... }   // absent = unset

share(all)
env_get(name<String>)<String?> -> {
    return vyb_env_get_opt(name)
}

# Set `name` in the process environment. Returns `Bool?` -- present on success,
# absent on failure.
share(all)
env_set(name<String>, value<String>)<Bool?> -> {
    r<Int> = vyb_env_set(name, value)
    if (r != 0) { return Bool?() }
    return Bool?(true)
}

# Remove `name` from the process environment. Returns `Bool?` -- present on
# success, absent on failure.
share(all)
env_unset(name<String>)<Bool?> -> {
    r<Int> = vyb_env_unset(name)
    if (r != 0) { return Bool?() }
    return Bool?(true)
}
