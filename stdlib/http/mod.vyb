# http - a pure-Vyb HTTP/1.1 server and client over the runtime sockets.
#
# Everything here is written in Vyb on top of the `network` module - http uses
# sockets but its own public surface stays just `http_*` functions carrying
# `Int`s/Strings. No new FFI and no C code. It is minimal by design but real: it parses request
# heads, builds well-formed responses, and serves and fetches over TCP
# loopback/lan.
#
#   Server (building blocks):
#     http_listen(port, backlog) -> TcpListener?   open + bind + listen (0 = ephemeral)
#     http_local_port(listener) -> Int             the bound port (handy after a 0)
#     http_accept(listener) -> TcpStream?          accept one pending connection
#     http_read_head(fd, max) -> String            read the head, up to CRLFCRLF
#     http_request_path(head) -> String            "GET /x HTTP/1.1" -> "/x"
#     http_send_all(fd, data) -> Int               send the whole string
#     http_close(fd) -> Int                        close a socket/connection
#     http_response(status, body) -> String        a well-formed text/plain response
#
#   Client (convenience):
#     http_request(method, path, host) -> String   a request head
#     http_read_rest(fd, max) -> String            everything until the peer closes
#     http_get(host, port, path) -> String?        full GET round-trip -> body (absent on failure)
#     http_get_full(host, port, path) -> HttpResponse  full HTTP/1.1 client; failed
#                                                     round-trips carry a lossless
#                                                     `error` reason (status -1)
#
#   Concurrent server:
#     http_serve(port, backlog) -> TcpListener?  listen + accept on a worker thread
#                                                (one detached thread per connection)
#
#   Fallibility: http_get_full returns a **present** HttpResponse -- on failure
#   `status` is -1 and `error` holds the reason (never a silent absent, never a
#   sentinel passed off as data). Network acquisition ops (`http_listen`/
#   `http_accept`) and the body conveniences keep the `T?` absent-on-failure
#   shape. Escalate via `match` and `fail http_error(op, target)`.
#
# Threading: `http_serve` runs the accept loop on a worker thread and serves
# each accepted connection on its own detached thread, so the server keeps
# accepting while connections are handled concurrently (via the `threads`
# module's `thread_spawn` / `thread_detach`). The sockets remain blocking, so
# an accept only returns once the kernel has queued a connect. `http_get`
# blocks until a *living* peer responds, so exercise it against an
# external/local server.

# Underlying socket plumbing comes from the `network` module, and per-connection
# worker threads from the `threads` module. http_listen returns `TcpListener?`
# and http_accept returns `TcpStream?` (T? absent-on-failure); http_get_full
# returns a present `HttpResponse` whose `error` carries the lossless reason on
# failure (see above). http_get returns `String?`. Escalate with
# `fail http_error(op, target)` into the fail/trap framework.
import network::{socket_open, socket_bind, socket_listen, socket_accept,
                  socket_connect, socket_recv, socket_send, socket_local_port,
                  socket_resolve, socket_close, Socket, TcpListener, TcpStream}
import threads::{thread_spawn, thread_detach}

# --- Server building blocks -------------------------------------------------

# Open + bind + listen on `port` (use 0 to let the kernel pick one). Returns a
# `TcpListener?` -- present on success, absent on failure.
share(all)
http_listen(port<Int>, backlog<Int>)<TcpListener?> -> {
    fd<Int> = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, Socket::IPPROTO_TCP) else -1
    if (fd < 0) { return TcpListener?() }
    if (!(socket_bind(fd, "0.0.0.0", port) else false) || !(socket_listen(fd, backlog) else false)) {
        socket_close(fd)
        return TcpListener?()
    }
    lp<Int> = socket_local_port(fd) else -1
    return TcpListener?(TcpListener { fd = fd, local_ip = "0.0.0.0", local_port = lp })
}

# The port a listening socket is bound to (read a 0 back after http_listen(0)).
share(all)
http_local_port(listener<TcpListener>)<Int> -> {
    return listener.local_port
}

# Accept one pending connection on `listener`. Returns the connected stream as a
# `TcpStream?` -- present on success, absent on failure.
share(all)
http_accept(listener<TcpListener>)<TcpStream?> -> {
    c<Int> = socket_accept(listener.fd) else -1
    if (c < 0) { return TcpStream?() }
    return TcpStream?(TcpStream { fd = c, peer_ip = "", peer_port = -1 })
}

# Read an HTTP head (everything up to and including the blank line) into a fresh
# String, stopping once "\r\n\r\n" is seen or `max` bytes are read.
share(all)
http_read_head(conn<Int>, max<Int>)<String> -> {
    buf<String> = ""
    marker<String> = "\r\n\r\n"
    while (buf.len() < max) {
        chunk<String> = socket_recv(conn, 256) else ""
        if (chunk.len() == 0) { break }
        buf = buf.concat(chunk)
        idx<Int> = buf.index_of(marker)
        if (idx >= 0) { return buf.substring(0, idx + 4) }
    }
    return buf
}

# The request target from a head line, e.g. "GET /a/b?x=1 HTTP/1.1" -> "/a/b?x=1".
# The method must be followed by a space; the path runs up to the next space.
share(all)
http_request_path(head<String>)<String> -> {
    sp<Int> = head.index_of(" ")
    if (sp < 0) { return "" }
    a<Int> = sp + 1
    rest<String> = head.substring(a)
    e<Int> = rest.index_of(" ")
    if (e < 0) { return rest }
    return rest.substring(0, e)
}

# Send the whole of `data` on `fd` (loops over partial sends); returns bytes sent.
share(all)
http_send_all(fd<Int>, data<String>)<Int> -> {
    total<Int> = 0
    n<Int> = data.len()
    while (total < n) {
        sent<Int> = socket_send(fd, data.substring(total)) else 0
        if (sent <= 0) { return total }
        total = total + sent
    }
    return total
}

# Close a socket or connection. Returns 0 on success, -1 on failure.
share(all)
http_close(fd<Int>)<Int> -> {
    ok<Bool> = socket_close(fd) else false
    if (ok) { return 0 }
    return -1
}

# A well-formed HTTP/1.1 text/plain response with a Content-Length. A handful of
# status codes get a reason phrase; anything else falls back to a generic one.
share(all)
http_response(status<Int>, body<String>)<String> -> {
    reason<String> = "OK"
    if (status == 404) { reason = "Not Found" }
    if (status == 500) { reason = "Internal Server Error" }
    tpl<String> = "HTTP/1.1 {} {}\r\nContent-Type: text/plain\r\nContent-Length: {}\r\nConnection: close\r\n\r\n"
    head<String> = tpl.format(status, reason, body.len())
    return head.concat(body)
}

# --- Client convenience -----------------------------------------------------

# Build a request head for `method` (e.g. "GET"), `path`, and `host`.
share(all)
http_request(method<String>, path<String>, host<String>)<String> -> {
    tpl<String> = "{} {} HTTP/1.0\r\nHost: {}\r\nConnection: close\r\n\r\n"
    return tpl.format(method, path, host)
}

# Read everything available on a connection until the peer closes (or `max`
# bytes). Used after the head to collect a response/request body.
share(all)
http_read_rest(conn<Int>, max<Int>)<String> -> {
    buf<String> = ""
    while (buf.len() < max) {
        chunk<String> = socket_recv(conn, 1024) else ""
        if (chunk.len() == 0) { break }
        buf = buf.concat(chunk)
    }
    return buf
}

# Serve one accepted connection on a fresh detached thread: read its head,
# extract the request path, and answer with a well-formed response before
# closing. Runs concurrently with the rest of the server.
share(all)
http_serve_conn(conn<TcpStream>)<Int> -> {
    h<Int> = thread_spawn(|| -> {
        head<String> = http_read_head(conn.fd, 65536)
        path<String> = http_request_path(head)
        pk<String> = http_response(200, "hi from vyb: " + path)
        http_send_all(conn.fd, pk)
        http_close(conn.fd)
        return 0
}) else -1
    if (h >= 0) { thread_detach(h) }
    return 0
}

# Start a threaded HTTP/1.1 server: bind+listen on `port` (0 = ephemeral; read
# it back via http_local_port), spawn a detached worker running the accept
# loop, and return the listener as a `TcpListener?` (absent on failure). Each
# connection is served concurrently on its own detached thread via
# http_serve_conn. The server stops once the listener is closed and the pending
# accept returns an absent `TcpStream?` (the accept worker then reaps itself);
# prefer closing when no connect is in flight.
share(all)
http_serve(port<Int>, backlog<Int>)<TcpListener?> -> {
    match (http_listen(port, backlog)) {
        ls -> {
            thr<Int> = thread_spawn(|| -> {
                while (true) {
                    match (http_accept(ls)) {
                        c -> { http_serve_conn(c) }
                        ? -> { return 0 }
                    }
                }
                return 0
}) else -1
            if (thr < 0) {
                http_close(ls.fd)
                return TcpListener?()
            }
            thread_detach(thr)
            return TcpListener?(ls)
        }
        ? -> { return TcpListener?() }
    }
}

# --- HTTP/1.1 client ---------------------------------------------------------
# A pure-Vyb client that sends an HTTP/1.1 request, parses the response status
# line + headers, and reads a `Content-Length` body (falling back to reading
# until the peer closes). No new FFI -- it reuses the socket helpers above, so
# it blocks only on the kernel exactly like the server side.

# A completed HTTP round-trip. On success `status` is the parsed code and
# `error` is absent. On failure the clients still return a **present** response
# with `status` -1 and `error` present holding a lossless reason string
# ("resolve failed", "connect ... failed", "tls ...", "bad response: no status
# line") -- so a failed round-trip is never a silent absent and never conflated
# with a valid response. `headers` holds the raw response header lines (minus the
# terminating blank line); `body` is the payload (Content-Length-sized, or
# everything read before the peer closed).
share(all)
struct HttpResponse {
    status<Int>,
    reason<String>,
    headers<Vec<String>>,
    body<String>,
    error<String?>
}

# A shared error value for escalating a failed HTTP op into the fail/trap
# framework. `op` names the failing call ("get", "listen", "accept", ...);
# `target` is the host:port (or port) intended; `message` is a fixed
# description (http is pure Vyb, so there is no low-level diagnostic to
# snapshot). Build with a literal or via `http_error()`.
share(all)
struct HttpError {
    op<String>,
    target<String>,
    message<String>
}

# Build an `HttpError` for a failed `op` targeting `target`. Typical use is
# escalating a failed full-client result into the fail/trap framework:
#   r<HttpResponse> = http_get_full(h, p, path)
#   match (r.error) { ? -> body(r), e -> { fail http_error("get", h) } }
share(all)
http_error(op<String>, target<String>)<HttpError> -> {
    return HttpError { op = op, target = target, message = "http " + op + " failed" }
}

# Build a failed-round-trip result for the full clients: still **present**, with
# `status` -1 and `error` carrying the lossless reason `msg`. Callers tell
# success from failure with `match (resp.error)` or `resp.status < 0`.
share(all)
http_err(msg<String>)<HttpResponse> -> {
    return HttpResponse { status = -1, reason = "", headers = Vec<String>(), body = "", error = String?(msg) }
}

# Index of the first occurrence of `needle` in `s`, or -1.
share(all)
http_index_of(s<String>, needle<String>)<Int> -> {
    n<Int> = s.len()
    m<Int> = needle.len()
    if (m == 0) { return 0 }
    i<Int> = 0
    while (i <= n - m) {
        j<Int> = 0
        ok<Bool> = true
        while (ok && j < m) {
            if (s.char_at(i + j) != needle.char_at(j)) { ok = false }
            j = j + 1
        }
        if (ok) { return i }
        i = i + 1
    }
    return -1
}

# Case-insensitive ASCII equality.
share(all)
http_key_eq(a<String>, b<String>)<Bool> -> {
    if (a.len() != b.len()) { return false }
    i<Int> = 0
    while (i < a.len()) {
        ca<Int> = a.char_at(i)
        cb<Int> = b.char_at(i)
        if (ca >= 65 && ca <= 90) { ca = ca + 32 }
        if (cb >= 65 && cb <= 90) { cb = cb + 32 }
        if (ca != cb) { return false }
        i = i + 1
    }
    return true
}

# Parse a decimal integer at the start of `s`, stopping at the first non-digit.
share(all)
http_parse_int(s<String>)<Int> -> {
    v<Int> = 0
    i<Int> = 0
    while (i < s.len()) {
        c<Int> = s.char_at(i)
        if (c < 48 || c > 57) { break }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

# Status code from a status line like "HTTP/1.1 200 OK" (-1 if unparseable).
share(all)
http_status_code(line<String>)<Int> -> {
    sp<Int> = http_index_of(line, " ")
    if (sp < 0) { return -1 }
    return http_parse_int(line.substring(sp + 1, line.len()))
}

# Given one header line, the trimmed value of `name` (case-insensitive), or ""
# if `header` isn't that header.
share(all)
http_header_value(header<String>, name<String>)<String> -> {
    c<Int> = http_index_of(header, ":")
    if (c < 0) { return "" }
    key<String> = header.substring(0, c).trim()
    if (!http_key_eq(key, name)) { return "" }
    return header.substring(c + 1, header.len()).trim()
}

# Read one CRLF-terminated line (without the CRLF) from `fd`. One byte is read
# per iteration and the CRLF is located with index_of, so the reader stops
# exactly at the line end without swallowing the header body.
share(all)
http_read_line(fd<Int>)<String> -> {
    buf<String> = ""
    crlf<String> = "\r\n"
    while (true) {
        chunk<String> = socket_recv(fd, 1) else ""
        if (chunk.len() == 0) { break }
        buf = buf.concat(chunk)
        idx<Int> = buf.index_of(crlf)
        if (idx >= 0) { return buf.substring(0, idx) }
    }
    return buf
}

# Read exactly `length` bytes from `fd`.
share(all)
http_read_exact(fd<Int>, length<Int>)<String> -> {
    buf<String> = ""
    while (buf.len() < length) {
        chunk<String> = socket_recv(fd, length - buf.len()) else ""
        if (chunk.len() == 0) { break }
        buf = buf.concat(chunk)
    }
    return buf
}

# Read until the peer closes (used when a response has no Content-Length).
share(all)
http_read_all(fd<Int>, max<Int>)<String> -> {
    buf<String> = ""
    while (buf.len() < max) {
        chunk<String> = socket_recv(fd, 1024) else ""
        if (chunk.len() == 0) { break }
        buf = buf.concat(chunk)
    }
    return buf
}

# Parse a hexadecimal integer at the start of `s`, stopping at a `;` extension
# marker or any non-hex digit ("" -> 0, like a 0-size chunk terminator).
share(all)
http_parse_hex(s<String>)<Int> -> {
    v<Int> = 0
    i<Int> = 0
    while (i < s.len()) {
        c<Int> = s.char_at(i)
        d<Int> = -1
        if (c >= 48 && c <= 57) { d = c - 48 }
        else if (c >= 97 && c <= 102) { d = c - 97 + 10 }
        else if (c >= 65 && c <= 70) { d = c - 65 + 10 }
        if (d < 0) { break }
        v = v * 16 + d
        i = i + 1
    }
    return v
}

# Read the body of a `Transfer-Encoding: chunked` response from `fd`, draining
# each hex chunk-size line, its data, and the trailing CRLF, until the 0-size
# terminator and any trailer. Skipping the framing means the renderer no longer
# sees stray hex sizes like "8000"/"464" as page text.
share(all)
http_read_chunked(fd<Int>)<String> -> {
    body<String> = ""
    while (true) {
        hdr<String> = http_read_line(fd)
        size<Int> = http_parse_hex(hdr)
        if (size <= 0 || hdr.len() == 0) {
            # 0-size chunk: drain any trailer lines up to the blank line.
            t<String> = http_read_line(fd)
            while (t.len() > 0) { t = http_read_line(fd) }
            break
        }
        body = body.concat(http_read_exact(fd, size))
        http_read_exact(fd, 2)
    }
    return body
}

# Resolved redirect target: scheme (http/https), host, port, and path. Port
# defaults are applied for a fresh authority (http=80, https=443).
share(all)
struct HttpTarget {
    scheme<String>,
    host<String>,
    port<Int>,
    path<String>
}

# Last index of `sub` in `s`, or -1 (index_of returns the first occurrence).
share(all)
http_rindex_of(s<String>, sub<String>)<Int> -> {
    m<Int> = sub.len()
    if (m == 0) { return -1 }
    n<Int> = s.len()
    i<Int> = n - m
    while (i >= 0) {
        j<Int> = 0
        ok<Bool> = true
        while (ok && j < m) {
            if (s.char_at(i + j) != sub.char_at(j)) { ok = false }
            j = j + 1
        }
        if (ok) { return i }
        i = i - 1
    }
    return -1
}

# Resolve a redirect `Location` value against the current request target. Handles
# absolute ("https://host:8443/a/b"), protocol-relative ("//host:port/x"),
# root-relative ("/x"), and same-directory relative ("x", "./x", "../x" resolved
# against the current path's directory). The returned `scheme` may differ from the
# input `scheme` -- the caller decides whether to follow (clients never cross
# schemes silently).
share(all)
http_resolve_location(loc0<String>, scheme<String>, host<String>, port<Int>, path<String>)<HttpTarget> -> {
    lv<String> = loc0.trim()
    os<String> = scheme
    oh<String> = host
    op<Int> = port
    b<String> = lv

    # Absolute ("scheme://host"): swap the scheme and continue on the authority.
    has_authority<Bool> = false
    sp<Int> = b.index_of("://")
    if (sp >= 0) {
        os = b.substring(0, sp)
        b = b.substring(sp + 3)
        has_authority = true
    } else if (b.index_of("//") == 0) {
        # Protocol-relative ("//host"): same scheme, new authority.
        b = b.substring(2)
        has_authority = true
    }

    if (has_authority) {
        si<Int> = b.index_of("/")
        auth<String> = b
        if (si >= 0) {
            auth = b.substring(0, si)
            b = b.substring(si)
        } else {
            b = "/"
        }
        co<Int> = auth.index_of(":")
        if (co >= 0) {
            oh = auth.substring(0, co)
            op = http_parse_int(auth.substring(co + 1))
        } else {
            oh = auth
            # Fresh authority without an explicit port: use the scheme default.
            if (os == "https") { op = 443 } else { op = 80 }
        }
        return HttpTarget { scheme = os, host = oh, port = op, path = b }
    }

    # Root-relative.
    if (b.index_of("/") == 0) {
        return HttpTarget { scheme = os, host = oh, port = op, path = b }
    }

    # Same-directory relative: strip "./" prefixes, resolve "../" against the
    # current path's directory (which always carries a trailing slash).
    while (b.index_of("./") == 0) { b = b.substring(2) }
    dir<String> = "/"
    lastSlash<Int> = http_rindex_of(path, "/")
    if (lastSlash >= 0) {
        dir = path.substring(0, lastSlash + 1)
        if (dir.len() == 0) { dir = "/" }
    }
    while (b.index_of("../") == 0) {
        b = b.substring(3)
        if (dir == "/") { continue }
        r1<Int> = http_rindex_of(dir, "/")
        first<String> = dir.substring(0, r1)
        r2<Int> = http_rindex_of(first, "/")
        if (r2 > 0) { dir = first.substring(0, r2 + 1) } else { dir = "/" }
    }
    return HttpTarget { scheme = os, host = oh, port = op, path = dir + b }
}

# Is `code` a GET-followable redirect status?
share(all)
http_is_redirect(code<Int>)<Bool> -> {
    if (code == 301 || code == 302 || code == 303 || code == 307 || code == 308) { return true }
    return false
}

# Look a header up by (case-insensitive) name across a parsed response's headers.
share(all)
http_header(resp<HttpResponse>, name<String>)<String> -> {
    i<Int> = 0
    while (i < resp.headers.len()) {
        v<String> = http_header_value(resp.headers.get(i), name)
        if (v.len() > 0) { return v }
        i = i + 1
    }
    return ""
}

# Expose the `Location` header of a response ("" when absent). The clients follow
# same-scheme redirects, but a cross-scheme Location (or one past the hop cap) is
# left here so a caller can resolve the chain itself.
share(all)
http_location(resp<HttpResponse>)<String> -> {
    return http_header(resp, "location")
}

# Hop budget for redirect following (#194). Bounded so a redirect loop terminates.
share(all)
http_redir_max()<Int> -> {
    return 10
}

# One GET round-trip with redirect following. `hops` is the number of redirects
# already taken. Only same-scheme redirects (scheme == "http"/"https") are
# followed; cross-scheme returns the 3xx response with its Location exposed.
share(all)
http_get_hops(host<String>, port<Int>, path<String>, hops<Int>, scheme<String>)<HttpResponse> -> {
    # Resolve the host to an IPv4 address first (exactly like the https client),
    # then connect by IP. The sockets are AF_INET only, and a bare hostname can
    # resolve to an IPv6 address first, which would make the connect fail - even
    # when the host serves IPv4 too. The hostname is kept for the Host header.
    connect_ip<String> = socket_resolve(host) else ""
    if (connect_ip.len() == 0) { return http_err("resolve failed: " + host) }
    fd<Int> = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, Socket::IPPROTO_TCP) else -1
    if (fd < 0) { return http_err("socket open failed") }
    if (!(socket_connect(fd, connect_ip, port) else false)) {
        socket_close(fd)
        return http_err("connect " + connect_ip + ":" + port.to_string() + " failed")
    }
    req<String> = "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n"
    socket_send(fd, req)
    line<String> = http_read_line(fd)
    code<Int> = http_status_code(line)
    if (code < 0) {
        socket_close(fd)
        return http_err("bad response: no status line")
    }
    hs<Vec<String>> = Vec<String>()
    length<Int> = -1
    has_len<Bool> = false
    chunked<Bool> = false
    h<String> = http_read_line(fd)
    while (h.len() > 0) {
        hs.push(h)
        lv<String> = http_header_value(h, "content-length")
        if (lv.len() > 0) {
            length = http_parse_int(lv)
            has_len = true
        }
        te<String> = http_header_value(h, "transfer-encoding")
        if (http_index_of(te.to_lower(), "chunked") >= 0) {
            chunked = true
        }
        h = http_read_line(fd)
    }
    body<String> = ""
    if (chunked) {
        body = http_read_chunked(fd)
    } else if (has_len) {
        body = http_read_exact(fd, length)
    } else {
        body = http_read_all(fd, 65536)
    }
    reason<String> = ""
    sp<Int> = http_index_of(line, " ")
    if (sp >= 0) {
        rest<String> = line.substring(sp + 1, line.len())
        sp2<Int> = http_index_of(rest, " ")
        if (sp2 >= 0) {
            reason = rest.substring(sp2 + 1, rest.len())
        }
    }
    socket_close(fd)
    resp<HttpResponse> = HttpResponse { status = code, reason = reason, headers = hs, body = body, error = String?() }

    # Follow a same-scheme redirect (bounded). A cross-scheme Location (http<->https)
    # is NOT followed silently -- the response is returned with its Location header
    # exposed so the caller can resolve it via the matching client (e.g. https).
    lv<String> = http_header(resp, "location")
    if (http_is_redirect(resp.status) && hops < http_redir_max() && lv.len() > 0) {
        tg<HttpTarget> = http_resolve_location(lv, scheme, host, port, path)
        if (tg.scheme == scheme) {
            return http_get_hops(tg.host, tg.port, tg.path, hops + 1, scheme)
        }
    }
    return resp
}

# Full HTTP/1.1 GET round-trip. Returns a present `HttpResponse`: on success
# `status` is the parsed code and `error` is absent; on failure `status` is -1
# and `error` carries a lossless reason ("resolve failed: <host>", "connect
# <ip>:<port> failed", "bad response: no status line").
#
# Redirects are followed automatically (bounded): a 301/302/303/307/308 with a
# `Location` header is re-fetched on the resolved target, up to http_redir_max()
# hops. Only same-scheme redirects are followed -- an http->https Location is left
# for the caller (this client has no TLS), and the response (with its Location
# header, see http_location) is returned as-is so the caller can resolve it via the
# https client. The hop budget prevents redirect loops from hanging the fetch.
share(all)
http_get_full(host<String>, port<Int>, path<String>)<HttpResponse> -> {
    return http_get_hops(host, port, path, 0, "http")
}

# Convenience full-GET returning just the response body as a `String?` (absent
# on a failed round-trip, so an empty body is still a present valid value). The
# whole response -- including the lossless failure reason -- is on `http_get_full`.
share(all)
http_get(host<String>, port<Int>, path<String>)<String?> -> {
    r<HttpResponse> = http_get_full(host, port, path)
    if (r.status < 0) { return String?() }
    return String?(r.body)
}
