# time - wall-clock and monotonic clocks plus sleep.
#
# Thin wrappers over the runtime's `__vyb_time_*` functions in
# `runtime/vyb_runtime.c` (POSIX `clock_gettime` / `nanosleep`). All values are
# plain `Int` (epoch nanoseconds/millis/seconds, monotonic ms), so the module is
# allocation/pointer-free.
#
# Usage:
#   import time::{time_epoch_secs, time_mono_millis, sleep_ms}
#   start = time_mono_millis()
#   sleep_ms(20)
#   elapsed = time_mono_millis() - start   // ~20 ms
#
# Epoch values are wall-clock based (useful for timestamps); the monotonic
# source (time_mono_millis) ignores system clock changes and is the right choice
# for measuring intervals / timeouts.

# Current Unix epoch as whole seconds (>= 0; -1 on clock error).
share(all)
time_epoch_secs()<Int> -> {
    return vyb_time_epoch_secs()
}

# Current Unix epoch as milliseconds since 1970-01-01.
share(all)
time_epoch_millis()<Int> -> {
    return vyb_time_epoch_millis()
}

# Current Unix epoch as nanoseconds since 1970-01-01.
share(all)
time_nanos()<Int> -> {
    return vyb_time_nanos()
}

# Monotonic wall time in milliseconds — the stable source for measuring elapsed
# time, unaffected by NTP/system clock adjustments.
share(all)
time_mono_millis()<Int> -> {
    return vyb_time_mono_millis()
}

# Sleep for `millis` milliseconds (thread sleeps; returns 0). A non-positive
# value sleeps ~0 ms.
share(all)
sleep_ms(millis<Int>)<Int> -> {
    return vyb_time_sleep_ms(millis)
}
