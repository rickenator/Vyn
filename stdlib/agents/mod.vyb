# agents - lightweight isolated message-passing units.
#
# An agent is a unit of concurrency that owns a mailbox (an unbounded Int
# channel) and runs a behavior loop on its own worker thread: it blocks on recv
# and hands each message to the behavior closure. Only messages cross the
# boundary -- the agent's internal state stays private to its behavior. The
# handle is an Int (a runtime table index).
#
# Usage:
#   import agents
#
#   counter = agent_start(|v<Int>| -> {
#       println("got " + v.to_string())
#   })
#
#   ok = agent_send(counter, 42)   // 1
#   agent_send(counter, 43)
#   agent_close(counter)           // drain then stop (lossless)
#   agent_free(counter)            // wait for the worker and reclaim
#
# A behavior loop exits once the mailbox is closed and drained, so shutdown is
# cooperative and loses no buffered messages. agent_free closes the mailbox if
# it was never closed, then waits for the worker before reclaiming.

# `agent_start` / `agent_start_bool` / `agent_start_float` / `agent_start_string`
# are compiler-native: the behavior closure's failable flag is unpacked there, so
# a behavior that `fail`s is captured (Stage 4) rather than dropped. They return
# a handle (>= 1) or 0 on failure (table full / worker create failed).

# Post a message (non-blocking). Returns 1 on accepted, or 0 if the agent is
# stopped/closed or its bounded mailbox is full.
share(all)
agent_send(a<Int>, v<Int>)<Int> -> {
    return vyb_agent_send(a, v)
}

# Number of buffered-but-unhandled messages (-1 on a bad handle).
share(all)
agent_len(a<Int>)<Int> -> {
    return vyb_agent_len(a)
}

# 1 while the agent's worker is running (or draining), 0 once it has exited.
share(all)
agent_alive(a<Int>)<Int> -> {
    return vyb_agent_alive(a)
}

# Gracefully stop: close the mailbox; the agent drains buffered messages then
# stops. Returns 1, or -1 on a bad handle.
share(all)
agent_close(a<Int>)<Int> -> {
    return vyb_agent_close(a)
}

# Reclaim an agent: waits for the worker to exit (closing first if needed), then
# frees the mailbox and slot. Returns 0, or -1 on a bad handle.
share(all)
agent_free(a<Int>)<Int> -> {
    return vyb_agent_free(a)
}

# --- Payload breadth (Stage 2) ----------------------------------------------
# Agent payloads can be Bool, Float, or String in addition to Int. Bool and
# Float share the agent's int-slot mailbox (the value rides in the i64 slot);
# String agents use a refcounted strchan mailbox, so every buffered String stays
# alive and is handed to the behavior as an owned transfer. The lifecycle
# functions (len/close/free/alive) are payload-agnostic.

# Post a Bool message (non-blocking). 1 on accepted, 0 if stopped/full.
share(all)
agent_send_bool(a<Int>, b<Bool>)<Int> -> {
    return vyb_agent_send_bool(a, b)
}

# Post a Float message (non-blocking). 1 on accepted, 0 if stopped/full.
share(all)
agent_send_float(a<Int>, f<Float>)<Int> -> {
    return vyb_agent_send_float(a, f)
}

# Post a String message (non-blocking). 1 on accepted, 0 if stopped/full. The
# message buffer is retained until the behavior receives it.
share(all)
agent_send_string(a<Int>, s<String>)<Int> -> {
    return vyb_agent_send_string(a, s)
}

# --- Request/response + composition (Stage 3) --------------------------------

# Expose the agent's underlying mailbox channel handle (scalar agents only).
# Int/Bool/Float agents ride an int-slot channel, so the returned handle can be
# passed to chan_select (alongside reply channels) to compose agents into
# fan-in/fan-out and watch multiple agents' readiness from one place. String
# agents use a separate mailbox type and return -1 here. The handle aliases the
# agent's mailbox: it is freed by agent_free and must not be closed/freed by the
# caller; treat it as read-only (select/len observation), not a side channel for
# consuming messages (that is the behavior's own recv loop).
share(all)
agent_mailbox(a<Int>)<Int> -> {
    return vyb_agent_mailbox(a)
}

# --- Failure channeling (Stage 4) --------------------------------------------
# A behavior may `fail<T>(...)`. Because the compiler compiles such a behavior
# with the failable return ABI, the runtime captures the propagated VybError
# instead of dropping it: it stops the agent (the mailbox is closed, so senders
# see 0), records the failure, and optionally notifies a dead-letter channel.

# Agent state: 0 running/draining, 1 stopped (normal), 2 failed. -1 on a bad
# handle.
share(all)
agent_status(a<Int>)<Int> -> {
    return vyb_agent_status(a)
}

# The `fail<Int>(n)` payload when an Int-typed failure was captured, else -1.
share(all)
agent_error_code(a<Int>)<Int> -> {
    return vyb_agent_error_code(a)
}

# A human-readable descriptor of the captured failure ("kind @ file:line"), or
# "" when the agent hasn't failed.
share(all)
agent_error(a<Int>)<String> -> {
    return vyb_agent_error(a)
}

# Register an int-slot reply channel as a dead-letter: on failure the runtime
# sends the agent's own handle into `ch` so a supervisor can react, then query
# agent_status / agent_error for details. Returns 1, or -1 on a bad handle.
share(all)
agent_dead_letter(a<Int>, ch<Int>)<Int> -> {
    return vyb_agent_set_dead_letter(a, ch)
}
