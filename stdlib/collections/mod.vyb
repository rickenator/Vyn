# collections - collection module surface.
#
# The built-in `Vec<T>` (constructed with the vybish `Vec()` / `Vec(n)` calls)
# already ships `push`, `pop`, `len`, `get`, `get_vec`, `clear`, `is_empty`,
# `contains`, `remove_at`, and the array conversion helpers. This module layers
# the first real keyed/set collections on top of `Vec` and the canonical
# `Hashable` / `Equatable` core aspects:
#
#   - `HashMap<K, V>`: a keyed map. Keys and values live in parallel
#     `keys` / `vals` vectors; a fixed set of hash buckets (`head` + a per-key
#     `next` chain) indexes the keys so a lookup only scans the single bucket
#     the key hashes to instead of the whole map. Provides `put`, `get`
#     (returning `Option<V>`), `contains_key` and `size`. Build one with
#     `make_hash_map<K, V>()` (16 buckets).
#   - `HashSet<K>`: a set of distinct keys backed by a `values` vector plus the
#     same bucket/chain index. Provides `insert` (returns `Bool`), `contains`
#     and `size`. Build one with `make_hash_set<K>()`.
#   - `make_hash_map<K,V>()` / `make_hash_set<K>()`: the constructors return a
#     fully initialized (bucket-indexed) instance. They are the supported way to
#     build these collections because the bucket metadata must be set up.
#
# Import the whole module with `import collections` (the carried generic bind
# methods reference the shared `samekey` / `hashkey` probes and `bucket_for`, so
# a narrow named import of just `HashMap`/`MapOps` would drop those dependencies
# and the binds would not resolve). Drain `get` results with `match` / `select`
# on the `Option<V>`, or read the primary payload directly with `.value`
# (returns a default when the key is absent).

import core::aspects

# Equality probe for bounded key types. The `equals` method is resolved via the
# `Equatable` bound on a declared type parameter, which is the reliable path for
# unqualified aspect dispatch inside generic bind bodies.
share(all)
samekey<K<Equatable>>(a<K>, b<K>)<Bool> -> {
    return a.equals(b)
}

# Hash probe for bounded key types, mirroring `samekey`: `hash` resolves through
# the `Hashable` bound so generic bind bodies can bucket keys without a concrete
# receiver.
share(all)
hashkey<K<Hashable>>(k<K>)<Int> -> {
    return k.hash()
}

# Map an arbitrary (possibly negative) hash onto a bucket index in [0, nb).
share(all)
bucket_for(h<Int>, nb<Int>)<Int> -> {
    b<Int> = h % nb
    if (b < 0) {
        b = b + nb
    }
    return b
}

share(all)
struct HashMap<K, V> {
    keys<Vec<K>>,
    vals<Vec<V>>,
    head<Vec<Int>>,
    next<Vec<Int>>
}

share(all)
aspect MapOps {
    put(self<their<HashMap<K, V>>>, key<K>, val<V>)<Void>
    get(self<their<HashMap<K, V>>>, key<K>)<Option<V>>
    contains_key(self<their<HashMap<K, V>>>, key<K>)<Bool>
    size(self<their<HashMap<K, V>>>)<Int>
}

share(all)
bind<K<Hashable, Equatable>, V> MapOps -> HashMap<K, V> {
    put(self<their<HashMap<K, V>>>, key<K>, val<V>)<Void> -> {
        nb<Int> = self.head.len()
        b<Int> = bucket_for(hashkey(key), nb)
        i<Int> = self.head.get(b)
        while (i != -1) {
            if (samekey(self.keys.get(i), key)) {
                self.vals.set(i, val)
                return
            }
            i = self.next.get(i)
        }
        self.keys.push(key)
        self.vals.push(val)
        idx<Int> = self.keys.len() - 1
        self.next.push(self.head.get(b))
        self.head.set(b, idx)
        return
    }
    get(self<their<HashMap<K, V>>>, key<K>)<Option<V>> -> {
        nb<Int> = self.head.len()
        b<Int> = bucket_for(hashkey(key), nb)
        i<Int> = self.head.get(b)
        while (i != -1) {
            if (samekey(self.keys.get(i), key)) {
                return Option<V>::Some(self.vals.get(i))
            }
            i = self.next.get(i)
        }
        return Option<V>::None
    }
    contains_key(self<their<HashMap<K, V>>>, key<K>)<Bool> -> {
        nb<Int> = self.head.len()
        b<Int> = bucket_for(hashkey(key), nb)
        i<Int> = self.head.get(b)
        while (i != -1) {
            if (samekey(self.keys.get(i), key)) {
                return true
            }
            i = self.next.get(i)
        }
        return false
    }
    size(self<their<HashMap<K, V>>>)<Int> -> {
        return self.keys.len()
    }
}

# Number of buckets each collection is pre-sized with. A power of two (16) keeps
# the modulo cheap; loads above a few elements per bucket can be reindexed by
# growing `head` in a future iteration.
share(all)
bucket_count()<Int> -> {
    return 16
}

share(all)
make_hash_map<K, V>()<HashMap<K, V>> -> {
    head<Vec<Int>> = Vec<Int>()
    i<Int> = 0
    nb<Int> = bucket_count()
    while (i < nb) {
        head.push(-1)
        i = i + 1
    }
    return HashMap<K, V> { keys = Vec<K>(), vals = Vec<V>(), head = head, next = Vec<Int>() }
}

share(all)
struct HashSet<K> {
    values<Vec<K>>,
    head<Vec<Int>>,
    next<Vec<Int>>
}

share(all)
aspect SetOps {
    insert(self<their<HashSet<K>>>, value<K>)<Bool>
    contains(self<their<HashSet<K>>>, value<K>)<Bool>
    size(self<their<HashSet<K>>>)<Int>
}

share(all)
bind<K<Hashable, Equatable>> SetOps -> HashSet<K> {
    insert(self<their<HashSet<K>>>, value<K>)<Bool> -> {
        nb<Int> = self.head.len()
        b<Int> = bucket_for(hashkey(value), nb)
        i<Int> = self.head.get(b)
        while (i != -1) {
            if (samekey(self.values.get(i), value)) {
                return false
            }
            i = self.next.get(i)
        }
        self.values.push(value)
        idx<Int> = self.values.len() - 1
        self.next.push(self.head.get(b))
        self.head.set(b, idx)
        return true
    }
    contains(self<their<HashSet<K>>>, value<K>)<Bool> -> {
        nb<Int> = self.head.len()
        b<Int> = bucket_for(hashkey(value), nb)
        i<Int> = self.head.get(b)
        while (i != -1) {
            if (samekey(self.values.get(i), value)) {
                return true
            }
            i = self.next.get(i)
        }
        return false
    }
    size(self<their<HashSet<K>>>)<Int> -> {
        return self.values.len()
    }
}

share(all)
make_hash_set<K>()<HashSet<K>> -> {
    head<Vec<Int>> = Vec<Int>()
    i<Int> = 0
    nb<Int> = bucket_count()
    while (i < nb) {
        head.push(-1)
        i = i + 1
    }
    return HashSet<K> { values = Vec<K>(), head = head, next = Vec<Int>() }
}

share(all)
collections_status_message()<String> -> {
    return "collections: HashMap / HashSet with hash-bucket (chained) key lookup"
}
