# collections - collection module surface.
#
# The built-in `Vec<T>` (constructed with the vybish `Vec()` / `Vec(n)` calls)
# already ships `push`, `pop`, `len`, `get`, `get_vec`, `clear`, `is_empty`,
# `contains`, `remove_at`, and the array conversion helpers. This module layers
# the first real keyed/set collections on top of `Vec` and the canonical
# `Hashable` / `Equatable` core aspects:
#
#   - `HashMap<K, V>`: a keyed map. Keys and values live in parallel
#     `keys` / `vals` vectors; a set of hash buckets (`head` + a per-key `next`
#     chain) indexes the keys so a lookup only scans the single bucket the key
#     hashes to instead of the whole map. Buckets start at 16 and double (with a
#     full re-hash) once the load exceeds 2 keys per bucket, keeping average
#     lookup O(1). Provides `put` (returns `Bool`: false only when a fixed map
#     is at capacity and the key is new), `get` (returning the native `V?` optional,
#     consumed with `m.get(k) else default`),
#     `contains_key` and `size`. Build one with `HashMap<K, V>()` (empty),
#     `HashMap<K, V>(cap)` (pre-sized, still auto-grows), or
#     `HashMap<K, V>(cap, true)` (fixed at `cap` entries, no re-hash, bounded
#     memory for embedded targets).
#
#   - `HashSet<K>`: a set of distinct keys backed by a `values` vector plus the
#     same auto-growing bucket/chain index. Provides `insert` (returns `Bool`),
#     `contains` and `size`. Build one with `HashSet<K>()`, `HashSet<K>(cap)`,
#     or the fixed `HashSet<K>(cap, true)`.
#
#   - `OrderedMap<K, V>`: an ordered map keyed by `Comparable`. Keys live in a
#     `keys` vector kept sorted ascending (with a parallel `vals` vector), so
#     iteration walks entries in key order and `get` / `contains_key` binary
#     search (O(log n)); `put` inserts at the sorted position (O(n) shift).
#     Keyed methods (`put` / `get` / `contains_key` / `size` / `iter`) are bound
#     as `OrderedMapOps`. Build one with `OrderedMap<K, V>()`.
#
#   - `VecOps` (on the built-in `Vec<T>`): non-mutating view helpers written in
#     Vyb over the Vec primitives — `first` / `last` (head/tail element),
#     `reversed` (a fresh reversed copy) and `find` (first matching index as
#     `Int?`, absent when not found), and the ordering helpers `sorted` (fresh ascending copy),
#     `min` / `max`. Bound via `Comparable` (which refines `Equatable`).
#
#   - `VecHigherOps` (also on the built-in `Vec<T>`): the higher-order
#     combinators `map(f)` (element-wise transform to a fresh vector),
#     `filter(f)` (keep only `true` results in a fresh vector) and
#     `reduce(init, f)` (left fold). They take a *non-capturing* lambda
#     (`fn`) argument and are bound without any `Comparable` / `Equatable`
#     requirement, so they work on any element type. The in-place companions
#     `map_in_place(f)`, `retain(f)` and `reverse_in_place()` rewrite / compact
#     / reverse the receiver through a by-ref `their<Vec<T>>` borrow; VecOps
#     also provides `sort_in_place()` (Comparable-gated).
#
#   - `HashMap<K,V>()` / `HashSet<K>()` (and their `(cap)` / `(cap, true)`
#     capacity forms) are declared struct constructors: they return a fully initialized
#     (bucket-indexed) instance, keeping the `Vec()` / `Vec(n)` construction
#     idiom consistent across the standard library.
#
# Import the whole module with `import collections` (the carried generic bind
# methods reference the shared `samekey` / `hashkey` probes and `bucket_for`, so
# a narrow named import of just `HashMap`/`MapOps` would drop those dependencies
# and the binds would not resolve). `get` returns the native `V?` optional:
# `m.get(key) else default` yields the payload when the key is present, or the
# `default` when it is absent (no `Option`/`Some`/`None` ceremony).

import core::aspects
share(all) import core::iter::{Iterator}

# VecIter<T> - a cursor-based iterator over a `Vec<T>`. Holds the Vec by
# reference (a `their<Vec<T>>` view) and a next index, implementing `core::iter`:
# `next(self)<Item?>` yields the native optional: present (a bare value) per
# element and absent when done,
# advancing the cursor in place through the by-ref receiver. Build one with
# `v.iter()` (from `VecHigherOps`) or construct it directly. Consume with an
# explicit `.next()` / `match` loop until the `for`-loop desugar ships.
share(all)
struct VecIter<T> {
    data<their<Vec<T>>>,
    index<Int>
}

share(all)
bind<T> Iterator -> VecIter<T> {
    type Item = T
    next(self<their<VecIter<T>>>)<T?> -> {
        if (self.index < self.data.len()) {
            v<T> = self.data.get(self.index)
            self.index = self.index + 1
            return T?(v)
        }
        return T?()
    }

    # Iterators are themselves iterable: `it.iter()` yields a fresh iterator over
    # the same underlying slice so a stored iterator value can drive `for`.
    iter(self<their<VecIter<T>>>)<VecIter<T>> -> {
        return VecIter<T> { data = self.data, index = self.index }
    }
}

# Equality probe for bounded key types. The `equals` method is resolved via the
# `Equatable` bound on a declared type parameter, which is the reliable path for
# unqualified aspect dispatch inside generic bind bodies.
share(all)
samekey<K<Equatable>>(a<K>, b<K>)<Bool> -> {
    return a.equals(b)
}

# Hash probe for bounded key types, mirroring `samekey`: `hash` resolves through
# the `Hashable` bound so generic bind bodies can bucket keys without a concrete
# receiver.
share(all)
hashkey<K<Hashable>>(k<K>)<Int> -> {
    return k.hash()
}

# Map an arbitrary (possibly negative) hash onto a bucket index in [0, nb).
share(all)
cmp_lt<T<Comparable>>(a<T>, b<T>)<Bool> -> {
    return a.compare(b) < 0
}

share(all)
bucket_for(h<Int>, nb<Int>)<Int> -> {
    b<Int> = h % nb
    if (b < 0) {
        b = b + nb
    }
    return b
}

share(all)
struct HashMap<K, V> {
    keys<Vec<K>>,
    vals<Vec<V>>,
    head<Vec<Int>>,
    next<Vec<Int>>,
    cap<Int>,
    fixed<Bool>

    # Empty map starting at the default bucket count.
    constructor() {
        m<HashMap<K, V>> = HashMap<K, V>(0)
        return m
    }

    # Map pre-sized for `cap` entries but still auto-grows: bucket count stays a
    # power of two (at least 16) so the load factor is <= 2, meaning no re-hash
    # is needed until `cap` keys are inserted. Trade upfront memory to skip the
    # early grow/re-hash resize storms when the size is known.
    constructor(cap<Int>) {
        return HashMap<K, V>(cap, false)
    }

    # Fixed-capacity map: holds at most `cap` entries with provably bounded
    # memory (never re-hashes or reallocs once built). `put` returns `false`
    # when the map is at capacity and the key is new; updating an existing key
    # still succeeds (`true`) even at capacity.
    constructor(cap<Int>, fixed<Bool>) {
        nb<Int> = 16
        two<Int> = 32
        while (two < cap) {
            nb = nb * 2
            two = two * 2
        }
        head<Vec<Int>> = Vec<Int>()
        i<Int> = 0
        while (i < nb) {
            head.push(-1)
            i = i + 1
        }
        return HashMap<K, V> { keys = Vec<K>(), vals = Vec<V>(), head = head, next = Vec<Int>(), cap = cap, fixed = fixed }
    }
}

# MapIter<K, V> - cursor iterator over a `HashMap<K, V>`, bound to
# `core::iter::Iterator`. Holds the map by reference (a `their<HashMap<K, V>>`
# view) and a next index; `next` yields the native `MapEntry<K, V>?` -- present
# (a bare entry) per slot in insertion order / absent when done. Each entry
# carries the pair's `key` and `value`.
share(all)
struct MapEntry<K, V> {
    key<K>,
    value<V>
}

share(all)
struct MapIter<K, V> {
    map<their<HashMap<K, V>>>,
    index<Int>
}

share(all)
bind<K<Hashable, Equatable>, V> Iterator -> MapIter<K, V> {
    type Item = MapEntry<K, V>
    next(self<their<MapIter<K, V>>>)<MapEntry<K, V>?> -> {
        if (self.index < self.map.keys.len()) {
            e<MapEntry<K, V>> = MapEntry<K, V> { key = self.map.keys.get(self.index), value = self.map.vals.get(self.index) }
            self.index = self.index + 1
            return MapEntry<K, V>?(e)
        }
        return MapEntry<K, V>?()
    }

    # Iterators are themselves iterable over the same underlying map.
    iter(self<their<MapIter<K, V>>>)<MapIter<K, V>> -> {
        return MapIter<K, V> { map = self.map, index = self.index }
    }
}

share(all)
aspect MapOps {
    put(self<their<HashMap<K, V>>>, key<K>, val<V>)<Bool>
    get(self<their<HashMap<K, V>>>, key<K>)<V?>
    contains_key(self<their<HashMap<K, V>>>, key<K>)<Bool>
    size(self<their<HashMap<K, V>>>)<Int>
    iter(self<their<HashMap<K, V>>>)<MapIter<K, V>>
}

share(all)
bind<K<Hashable, Equatable>, V> MapOps -> HashMap<K, V> {
    put(self<their<HashMap<K, V>>>, key<K>, val<V>)<Bool> -> {
        nb<Int> = self.head.len()
        b<Int> = bucket_for(hashkey(key), nb)
        i<Int> = self.head.get(b)
        while (i != -1) {
            if (samekey(self.keys.get(i), key)) {
                self.vals.set(i, val)
                return true
            }
            i = self.next.get(i)
        }
        # Fixed maps never auto-grow: refuse a new key at full capacity.
        if (self.fixed && self.keys.len() >= self.cap) {
            return false
        }
        self.keys.push(key)
        self.vals.push(val)
        idx<Int> = self.keys.len() - 1
        self.next.push(self.head.get(b))
        self.head.set(b, idx)
        # Grow and re-hash once each bucket holds more than ~2 keys on average,
        # doubling the bucket count. Chains are rebuilt from the full key list.
        if (!self.fixed && self.keys.len() > self.head.len() * 2) {
            new_nb<Int> = self.head.len() * 2
            grow<Int> = self.head.len()
            while (grow < new_nb) {
                self.head.push(-1)
                grow = grow + 1
            }
            clear<Int> = 0
            while (clear < new_nb) {
                self.head.set(clear, -1)
                clear = clear + 1
            }
            nk<Int> = self.keys.len()
            clr<Int> = 0
            while (clr < nk) {
                self.next.set(clr, -1)
                clr = clr + 1
            }
            reb<Int> = 0
            while (reb < nk) {
                bb<Int> = bucket_for(hashkey(self.keys.get(reb)), new_nb)
                self.next.set(reb, self.head.get(bb))
                self.head.set(bb, reb)
                reb = reb + 1
            }
        }
        return true
    }
    get(self<their<HashMap<K, V>>>, key<K>)<V?> -> {
        nb<Int> = self.head.len()
        b<Int> = bucket_for(hashkey(key), nb)
        i<Int> = self.head.get(b)
        while (i != -1) {
            if (samekey(self.keys.get(i), key)) {
                return V?(self.vals.get(i))
            }
            i = self.next.get(i)
        }
        return V?()
    }
    contains_key(self<their<HashMap<K, V>>>, key<K>)<Bool> -> {
        nb<Int> = self.head.len()
        b<Int> = bucket_for(hashkey(key), nb)
        i<Int> = self.head.get(b)
        while (i != -1) {
            if (samekey(self.keys.get(i), key)) {
                return true
            }
            i = self.next.get(i)
        }
        return false
    }
    size(self<their<HashMap<K, V>>>)<Int> -> {
        return self.keys.len()
    }
    iter(self<their<HashMap<K, V>>>)<MapIter<K, V>> -> {
        return MapIter<K, V> { map = self, index = 0 }
    }
}

share(all)
struct HashSet<K> {
    values<Vec<K>>,
    head<Vec<Int>>,
    next<Vec<Int>>,
    cap<Int>,
    fixed<Bool>

    # Empty set starting at the default bucket count.
    constructor() {
        s<HashSet<K>> = HashSet<K>(0)
        return s
    }

    # Set pre-sized for `cap` entries (see HashMap's constructor semantics).
    constructor(cap<Int>) {
        return HashSet<K>(cap, false)
    }

    # Fixed-capacity set: at most `cap` distinct values, never re-hashes or
    # reallocs once built. `insert` returns `false` when the set is full and the
    # value is new (or on a duplicate).
    constructor(cap<Int>, fixed<Bool>) {
        nb<Int> = 16
        two<Int> = 32
        while (two < cap) {
            nb = nb * 2
            two = two * 2
        }
        head<Vec<Int>> = Vec<Int>()
        i<Int> = 0
        while (i < nb) {
            head.push(-1)
            i = i + 1
        }
        return HashSet<K> { values = Vec<K>(), head = head, next = Vec<Int>(), cap = cap, fixed = fixed }
    }
}

# HashIter<K> - cursor iterator over a `HashSet<K>`, bound to
# `core::iter::Iterator`. Holds the set by reference and a next index; `next`
# yields the native `K?` -- present (a bare value) per element / absent.
share(all)
struct HashIter<K> {
    set<their<HashSet<K>>>,
    index<Int>
}

share(all)
bind<K<Hashable, Equatable>> Iterator -> HashIter<K> {
    type Item = K
    next(self<their<HashIter<K>>>)<K?> -> {
        if (self.index < self.set.values.len()) {
            v<K> = self.set.values.get(self.index)
            self.index = self.index + 1
            return K?(v)
        }
        return K?()
    }

    # Iterators are themselves iterable over the same underlying set.
    iter(self<their<HashIter<K>>>)<HashIter<K>> -> {
        return HashIter<K> { set = self.set, index = self.index }
    }
}

share(all)
aspect SetOps {
    insert(self<their<HashSet<K>>>, value<K>)<Bool>
    contains(self<their<HashSet<K>>>, value<K>)<Bool>
    size(self<their<HashSet<K>>>)<Int>
    iter(self<their<HashSet<K>>>)<HashIter<K>>
}

share(all)
bind<K<Hashable, Equatable>> SetOps -> HashSet<K> {
    insert(self<their<HashSet<K>>>, value<K>)<Bool> -> {
        nb<Int> = self.head.len()
        b<Int> = bucket_for(hashkey(value), nb)
        i<Int> = self.head.get(b)
        while (i != -1) {
            if (samekey(self.values.get(i), value)) {
                return false
            }
            i = self.next.get(i)
        }
        # Fixed sets never auto-grow: refuse a new value at full capacity.
        if (self.fixed && self.values.len() >= self.cap) {
            return false
        }
        self.values.push(value)
        idx<Int> = self.values.len() - 1
        self.next.push(self.head.get(b))
        self.head.set(b, idx)
        if (!self.fixed && self.values.len() > self.head.len() * 2) {
            new_nb<Int> = self.head.len() * 2
            grow<Int> = self.head.len()
            while (grow < new_nb) {
                self.head.push(-1)
                grow = grow + 1
            }
            clear<Int> = 0
            while (clear < new_nb) {
                self.head.set(clear, -1)
                clear = clear + 1
            }
            nk<Int> = self.values.len()
            clr<Int> = 0
            while (clr < nk) {
                self.next.set(clr, -1)
                clr = clr + 1
            }
            reb<Int> = 0
            while (reb < nk) {
                bb<Int> = bucket_for(hashkey(self.values.get(reb)), new_nb)
                self.next.set(reb, self.head.get(bb))
                self.head.set(bb, reb)
                reb = reb + 1
            }
        }
        return true
    }
    contains(self<their<HashSet<K>>>, value<K>)<Bool> -> {
        nb<Int> = self.head.len()
        b<Int> = bucket_for(hashkey(value), nb)
        i<Int> = self.head.get(b)
        while (i != -1) {
            if (samekey(self.values.get(i), value)) {
                return true
            }
            i = self.next.get(i)
        }
        return false
    }
    size(self<their<HashSet<K>>>)<Int> -> {
        return self.values.len()
    }
    iter(self<their<HashSet<K>>>)<HashIter<K>> -> {
        return HashIter<K> { set = self, index = 0 }
    }
}

# OrderedMap<K, V> - an ordered map keyed by `Comparable`, bound to `OrderedMapOps`.
# Keys are held in a `keys` vector that is kept sorted ascending (with a
# parallel `vals` vector of the same indices), so `iter()` walks the entries in
# ascending key order and `get` / `contains_key` binary search (O(log n));
# `put` inserts at the sorted position (O(n) shift). Ordering goes through the
# `Comparable`-bounded `cmp_lt` helper (mirroring `samekey` for equality), which
# works for any keys that bind `Comparable` (Int, Float, Bool, String, ...).
# Build one with `OrderedMap<K, V>()`. `MapEntry<K, V>` (reused from `HashMap`) is
# the iterator item, so `for (kv in bt.iter())` reads `kv.key` / `kv.value`.
share(all)
struct OrderedMap<K, V> {
    keys<Vec<K>>,
    vals<Vec<V>>

    # Empty ordered map.
    constructor() {
        return OrderedMap<K, V> { keys = Vec<K>(), vals = Vec<V>() }
    }
}

share(all)
struct OrderedMapIter<K, V> {
    map<their<OrderedMap<K, V>>>,
    index<Int>
}

share(all)
bind<K<Comparable, Equatable>, V> Iterator -> OrderedMapIter<K, V> {
    type Item = MapEntry<K, V>
    next(self<their<OrderedMapIter<K, V>>>)<MapEntry<K, V>?> -> {
        if (self.index < self.map.keys.len()) {
            e<MapEntry<K, V>> = MapEntry<K, V> { key = self.map.keys.get(self.index), value = self.map.vals.get(self.index) }
            self.index = self.index + 1
            return MapEntry<K, V>?(e)
        }
        return MapEntry<K, V>?()
    }

    # Iterators are themselves iterable over the same underlying map.
    iter(self<their<OrderedMapIter<K, V>>>)<OrderedMapIter<K, V>> -> {
        return OrderedMapIter<K, V> { map = self.map, index = self.index }
    }
}

share(all)
aspect OrderedMapOps {
    put(self<their<OrderedMap<K, V>>>, key<K>, val<V>)<Bool>
    get(self<their<OrderedMap<K, V>>>, key<K>)<V?>
    contains_key(self<their<OrderedMap<K, V>>>, key<K>)<Bool>
    size(self<their<OrderedMap<K, V>>>)<Int>
    iter(self<their<OrderedMap<K, V>>>)<OrderedMapIter<K, V>>
}

share(all)
bind<K<Comparable, Equatable>, V> OrderedMapOps -> OrderedMap<K, V> {
    put(self<their<OrderedMap<K, V>>>, key<K>, val<V>)<Bool> -> {
        # Binary search for the insertion point: keys[lo] is the first key >= `key`.
        lo<Int> = 0
        hi<Int> = self.keys.len()
        while (lo < hi) {
            mid<Int> = lo + (hi - lo) / 2
            if (cmp_lt(self.keys.get(mid), key)) {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        # If the key already exists (keys[lo] == key), update its value in place.
        if (lo < self.keys.len()) {
            if (!cmp_lt(key, self.keys.get(lo))) {
                self.vals.set(lo, val)
                return true
            }
        }
        # Insert the new key/value pair at the sorted position `lo`, bubbling the
        # tail pair down so the vectors stay sorted ascending.
        self.keys.push(key)
        self.vals.push(val)
        p<Int> = self.keys.len() - 1
        while (p > lo) {
            ktmp<K> = self.keys.get(p)
            self.keys.set(p, self.keys.get(p - 1))
            self.keys.set(p - 1, ktmp)
            vtmp<V> = self.vals.get(p)
            self.vals.set(p, self.vals.get(p - 1))
            self.vals.set(p - 1, vtmp)
            p = p - 1
        }
        return true
    }
    get(self<their<OrderedMap<K, V>>>, key<K>)<V?> -> {
        lo<Int> = 0
        hi<Int> = self.keys.len()
        while (lo < hi) {
            mid<Int> = lo + (hi - lo) / 2
            if (cmp_lt(self.keys.get(mid), key)) {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        if (lo < self.keys.len()) {
            if (!cmp_lt(key, self.keys.get(lo))) {
                return V?(self.vals.get(lo))
            }
        }
        return V?()
    }
    contains_key(self<their<OrderedMap<K, V>>>, key<K>)<Bool> -> {
        lo<Int> = 0
        hi<Int> = self.keys.len()
        while (lo < hi) {
            mid<Int> = lo + (hi - lo) / 2
            if (cmp_lt(self.keys.get(mid), key)) {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        if (lo < self.keys.len()) {
            if (!cmp_lt(key, self.keys.get(lo))) {
                return true
            }
        }
        return false
    }
    size(self<their<OrderedMap<K, V>>>)<Int> -> {
        return self.keys.len()
    }
    iter(self<their<OrderedMap<K, V>>>)<OrderedMapIter<K, V>> -> {
        return OrderedMapIter<K, V> { map = self, index = 0 }
    }
}

# ---------------------------------------------------------------------------
# True B-tree: `BTreeMap<K, V>` is an index-arena B-tree with O(log n) inserts.
#
# Unlike `OrderedMap` (parallel sorted Vecs, binary-search get but O(n)
# insert), this is a real minimum-degree-2 B-tree: each node holds 1-3 sorted
# keys (and parallel values) plus up to 4 child indices into a single shared
# arena `Vec<BTreeNode<K,V>>`, so no node ever shifts more than a constant
# number of elements. Inserts split full nodes on the way down (preventively),
# guaranteeing the descent always lands in a leaf with spare capacity — no
# back-propagating splits (each split is local to one parent/child pair).
#
# `root` is an arena index, or -1 for an empty map. Because all children are
# plain `Int` arena indices (never pointers/shares), the tree is safe to
# copy: every `BTreeNode` owns its `Vec`s outright and the ownership fix
# (deep-copy of a struct-with-owned-Vec on push/get/set/param-copy) makes an
# arena `Vec<BTreeNode<K,V>>` safe to grow.
#
# Build one with `BTreeMap<K, V>()`. `MapEntry<K, V>` (reused from `HashMap`)
# is the iterator item, so `for (kv in bt.iter())` reads `kv.key` / `kv.value`.
# A B-tree key type only needs `Comparable` (order); no `Equatable` required,
# since membership is decided by ordering, not an `equals` probe.
share(all)
struct BTreeNode<K, V> {
    keys<Vec<K>>,
    vals<Vec<V>>,
    children<Vec<Int>>
}

share(all)
struct BTreeMap<K, V> {
    nodes<Vec<BTreeNode<K, V>>>,
    root<Int>,
    size<Int>

    # Empty B-tree.
    constructor() {
        return BTreeMap<K, V> { nodes = Vec<BTreeNode<K, V>>(), root = -1, size = 0 }
    }
}

share(all)
struct BTreeMapIter<K, V> {
    map<their<BTreeMap<K, V>>>,
    stk<Vec<Int>>,
    pos<Vec<Int>>
}

share(all)
bind<K<Comparable>, V> Iterator -> BTreeMapIter<K, V> {
    type Item = MapEntry<K, V>
    next(self<their<BTreeMapIter<K, V>>>)<MapEntry<K, V>?> -> {
        gg<Bool> = true
        while (gg) {
            if (self.stk.len() == 0) {
                return MapEntry<K, V>?()
            }
            ndx<Int> = self.stk.len() - 1
            nid<Int> = self.stk.get(ndx)
            nd<BTreeNode<K, V>> = self.map.nodes.get(nid)
            pp<Int> = self.pos.get(ndx)
            if (nd.children.len() == 0) {
                # Leaf: emit keys[pp] then advance.
                if (pp < nd.keys.len()) {
                    e<MapEntry<K, V>> = MapEntry<K, V> { key = nd.keys.get(pp), value = nd.vals.get(pp) }
                    self.pos.set(ndx, pp + 1)
                    return MapEntry<K, V>?(e)
                }
                self.stk.pop()
                self.pos.pop()
                gg = true
            } else {
                # Internal: children.len() = keys.len()+1. The in-order output is
                # the interleaved sequence child0,key0,child1,key1,...,child(k-1),
                # key(k-1),child(k) -- 2k+1 items (k keys, k+1 children). Encode
                # the position as an index into that sequence: even pp => child
                # index pp/2; odd pp => key index pp/2.
                cc<Int> = nd.children.len()
                if (pp % 2 == 0) {
                    ci<Int> = pp / 2
                    if (ci < cc) {
                        # Descend into child `ci`; resume at pp+1 afterwards.
                        self.pos.set(ndx, pp + 1)
                        cid<Int> = nd.children.get(ci)
                        self.stk.push(cid)
                        self.pos.push(0)
                        gg = true
                    } else {
                        self.stk.pop()
                        self.pos.pop()
                        gg = true
                    }
                } else {
                    ki<Int> = pp / 2
                    if (ki < nd.keys.len()) {
                        e2<MapEntry<K, V>> = MapEntry<K, V> { key = nd.keys.get(ki), value = nd.vals.get(ki) }
                        self.pos.set(ndx, pp + 1)
                        return MapEntry<K, V>?(e2)
                    }
                    # Past the last key (the trailing pp odd position after the
                    # final child) -- this internal node is complete.
                    self.stk.pop()
                    self.pos.pop()
                    gg = true
                }
            }
        }
        return MapEntry<K, V>?()
    }

    # Iterators are themselves iterable over the same underlying map.
    iter(self<their<BTreeMapIter<K, V>>>)<BTreeMapIter<K, V>> -> {
        return BTreeMapIter<K, V> { map = self.map, stk = self.stk, pos = self.pos }
    }
}

share(all)
aspect BTreeMapOps {
    put(self<their<BTreeMap<K, V>>>, key<K>, val<V>)<Bool>
    get(self<their<BTreeMap<K, V>>>, key<K>)<V?>
    contains_key(self<their<BTreeMap<K, V>>>, key<K>)<Bool>
    size(self<their<BTreeMap<K, V>>>)<Int>
    iter(self<their<BTreeMap<K, V>>>)<BTreeMapIter<K, V>>
}

share(all)
bind<K<Comparable>, V> BTreeMapOps -> BTreeMap<K, V> {
    # Split the full child at `parent.child[i]`: its median key/value rises into
    # `parent` and its right half becomes a brand-new sibling node in the arena.
    # `parent` MUST be non-full (guaranteed by split-on-the-way-down descent).
    # The child had exactly 2t-1 == 3 keys and up to 4 children (t = 2).
    put(self<their<BTreeMap<K, V>>>, key<K>, val<V>)<Bool> -> {
        # Empty tree: make a single-leaf root.
        if (self.root == -1) {
            rt<BTreeNode<K, V>> = BTreeNode<K, V> { keys = Vec<K>(), vals = Vec<V>(), children = Vec<Int>() }
            rt.keys.push(key)
            rt.vals.push(val)
            self.nodes.push(rt)
            self.root = 0
            self.size = 1
            return true
        }
        # If the root is full, grow a new root: rise the old root's median into a
        # fresh root, which then has two non-full children (standard B-tree).
        rootNode<BTreeNode<K, V>> = self.nodes.get(self.root)
        if (rootNode.keys.len() == 3) {
            fullIdx<Int> = self.root
            full<BTreeNode<K, V>> = self.nodes.get(fullIdx)
            midKey<K> = full.keys.get(1)
            midVal<V> = full.vals.get(1)
            # Right sibling takes the high key (index 2) and high children (2,3).
            right<BTreeNode<K, V>> = BTreeNode<K, V> { keys = Vec<K>(), vals = Vec<V>(), children = Vec<Int>() }
            right.keys.push(full.keys.get(2))
            right.vals.push(full.vals.get(2))
            if (full.children.len() > 0) {
                right.children.push(full.children.get(2))
                right.children.push(full.children.get(3))
                full.children.remove_at(3)
                full.children.remove_at(2)
            }
            full.keys.remove_at(2)
            full.keys.remove_at(1)
            full.vals.remove_at(2)
            full.vals.remove_at(1)
            self.nodes.set(fullIdx, full)
            rightIdx<Int> = self.nodes.len()
            self.nodes.push(right)
            # New root holds the median and the two (now non-full) children.
            newRoot<BTreeNode<K, V>> = BTreeNode<K, V> { keys = Vec<K>(), vals = Vec<V>(), children = Vec<Int>() }
            newRoot.keys.push(midKey)
            newRoot.vals.push(midVal)
            newRoot.children.push(fullIdx)
            newRoot.children.push(rightIdx)
            self.nodes.push(newRoot)
            self.root = self.nodes.len() - 1
        }
        # Descend, splitting any full child before stepping into it, so we always
        # reach a leaf with spare room.
        cur<Int> = self.root
        keepGoing<Bool> = true
        while (keepGoing) {
            nd<BTreeNode<K, V>> = self.nodes.get(cur)
            # Binary search for the first key >= `key`.
            lo<Int> = 0
            hi<Int> = nd.keys.len()
            while (lo < hi) {
                mid<Int> = lo + (hi - lo) / 2
                if (cmp_lt(nd.keys.get(mid), key)) {
                    lo = mid + 1
                } else {
                    hi = mid
                }
            }
            # Exact match -> overwrite the value in place.
            if (lo < nd.keys.len()) {
                if (!cmp_lt(key, nd.keys.get(lo))) {
                    nd.vals.set(lo, val)
                    self.nodes.set(cur, nd)
                    return true
                }
            }
            if (nd.children.len() == 0) {
                # Leaf with capacity: insert the new key value at sorted `lo`.
                nd.keys.push(key)
                nd.vals.push(val)
                pp<Int> = nd.keys.len() - 1
                while (pp > lo) {
                    kk<K> = nd.keys.get(pp - 1)
                    nd.keys.set(pp - 1, nd.keys.get(pp))
                    nd.keys.set(pp, kk)
                    vv<V> = nd.vals.get(pp - 1)
                    nd.vals.set(pp - 1, nd.vals.get(pp))
                    nd.vals.set(pp, vv)
                    pp = pp - 1
                }
                self.nodes.set(cur, nd)
                self.size = self.size + 1
                return true
            }
            # Internal node: descend into the child at `lo`, splitting it first
            # if full. After a split the child seat may have moved, so re-search.
            if (self.nodes.get(nd.children.get(lo)).keys.len() == 3) {
                pnode<BTreeNode<K, V>> = nd
                fullIdx2<Int> = pnode.children.get(lo)
                full2<BTreeNode<K, V>> = self.nodes.get(fullIdx2)
                midKey2<K> = full2.keys.get(1)
                midVal2<V> = full2.vals.get(1)
                right2<BTreeNode<K, V>> = BTreeNode<K, V> { keys = Vec<K>(), vals = Vec<V>(), children = Vec<Int>() }
                right2.keys.push(full2.keys.get(2))
                right2.vals.push(full2.vals.get(2))
                if (full2.children.len() > 0) {
                    right2.children.push(full2.children.get(2))
                    right2.children.push(full2.children.get(3))
                    full2.children.remove_at(3)
                    full2.children.remove_at(2)
                }
                full2.keys.remove_at(2)
                full2.keys.remove_at(1)
                full2.vals.remove_at(2)
                full2.vals.remove_at(1)
                self.nodes.set(fullIdx2, full2)
                rightIdx2<Int> = self.nodes.len()
                self.nodes.push(right2)
                # Rise the median into `cur` at key index lo; then add the new
                # sibling at child seat lo+1.
                pnode.keys.push(midKey2)
                pnode.vals.push(midVal2)
                qq2<Int> = pnode.keys.len() - 1
                while (qq2 > lo) {
                    kk2<K> = pnode.keys.get(qq2 - 1)
                    pnode.keys.set(qq2 - 1, pnode.keys.get(qq2))
                    pnode.keys.set(qq2, kk2)
                    vv2<V> = pnode.vals.get(qq2 - 1)
                    pnode.vals.set(qq2 - 1, pnode.vals.get(qq2))
                    pnode.vals.set(qq2, vv2)
                    qq2 = qq2 - 1
                }
                pnode.children.push(rightIdx2)
                rr2<Int> = pnode.children.len() - 1
                while (rr2 > lo + 1) {
                    ii2<Int> = pnode.children.get(rr2 - 1)
                    pnode.children.set(rr2 - 1, pnode.children.get(rr2))
                    pnode.children.set(rr2, ii2)
                    rr2 = rr2 - 1
                }
                self.nodes.set(cur, pnode)
                nd = self.nodes.get(cur)
                lo = 0
                hi = nd.keys.len()
                while (lo < hi) {
                    mid<Int> = lo + (hi - lo) / 2
                    if (cmp_lt(nd.keys.get(mid), key)) {
                        lo = mid + 1
                    } else {
                        hi = mid
                    }
                }
                if (lo < nd.keys.len()) {
                    if (!cmp_lt(key, nd.keys.get(lo))) {
                        nd.vals.set(lo, val)
                        self.nodes.set(cur, nd)
                        return true
                    }
                }
            }
            cur = nd.children.get(lo)
            keepGoing = true
        }
        return true
    }
    get(self<their<BTreeMap<K, V>>>, key<K>)<V?> -> {
        cur<Int> = self.root
        while (cur != -1) {
            if (cur >= self.nodes.len()) {
                return V?()
            }
            nd<BTreeNode<K, V>> = self.nodes.get(cur)
            lo<Int> = 0
            hi<Int> = nd.keys.len()
            while (lo < hi) {
                mid<Int> = lo + (hi - lo) / 2
                if (cmp_lt(nd.keys.get(mid), key)) {
                    lo = mid + 1
                } else {
                    hi = mid
                }
            }
            if (lo < nd.keys.len()) {
                if (!cmp_lt(key, nd.keys.get(lo))) {
                    return V?(nd.vals.get(lo))
                }
            }
            if (nd.children.len() == 0) {
                return V?()
            }
            cur = nd.children.get(lo)
        }
        return V?()
    }
    contains_key(self<their<BTreeMap<K, V>>>, key<K>)<Bool> -> {
        cur<Int> = self.root
        while (cur != -1 && cur < self.nodes.len()) {
            nd<BTreeNode<K, V>> = self.nodes.get(cur)
            lo<Int> = 0
            hi<Int> = nd.keys.len()
            while (lo < hi) {
                mid<Int> = lo + (hi - lo) / 2
                if (cmp_lt(nd.keys.get(mid), key)) {
                    lo = mid + 1
                } else {
                    hi = mid
                }
            }
            if (lo < nd.keys.len()) {
                if (!cmp_lt(key, nd.keys.get(lo))) {
                    return true
                }
            }
            if (nd.children.len() == 0) {
                return false
            }
            cur = nd.children.get(lo)
        }
        return false
    }
    size(self<their<BTreeMap<K, V>>>)<Int> -> {
        return self.size
    }
    iter(self<their<BTreeMap<K, V>>>)<BTreeMapIter<K, V>> -> {
        stk<Vec<Int>> = Vec<Int>()
        pos<Vec<Int>> = Vec<Int>()
        if (self.root != -1) {
            stk.push(self.root)
            pos.push(0)
        }
        return BTreeMapIter<K, V> { map = self, stk = stk, pos = pos }
    }
}

# ---------------------------------------------------------------------------
# Pure-Vyb `Vec<T>` extension operations.
#
# The built-in `Vec<T>` already ships the mutation/access primitives (`push`,
# `pop`, `get`, `set`, `len`, `clear`, `is_empty`, `contains`, `remove_at`).
# These binds layer analysis/view operations on top, written in Vyb over those
# primitives. All are *non-mutating*:
#
# - `reversed` returns a fresh reversed vector.
# - `sorted` returns a fresh ascending copy.
# - `first` / `last` return the head / tail element.
# - `find` returns the index of the first `==` match as `Int?` (absent = not found).
# - `min` / `max` read the least / greatest element.
#
# `Vec::get` returns the element's zero/default value for a negative or
# out-of-range index, so `first` / `last` also return that default for an empty
# vector. `Vec::set` ignores negative or out-of-range indexes. Comparison order is
# dispatched through the `Comparable`-bounded `cmp_lt` helper (mirroring the
# `equals`-based `samekey`), because a direct `compare` call does not resolve on
# a generic element. The higher-order combinators live in a separate
# unconstrained `VecHigherOps` aspect so they work on any element type (see
# below).
#
# ---------------------------------------------------------------------------
share(all)
aspect VecOps {
    first(self<Vec<T>>)<T> -> { }
    last(self<Vec<T>>)<T> -> { }
    reversed(self<Vec<T>>)<Vec<T>> -> { }
    find(self<Vec<T>>, value<T>)<Int?> -> { }
    min(self<Vec<T>>)<T> -> { }
    max(self<Vec<T>>)<T> -> { }
    sorted(self<Vec<T>>)<Vec<T>> -> { }
    sort_in_place(self<their<Vec<T>>>)<Void> -> { }
}

share(all)
bind<T<Comparable, Equatable>> VecOps -> Vec<T> {
    first(self<Vec<T>>)<T> -> {
        return self.get(0)
    }
    last(self<Vec<T>>)<T> -> {
        return self.get(self.len() - 1)
    }
    reversed(self<Vec<T>>)<Vec<T>> -> {
        out<Vec<T>> = Vec()
        i<Int> = self.len() - 1
        while (i >= 0) {
            out.push(self.get(i))
            i = i - 1
        }
        return out
    }
    find(self<Vec<T>>, value<T>)<Int?> -> {
        i<Int> = 0
        while (i < self.len()) {
            if (samekey(self.get(i), value)) {
                return Int?(i)
            }
            i = i + 1
        }
        return Int?()
    }
    min(self<Vec<T>>)<T> -> {
        m<T> = self.get(0)
        i<Int> = 1
        while (i < self.len()) {
            if (cmp_lt(self.get(i), m)) { m = self.get(i) }
            i = i + 1
        }
        return m
    }
    max(self<Vec<T>>)<T> -> {
        m<T> = self.get(0)
        i<Int> = 1
        while (i < self.len()) {
            if (cmp_lt(m, self.get(i))) { m = self.get(i) }
            i = i + 1
        }
        return m
    }
    sorted(self<Vec<T>>)<Vec<T>> -> {
        n<Int> = self.len()
        used<Vec<Bool>> = Vec()
        k<Int> = 0
        while (k < n) { used.push(false); k = k + 1 }
        out<Vec<T>> = Vec()
        k = 0
        while (k < n) {
            mi<Int> = -1
            j<Int> = 0
            while (j < n) {
                if (!used.get(j)) {
                    if (mi == -1) { mi = j }
                    else if (cmp_lt(self.get(j), self.get(mi))) { mi = j }
                }
                j = j + 1
            }
            out.push(self.get(mi))
            used.set(mi, true)
            k = k + 1
        }
        return out
    }
    # In-place stable(ish) ascending selection sort via the Comparable-bound
    # `cmp_lt` helper. Mutates the receiver's own backing store and borrows it
    # by-ref, so no temporary copy is made.
    sort_in_place(self<their<Vec<T>>>)<Void> -> {
        n<Int> = self.len()
        i<Int> = 0
        while (i < n) {
            mi<Int> = i
            j<Int> = i + 1
            while (j < n) {
                if (cmp_lt(self.get(j), self.get(mi))) { mi = j }
                j = j + 1
            }
            if (mi != i) {
                tmp<T> = self.get(i)
                self.set(i, self.get(mi))
                self.set(mi, tmp)
            }
            i = i + 1
        }
    }
}

# ---------------------------------------------------------------------------
# Higher-order `Vec<T>` combinators (non-capturing lambdas):
#
# - `map(f)` applies `f` to every element and returns a fresh transformed vector.
# - `filter(f)` keeps only the elements for which `f` is `true`, in a fresh vector.
# - `reduce(init, f)` folds the vector left-to-right: the accumulator starts at
#   `init` and `f` is applied as `acc = f(acc, elem)` for each element in order.
# - `map_in_place(f)` rewrites each element in place.
# - `retain(f)` keeps only the elements for which `f` is `true`, compacting in
#   place and returning the surviving count.
# - `reverse_in_place()` flips the order in place.
#
# All are bound without a `Comparable` / `Equatable` bound on `T`, so they are
# available on any element type. The `fn` arguments must be non-capturing (bare
# function pointers); closures with an environment are a future extension. The
# non-mutating trio never modify the receiver; the `_in_place` forms mutate the
# receiver's own backing store by-ref.
#
# ---------------------------------------------------------------------------
share(all)
aspect VecHigherOps {
    map(self<Vec<T>>, f<fn(T) -> T>)<Vec<T>> -> { }
    filter(self<Vec<T>>, f<fn(T) -> Bool>)<Vec<T>> -> { }
    reduce(self<Vec<T>>, init<T>, f<fn(T, T) -> T>)<T> -> { }
    map_in_place(self<their<Vec<T>>>, f<fn(T) -> T>)<Void> -> { }
    retain(self<their<Vec<T>>>, f<fn(T) -> Bool>)<Int> -> { }
    reverse_in_place(self<their<Vec<T>>>)<Void> -> { }
    iter(self<their<Vec<T>>>)<VecIter<T>> -> { }
}

share(all)
bind<T> VecHigherOps -> Vec<T> {
    map(self<Vec<T>>, f<fn(T) -> T>)<Vec<T>> -> {
        out<Vec<T>> = Vec()
        i<Int> = 0
        while (i < self.len()) {
            out.push(f(self.get(i)))
            i = i + 1
        }
        return out
    }
    filter(self<Vec<T>>, f<fn(T) -> Bool>)<Vec<T>> -> {
        out<Vec<T>> = Vec()
        i<Int> = 0
        while (i < self.len()) {
            if (f(self.get(i))) {
                out.push(self.get(i))
            }
            i = i + 1
        }
        return out
    }
    reduce(self<Vec<T>>, init<T>, f<fn(T, T) -> T>)<T> -> {
        acc<T> = init
        i<Int> = 0
        while (i < self.len()) {
            acc = f(acc, self.get(i))
            i = i + 1
        }
        return acc
    }
    map_in_place(self<their<Vec<T>>>, f<fn(T) -> T>)<Void> -> {
        i<Int> = 0
        while (i < self.len()) {
            self.set(i, f(self.get(i)))
            i = i + 1
        }
    }
    retain(self<their<Vec<T>>>, f<fn(T) -> Bool>)<Int> -> {
        j<Int> = 0
        i<Int> = 0
        while (i < self.len()) {
            if (f(self.get(i))) {
                self.set(j, self.get(i))
                j = j + 1
            }
            i = i + 1
        }
        while (self.len() > j) {
            self.pop()
        }
        return j
    }
    reverse_in_place(self<their<Vec<T>>>)<Void> -> {
        i<Int> = 0
        j<Int> = self.len() - 1
        while (i < j) {
            tmp<T> = self.get(i)
            self.set(i, self.get(j))
            self.set(j, tmp)
            i = i + 1
            j = j - 1
        }
    }
    iter(self<their<Vec<T>>>)<VecIter<T>> -> {
        return VecIter<T> { data = self, index = 0 }
    }
}

share(all)
collections_status_message()<String> -> {
    return "collections: HashMap / HashSet (hash-bucket) + OrderedMap (ordered, sorted-vector, Comparable) + VecIter (v.iter()) + MapIter (m.iter()) / HashIter (s.iter()) + OrderedMapIter (om.iter())"
}
