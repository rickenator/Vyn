# network - TCP/IP socket basics over BSD sockets.
#
# Everything crosses the runtime's `__vyb_net_*` functions in
# `runtime/vyb_runtime.c`; the Vyb surface stays allocation/pointer-free. IP
# addresses are plain strings: a dotted-quad ("127.0.0.1") or a colon-hex IPv6
# literal ("::1"). Pass "0.0.0.0" (or ""), or "::" for IPv6, to bind any
# interface. A port of `0` asks the kernel for an ephemeral port, which you can
# read back with `socket_local_port()`. `socket_set_timeout(fd, ms)` keeps a
# non-responsive peer from hanging a caller forever.
#
# Usage (loopback echo):
#   import network::{socket_open, socket_bind, socket_listen, socket_accept,
#                    socket_connect, socket_send, socket_recv, socket_local_port,
#                    socket_close, Socket}
#   srv = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, 0) else -1
#   if (!(socket_bind(srv, "127.0.0.1", 0) else false)) { return }
#   if (!(socket_listen(srv, 1) else false)) { return }
#   port = socket_local_port(srv) else -1
#   cli = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, 0) else -1
#   if (!(socket_connect(cli, "127.0.0.1", port) else false)) { return }
#   conn = socket_accept(srv) else -1
#   socket_send(cli, "hello")
#   socket_recv(conn, 5) else ""   // "hello"
#
# Diagnostics: `socket_error_code()` (0 = no error) and `socket_error_message()`
# report the result of the last low-level network operation. Every `socket_*`
# function follows the engine-wide `T?` shape (PROGRAMMERS_GUIDE §3.16):
# `socket_open`/`socket_accept` return `Int?` (the descriptor), `socket_close`/
# `socket_bind`/`socket_listen`/`socket_connect`/`socket_set_timeout` return
# `Bool?`, `socket_send` returns `Int?` (bytes written), `socket_recv` returns
# `String?`, `socket_local_port` returns `Int?`, and `socket_resolve` returns
# `String?`. Absence *is* the failed operation, so callers never touch a
# sentinel `fd`/`-1`/`""`. Unwrap with `else` for a default, or `match` to
# escalate into the fail/trap framework via the shared `NetError`/
# `net_error(op, target)`. The high-level wrappers (`tcp_connect`, `tcp_listen`,
# `tcp_accept`, `udp_bind`, `async_*`) build on them.

# Domain / socket-type constants. A constant enum: each member is a compile-time
# Int (scoped under `Socket`), so they flow straight into the Int params of the
# socket helpers without a call.
share(all)
enum Socket {
    AF_INET = 2
    AF_INET6 = 10
    SOCK_STREAM = 1
    IPPROTO_TCP = 6
    SOCK_DGRAM = 2
    IPPROTO_UDP = 17
}

# Create a socket in the given domain/type/protocol. Returns `Int?` -- present
# holding the descriptor (>= 0), absent on failure (see socket_error_code()).
share(all)
socket_open(domain<Int>, st<Int>, pr<Int>)<Int?> -> {
    fd<Int> = vyb_net_open(domain, st, pr)
    if (fd < 0) { return Int?() }
    return Int?(fd)
}

# Close a socket descriptor. Returns `Bool?` -- present on success, absent on
# failure.
share(all)
socket_close(fd<Int>)<Bool?> -> {
    r<Int> = vyb_net_close(fd)
    if (r != 0) { return Bool?() }
    return Bool?(true)
}

# Bind `fd` to the given IP / port. Use "0.0.0.0" or "" to bind any interface.
# Returns `Bool?` -- present on success, absent on failure.
share(all)
socket_bind(fd<Int>, ip<String>, port<Int>)<Bool?> -> {
    r<Int> = vyb_net_bind(fd, ip, port)
    if (r != 0) { return Bool?() }
    return Bool?(true)
}

# Mark `fd` as a listening socket. Returns `Bool?` -- present on success,
# absent on failure.
share(all)
socket_listen(fd<Int>, backlog<Int>)<Bool?> -> {
    r<Int> = vyb_net_listen(fd, backlog)
    if (r != 0) { return Bool?() }
    return Bool?(true)
}

# Accept a pending connection on a listening socket. Returns `Int?` -- present
# holding the connected descriptor (>= 0), absent on failure.
share(all)
socket_accept(fd<Int>)<Int?> -> {
    c<Int> = vyb_net_accept(fd)
    if (c < 0) { return Int?() }
    return Int?(c)
}

# Connect `fd` to `ip:port`. Returns `Bool?` -- present on success, absent on
# failure.
share(all)
socket_connect(fd<Int>, ip<String>, port<Int>)<Bool?> -> {
    r<Int> = vyb_net_connect(fd, ip, port)
    if (r != 0) { return Bool?() }
    return Bool?(true)
}

# Put a read + write timeout on a socket so a hung peer can't block the process
# forever; `ms` of 0 (or negative) disables the timeout. Returns `Bool?` --
# present on success, absent on failure.
share(all)
socket_set_timeout(fd<Int>, ms<Int>)<Bool?> -> {
    r<Int> = vyb_net_set_timeout(fd, ms)
    if (r != 0) { return Bool?() }
    return Bool?(true)
}

# Send the whole of `data` on `fd`. Returns `Int?` -- present holding the number
# of bytes sent, absent on failure.
share(all)
socket_send(fd<Int>, data<String>)<Int?> -> {
    n<Int> = vyb_net_send(fd, data)
    if (n < 0) { return Int?() }
    return Int?(n)
}

# Receive up to `maxlen` bytes from `fd` as a fresh `String?` -- present holding
# the bytes read (an empty read at end-of-stream is the present ""), absent on a
# transport error. Callers stop reading when they see the absent `?`.
share(all)
socket_recv(fd<Int>, maxlen<Int>)<String?> -> {
    return vyb_net_recv_opt(fd, maxlen)
}

# The local port a socket is bound to (useful after binding port 0). Returns
# `Int?` -- present holding the port, absent on failure.
share(all)
socket_local_port(fd<Int>)<Int?> -> {
    p<Int> = vyb_net_local_port(fd)
    if (p < 0) { return Int?() }
    return Int?(p)
}

# Resolve `host` (a hostname or IP literal) to a dotted-quad IPv4 address
# string, for connecting by name while keeping the name for SNI / hostname
# verification. Returns `String?` -- present holding the address, absent on
# failure (see socket_error_code()).
share(all)
socket_resolve(host<String>)<String?> -> {
    return vyb_net_resolve_opt(host)
}

share(all)
socket_error_code()<Int> -> {
    return vyb_net_error_code()
}

share(all)
socket_error_message()<String> -> {
    return vyb_net_error_message()
}

# A shared error value for escalating a failed network operation into the
# fail/trap framework. `operation` names the failing call ("connect", "listen",
# "accept", "bind", "resolve"); `target` is the affected host/address; `message`
# is the last diagnostic from `socket_error_message()`. Build it directly with a
# struct literal or via the `net_error()` convenience.
share(all)
struct NetError {
    operation<String>,
    target<String>,
    message<String>
}

# Build a `NetError` carrying the current `socket_error_message()` diagnostic for
# the named `operation` on `target`. Typical use is shaping an absent `TcpStream?`
# into a fail:
#   match (tcp_connect(h, p)) { s -> body(s), ? -> { fail net_error("connect", h) } }
share(all)
net_error(operation<String>, target<String>)<NetError> -> {
    return NetError { operation = operation, target = target, message = socket_error_message() }
}

# --- Higher-level wrappers: TcpStream / TcpListener / UdpSocket --------------
# Ergonomically-bound socket types layered on the raw helpers above. A value
# carries its descriptor plus peer/endpoint metadata, and the bound methods give
# the idiomatic `.write(...)` / `.read(...)` / `.close(...)` surface. Errors
# follow the module idiom: an op that can fail returns an empty/-1 result and the
# diagnostic lives in `socket_error_code()` / `socket_error_message()`.
# Async variants (`async_tcp_*` / `async_udp_*`) run on the event-loop executor
# and suspend the calling fiber instead of blocking a worker.

share(all)
struct TcpStream {
    fd<Int>,
    peer_ip<String>,
    peer_port<Int>
}

share(all)
struct TcpListener {
    fd<Int>,
    local_ip<String>,
    local_port<Int>
}

share(all)
struct UdpSocket {
    fd<Int>,
    local_ip<String>,
    local_port<Int>
}

# The behavior contracts that give each type its method surface, so
# `stream.write("hi")`, `listener.local_port()` and `sock.send_to(...)` resolve.
share(all)
aspect TcpStreamOps {
    write(self<Self>, data<String>)<Int?> -> { }
    read(self<Self>, max<Int>)<String> -> { }
    close(self<Self>)<Bool?> -> { }
    peer_ip(self<Self>)<String> -> { }
    peer_port(self<Self>)<Int> -> { }
}

share(all)
bind TcpStreamOps -> TcpStream {
    write(self<Self>, data<String>)<Int?> -> {
        n<Int> = vyb_net_send(self.fd, data)
        if (n < 0) { return Int?() }
        return Int?(n)
    }
    read(self<Self>, max<Int>)<String> -> {
        return vyb_net_recv(self.fd, max)
    }
    close(self<Self>)<Bool?> -> {
        r<Int> = vyb_net_close(self.fd)
        if (r != 0) { return Bool?() }
        return Bool?(true)
    }
    peer_ip(self<Self>)<String> -> {
        return self.peer_ip
    }
    peer_port(self<Self>)<Int> -> {
        return self.peer_port
    }
}

share(all)
aspect TcpListenerOps {
    local_ip(self<Self>)<String> -> { }
    local_port(self<Self>)<Int> -> { }
    close(self<Self>)<Bool?> -> { }
}

share(all)
bind TcpListenerOps -> TcpListener {
    local_ip(self<Self>)<String> -> { return self.local_ip }
    local_port(self<Self>)<Int> -> { return self.local_port }
    close(self<Self>)<Bool?> -> {
        r<Int> = vyb_net_close(self.fd)
        if (r != 0) { return Bool?() }
        return Bool?(true)
    }
}

share(all)
aspect UdpSocketOps {
    local_ip(self<Self>)<String> -> { }
    local_port(self<Self>)<Int> -> { }
    send_to(self<Self>, ip<String>, port<Int>, data<String>)<Int?> -> { }
    recv_from(self<Self>, max<Int>)<String?> -> { }
    close(self<Self>)<Bool?> -> { }
}

share(all)
bind UdpSocketOps -> UdpSocket {
    local_ip(self<Self>)<String> -> { return self.local_ip }
    local_port(self<Self>)<Int> -> { return self.local_port }
    send_to(self<Self>, ip<String>, port<Int>, data<String>)<Int?> -> {
        n<Int> = vyb_net_sendto(self.fd, data, ip, port)
        if (n < 0) { return Int?() }
        return Int?(n)
    }
    recv_from(self<Self>, max<Int>)<String?> -> {
        return vyb_net_recvfrom_opt(self.fd, max)
    }
    close(self<Self>)<Bool?> -> {
        r<Int> = vyb_net_close(self.fd)
        if (r != 0) { return Bool?() }
        return Bool?(true)
    }
}

# Connect to `ip:port`. Returns the established stream as `TcpStream?` -- present
# on success, absent on failure. The wrap happens here, so callers never touch a
# sentinel `fd`. Use `else` for a default or `match` to escalate via
# `fail net_error("connect", ip)`.
share(all)
tcp_connect(ip<String>, port<Int>)<TcpStream?> -> {
    fd<Int> = vyb_net_open(Socket::AF_INET, Socket::SOCK_STREAM, Socket::IPPROTO_TCP)
    if (fd < 0) { return TcpStream?() }
    if (vyb_net_connect(fd, ip, port) != 0) {
        vyb_net_close(fd)
        return TcpStream?()
    }
    return TcpStream?(TcpStream { fd = fd, peer_ip = ip, peer_port = port })
}

# Listen on `ip:port` ("" or "0.0.0.0" = all interfaces; port 0 = ephemeral,
# read back with local_port(listener)). Returns `TcpListener?` -- present on
# success, absent on failure.
share(all)
tcp_listen(ip<String>, port<Int>, backlog<Int>)<TcpListener?> -> {
    fd<Int> = vyb_net_open(Socket::AF_INET, Socket::SOCK_STREAM, Socket::IPPROTO_TCP)
    if (fd < 0) { return TcpListener?() }
    if (vyb_net_bind(fd, ip, port) != 0 || vyb_net_listen(fd, backlog) != 0) {
        vyb_net_close(fd)
        return TcpListener?()
    }
    lp<Int> = vyb_net_local_port(fd)
    return TcpListener?(TcpListener { fd = fd, local_ip = ip, local_port = lp })
}

# Accept the next pending connection on `listener`. Returns the new stream as
# `TcpStream?` -- present on success, absent on failure (blocking accept; see
# `async_tcp_accept` for the event-loop variant).
share(all)
tcp_accept(listener<TcpListener>)<TcpStream?> -> {
    c<Int> = vyb_net_accept(listener.fd)
    if (c < 0) { return TcpStream?() }
    return TcpStream?(TcpStream { fd = c, peer_ip = "", peer_port = -1 })
}

# Bind a datagram socket on `ip:port` ("" / "0.0.0.0" = all interfaces; port 0 =
# ephemeral, read back with local_port(sock)). Returns `UdpSocket?` -- present on
# success, absent on failure.
share(all)
udp_bind(ip<String>, port<Int>)<UdpSocket?> -> {
    fd<Int> = vyb_net_open(Socket::AF_INET, Socket::SOCK_DGRAM, Socket::IPPROTO_UDP)
    if (fd < 0) { return UdpSocket?() }
    if (vyb_net_bind(fd, ip, port) != 0) {
        vyb_net_close(fd)
        return UdpSocket?()
    }
    lp<Int> = vyb_net_local_port(fd)
    return UdpSocket?(UdpSocket { fd = fd, local_ip = ip, local_port = lp })
}

# Send one datagram to `ip:port` (the socket need not be connected). Returns
# `Int?` -- present holding the number of bytes sent, absent on failure.
share(all)
udp_send_to(s<UdpSocket>, ip<String>, port<Int>, data<String>)<Int?> -> {
    n<Int> = vyb_net_sendto(s.fd, data, ip, port)
    if (n < 0) { return Int?() }
    return Int?(n)
}

# Receive one datagram as a lossless `String?`. Records the sender, read with
# udp_last_peer_ip() / udp_last_peer_port(). Present holding the datagram bytes
# (which may legitimately be empty), absent on error, so an empty datagram is
# never conflated with a failed receive.
share(all)
udp_recv_from(s<UdpSocket>, max<Int>)<String?> -> {
    return vyb_net_recvfrom_opt(s.fd, max)
}

# The peer that sent the last received datagram.
share(all)
udp_last_peer_ip()<String> -> {
    return vyb_net_last_peer_ip()
}
share(all)
udp_last_peer_port()<Int> -> {
    return vyb_net_last_peer_port()
}

# Close a socket (stream, listener, or datagram). Returns `Bool?` -- present on
# success, absent on failure.
share(all)
udp_close(s<UdpSocket>)<Bool?> -> {
    r<Int> = vyb_net_close(s.fd)
    if (r != 0) { return Bool?() }
    return Bool?(true)
}

# --- Async variants (event-loop executor) -----------------------------------
# Each suspends the calling fiber instead of blocking a worker; use from an
# async fn() (seeded via asyncs::async_spawn).

share(all)
async_tcp_accept(listener<TcpListener>)<TcpStream?> -> {
    c<Int> = vyb_async_accept(listener.fd)
    if (c < 0) { return TcpStream?() }
    return TcpStream?(TcpStream { fd = c, peer_ip = "", peer_port = -1 })
}

share(all)
async_tcp_connect(ip<String>, port<Int>)<TcpStream?> -> {
    fd<Int> = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, Socket::IPPROTO_TCP) else -1
    if (fd < 0) { return TcpStream?() }
    if (vyb_async_connect(fd, ip, port) != 0) {
        socket_close(fd)
        return TcpStream?()
    }
    return TcpStream?(TcpStream { fd = fd, peer_ip = ip, peer_port = port })
}

# Send `data` on the stream from the event loop, suspending the calling fiber.
# Returns `Int?` -- present holding the bytes sent, absent on failure.
share(all)
async_tcp_write(s<TcpStream>, data<String>)<Int?> -> {
    n<Int> = vyb_async_send(s.fd, data)
    if (n < 0) { return Int?() }
    return Int?(n)
}

share(all)
async_tcp_read(s<TcpStream>, max<Int>)<String?> -> {
    return vyb_async_recv_opt(s.fd, max)
}

# Send one datagram from the event loop, suspending the calling fiber. Returns
# `Int?` -- present holding the bytes sent, absent on failure.
share(all)
async_udp_send_to(s<UdpSocket>, ip<String>, port<Int>, data<String>)<Int?> -> {
    n<Int> = vyb_async_sendto(s.fd, data, ip, port)
    if (n < 0) { return Int?() }
    return Int?(n)
}

share(all)
async_udp_recv_from(s<UdpSocket>, max<Int>)<String> -> {
    return vyb_async_recvfrom(s.fd, max)
}
