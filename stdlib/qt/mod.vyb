# gen_qt[mod_wrappers]: end

# gen_qt[mod_enums]: begin
share(all)
enum QtEvent {
    none = 0
    click = 1
    textChanged = 2
    toggled = 3
    indexChanged = 4
    valueChanged = 5
}

share(all)
enum QtWidgetKind {
    none = 0
    window = 1
    label = 2
    button = 3
    edit = 4
    checkbox = 5
    progress = 6
    combo = 7
    spin = 8
    slider = 9
    dial = 10
    group = 11
    textEdit = 12
    radio = 13
}
# gen_qt[mod_enums]: end
