# qt - Qt5 Widgets native GUI, wrapped as an opaque-Int surface.
#
# A small, deterministic subset of Qt5 Widgets for native-window programs. The
# C++ QApplication/QWidget/QLabel object model stays in the runtime
# (`__vyb_qt_*` shims in `runtime/vyb_qt_bridge.cpp`); Vyb sees only Int
# handles (qintptr-sized), Int dimensions, Bool/Int status flags, and String
# text. String arguments cross as UTF-8 byte buffers; the title/label-text
# getters return owned Strings.
#
# Lifecycle: call qt_init() once. QApplication must live on the main thread,
# which is where a Vyb program's main runs. Construction needs a Qt platform -
# under X11/xcb with a display, offscreen, etc. On a headless box with neither
# a QPA platform nor a $DISPLAY the bridge falls back to the `offscreen`
# platform so qt_init() stays deterministic; GUI code is still expected to run
# where a GUI is available.
#
# Two event-loop models coexist. The default is *polled*: call
# qt_process_events() to pump paint/timer/input events, arm a polled timer with
# qt_set_timer(ms) then check qt_timer_fired() (it clears on read), and drain
# control signals with qt_event_count/handle/kind/pop (or qt_wait_event). This
# stays deterministic under xvfb/offscreen and fits the Int/String FFI.
#
# For a GUI program, qt_run() enters Qt's own native loop (QApplication::exec())
# and dispatches queued control events into the handler registered with
# qt_on_event(fn(handle, kind)); stop it from a handler with qt_run_stop() (whose
# GUI survives) or qt_quit() (full teardown after the loop returns). Background
# asyncs keep running on their worker threads and their enqueued results reach
# the handler through the same queue-draining loop.
#
# Everything returns 0 on success and -1 on error (handle lookups fail on a 0/
# stale or non-matching handle; operation with no QApplication returns -1),
# except the documented deviations: qt_init/qt_active/qt_window_visible/
# qt_timer_fired return 1/0 booleans, qt_window_create/qt_label_create return
# a fresh Int handle (0 on failure), and qt_window_width/height return the
# current size (or -1 on a bad handle).

# gen_qt[mod_wrappers]: begin
# Initialize the QApplication (once); true if the GUI is available.
share(all)
qt_init()<Bool> -> {
    return vyb_qt_init() == 1
}

# Shut the GUI down (terminal - do not use Qt handles afterwards). Returns 0.
share(all)
qt_quit()<Int> -> {
    return vyb_qt_quit()
}

# true while the GUI is initialized.
share(all)
qt_active()<Bool> -> {
    return vyb_qt_active() == 1
}

# Pump the Qt event loop once. Returns 0, or -1 if the GUI is not running.
share(all)
qt_process_events()<Int> -> {
    return vyb_qt_process_events()
}

# Arm a repeating timer every `ms` ms; poll qt_timer_fired(). Returns 0.
share(all)
qt_set_timer(ms<Int>)<Int> -> {
    return vyb_qt_set_timer(ms)
}

# true once the armed timer has fired since the last check (read clears).
share(all)
qt_timer_fired()<Bool> -> {
    return vyb_qt_timer_fired() == 1
}

# Create a top-level window; returns its Int handle or 0 on failure.
share(all)
qt_window_create()<Int> -> {
    return vyb_qt_window_create()
}

# Destroy window `w` (children go with it). Returns 0.
share(all)
qt_window_close(w<Int>)<Int> -> {
    return vyb_qt_window_close(w)
}

# Set titlebar text. Returns 0, or -1 on a bad handle.
share(all)
qt_window_set_title(w<Int>, title<String>)<Int> -> {
    return vyb_qt_window_set_title(w, title)
}

# Current titlebar text (String); "" on a bad handle.
share(all)
qt_window_title(w<Int>)<String> -> {
    return vyb_qt_window_title(w)
}

# Resize to (width, height) pixels. Returns 0.
share(all)
qt_window_resize(w<Int>, width<Int>, height<Int>)<Int> -> {
    return vyb_qt_window_resize(w, width, height)
}

# Content width in pixels, or -1 on a bad handle.
share(all)
qt_window_width(w<Int>)<Int> -> {
    return vyb_qt_window_width(w)
}

# Content height in pixels, or -1 on a bad handle.
share(all)
qt_window_height(w<Int>)<Int> -> {
    return vyb_qt_window_height(w)
}

# Show (map) the window. Returns 0.
share(all)
qt_window_show(w<Int>)<Int> -> {
    return vyb_qt_window_show(w)
}

# Hide (unmap) the window. Returns 0.
share(all)
qt_window_hide(w<Int>)<Int> -> {
    return vyb_qt_window_hide(w)
}

# true while window `w` is visible, else false.
share(all)
qt_window_visible(w<Int>)<Bool> -> {
    return vyb_qt_window_visible(w) == 1
}

# Create a label with `text` under `parent` (0 = none); returns its handle or 0.
share(all)
qt_label_create(parent<Int>, text<String>)<Int> -> {
    return vyb_qt_label_create(parent, text)
}

# Replace label text. Returns 0, or -1 on a non-label handle.
share(all)
qt_label_set_text(label<Int>, text<String>)<Int> -> {
    return vyb_qt_label_set_text(label, text)
}

# Current label text (String); "" on a non-label handle.
share(all)
qt_label_text(label<Int>)<String> -> {
    return vyb_qt_label_text(label)
}

# Create a push button under `parent`; a click enqueues QtEvent::Click. Returns its handle.
share(all)
qt_button_create(parent<Int>, text<String>)<Int> -> {
    return vyb_qt_button_create(parent, text)
}

# Replace button label. Returns 0, or -1 on a non-button handle.
share(all)
qt_button_set_text(button<Int>, text<String>)<Int> -> {
    return vyb_qt_button_set_text(button, text)
}

# Current button label (String); "" on a non-button handle.
share(all)
qt_button_text(button<Int>)<String> -> {
    return vyb_qt_button_text(button)
}

# Enable (true) / disable (false) the button. Returns 0.
share(all)
qt_button_set_enabled(button<Int>, enabled<Bool>)<Int> -> {
    if (enabled) {
        return vyb_qt_button_set_enabled(button, 1)
    }
    return vyb_qt_button_set_enabled(button, 0)
}

# Create a single-line text edit under `parent`; text changes enqueue QtEvent::TextChanged.
share(all)
qt_edit_create(parent<Int>, text<String>)<Int> -> {
    return vyb_qt_edit_create(parent, text)
}

# Current edit text (String); "" on a non-edit handle.
share(all)
qt_edit_text(edit<Int>)<String> -> {
    return vyb_qt_edit_text(edit)
}

# Replace edit text. Returns 0, or -1 on a non-edit handle.
share(all)
qt_edit_set_text(edit<Int>, text<String>)<Int> -> {
    return vyb_qt_edit_set_text(edit, text)
}

# Set placeholder (ghost) text. Returns 0.
share(all)
qt_edit_set_placeholder(edit<Int>, text<String>)<Int> -> {
    return vyb_qt_edit_set_placeholder(edit, text)
}

# Create a checkbox under `parent`; toggles enqueue QtEvent::Toggled. Returns its handle.
share(all)
qt_checkbox_create(parent<Int>, text<String>)<Int> -> {
    return vyb_qt_checkbox_create(parent, text)
}

# true if the checkbox is checked, else false.
share(all)
qt_checkbox_checked(box<Int>)<Bool> -> {
    return vyb_qt_checkbox_checked(box) == 1
}

# Check (true) / uncheck (false) the box (enqueues QtEvent::Toggled). Returns 0.
share(all)
qt_checkbox_set_checked(box<Int>, on<Bool>)<Int> -> {
    if (on) {
        return vyb_qt_checkbox_set_checked(box, 1)
    }
    return vyb_qt_checkbox_set_checked(box, 0)
}

# Create a progress bar with range 0..max under `parent`. Returns its handle or 0.
share(all)
qt_progress_create(parent<Int>, max<Int>)<Int> -> {
    return vyb_qt_progress_create(parent, max)
}

# Set the progress value (clamped). Returns 0.
share(all)
qt_progress_set_value(bar<Int>, value<Int>)<Int> -> {
    return vyb_qt_progress_set_value(bar, value)
}

# Create a vertical box layout on window `parent`. Returns a layout handle.
share(all)
qt_vbox(parent<Int>)<Int> -> {
    return vyb_qt_vbox(parent)
}

# Create a horizontal box layout on window `parent`. Returns a layout handle.
share(all)
qt_hbox(parent<Int>)<Int> -> {
    return vyb_qt_hbox(parent)
}

# Add widget `child` to box-layout `layout`. Returns 0.
share(all)
qt_layout_add(layout<Int>, child<Int>)<Int> -> {
    return vyb_qt_layout_add(layout, child)
}

# Static widget kind (QtWidgetKind) of handle `h`, or 0 if not a widget.
share(all)
qt_kind(h<Int>)<Int> -> {
    return vyb_qt_kind(h)
}

# Number of pending control events queued since the last drains.
share(all)
qt_event_count()<Int> -> {
    return vyb_qt_event_count()
}

# Handle of the oldest queued event's widget (0 if empty).
share(all)
qt_event_handle()<Int> -> {
    return vyb_qt_event_handle()
}

# Kind of the oldest queued event (QtEvent); 0 if empty.
share(all)
qt_event_kind()<Int> -> {
    return vyb_qt_event_kind()
}

# Remove the oldest queued event. Returns 0, or -1 if empty.
share(all)
qt_event_pop()<Int> -> {
    return vyb_qt_event_pop()
}

# Pump Qt until a control event (true) or `timeout` ms lapses (false); negative waits.
share(all)
qt_wait_event(timeout<Int>)<Bool> -> {
    return vyb_qt_wait_event(timeout) == 1
}

# Run the Qt native event loop, dispatching queued control events to the qt_on_event handler, until qt_run_stop()/qt_quit(). Returns exit code.
share(all)
qt_run()<Int> -> {
    return vyb_qt_run()
}

# Stop a running qt_run() loop (graceful; GUI stays up). Returns 0, or -1 if not running.
share(all)
qt_run_stop()<Int> -> {
    return vyb_qt_run_stop()
}

# Register fn(handle, kind) called for each control event queued while qt_run() runs. Returns 0.
share(all)
qt_on_event(handler<fn(Int, Int) -> Void>)<Int> -> {
    return vyb_qt_on_event(handler)
}

# Create a combo box under `parent`; index changes enqueue QtEvent::IndexChanged.
share(all)
qt_combo_create(parent<Int>)<Int> -> {
    return vyb_qt_combo_create(parent)
}

# Append `text` as the last combo item. Returns 0.
share(all)
qt_combo_add_item(combo<Int>, text<String>)<Int> -> {
    return vyb_qt_combo_add_item(combo, text)
}

# Combo item count, or -1 on a bad handle.
share(all)
qt_combo_count(combo<Int>)<Int> -> {
    return vyb_qt_combo_count(combo)
}

# Currently selected combo index (0-based), or -1 on a bad handle.
share(all)
qt_combo_current_index(combo<Int>)<Int> -> {
    return vyb_qt_combo_current_index(combo)
}

# Select combo item `idx`. Returns 0.
share(all)
qt_combo_set_current_index(combo<Int>, idx<Int>)<Int> -> {
    return vyb_qt_combo_set_current_index(combo, idx)
}

# Text of combo item `idx` (String); "" on a bad handle/index.
share(all)
qt_combo_item_text(combo<Int>, idx<Int>)<String> -> {
    return vyb_qt_combo_item_text(combo, idx)
}

