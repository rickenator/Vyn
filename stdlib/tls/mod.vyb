# tls - TLS/SSL over OpenSSL (libssl/libcrypto).
#
# Everything crosses the runtime's `__vyb_tls_*` functions in
# `runtime/vyb_runtime.c`; the Vyb surface stays allocation/pointer-free. SSL
# and SSL_CTX are opaque pointers carried as Int. Server certificates are
# supplied as in-line PEM strings (memory BIOs - no file-path coupling), and the
# default client context verifies nothing (self-signed loopback tests). For
# real connections use `tls_client_context_verified(ca_pem)`, which trusts an
# in-line-pinned CA (or the system default CA paths) and checks the expected
# hostname in the peer certificate.
#
# Usage (client):
#   import network::{socket_open, socket_connect, socket_close, Socket}
#   import tls::{tls_client_context, tls_stream, tls_connect, tls_write,
#               tls_read, tls_close, tls_free_context, TlsContext, TlsStream}
#
#   fd = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, Socket::IPPROTO_TCP)
#   socket_connect(fd, "127.0.0.1", 8443)
#   ctx = tls_client_context()
#   s = tls_stream(ctx, fd, "localhost")
#   tls_connect(s)
#   tls_write(s, "hello")
#   echo = tls_read(s, 5)
#   tls_close(s)          // TLS shutdown + closes the fd
#   tls_free_context(ctx)
#
# Diagnostics: `tls_error_code()` (0 = no error) and `tls_error_message()`
# report the outcome of the last TLS operation, mirroring the `network` idiom.

# A holding SSL_CTX (client or server). Handles are opaque Ints.
share(all)
struct TlsContext {
    ctx<Int>,
    is_server<Bool>
}

# A TLS session bound to an already-connected fd. `ssl` is the SSL* handle;
# `ctx` remembers the parent context (mostly so tls_close/tls_free_context are
# well-behaved); `fd` is the underlying socket, closed by tls_close().
share(all)
struct TlsStream {
    ssl<Int>,
    ctx<Int>,
    is_server<Bool>,
    fd<Int>
}

# Behavior contracts giving each type its ergonomic method surface.
share(all)
aspect TlsContextOps {
    dispose(self<Self>)<Void> -> { }
}

share(all)
bind TlsContextOps -> TlsContext {
    dispose(self<Self>)<Void> -> {
        vyb_tls_ctx_free(self.ctx)
    }
}

share(all)
aspect TlsStreamOps {
    connect(self<Self>)<Int> -> { }
    accept(self<Self>)<Int> -> { }
    write(self<Self>, data<String>)<Int> -> { }
    read(self<Self>, max<Int>)<String> -> { }
    close(self<Self>)<Int> -> { }
}

share(all)
bind TlsStreamOps -> TlsStream {
    connect(self<Self>)<Int> -> { return vyb_tls_connect(self.ssl) }
    accept(self<Self>)<Int> -> { return vyb_tls_accept(self.ssl) }
    write(self<Self>, data<String>)<Int> -> { return vyb_tls_write(self.ssl, data) }
    read(self<Self>, max<Int>)<String> -> { return vyb_tls_read(self.ssl, max) }
    close(self<Self>)<Int> -> { return vyb_tls_close(self.ssl, self.fd) }
}

# A client SSL_CTX (no peer verification). Release with tls_free_context(ctx).
share(all)
tls_client_context()<TlsContext> -> {
    c<Int> = vyb_tls_client_context()
    return TlsContext { ctx = c, is_server = false }
}

# A client SSL_CTX that verifies the server against a pinned CA given as in-line
# PEM, or the system default CA paths when `ca_pem` is "". The expected hostname
# (the `host` passed to tls_stream) is checked against the certificate. Release
# with tls_free_context(ctx).
share(all)
tls_client_context_verified(ca_pem<String>)<TlsContext> -> {
    c<Int> = vyb_tls_client_context_verified(ca_pem)
    return TlsContext { ctx = c, is_server = false }
}

# A server SSL_CTX loaded from in-line PEM certificate / private-key strings.
share(all)
tls_server_context(cert_pem<String>, key_pem<String>)<TlsContext> -> {
    c<Int> = vyb_tls_server_context(cert_pem, key_pem)
    return TlsContext { ctx = c, is_server = true }
}

# Release an SSL_CTX returned by tls_client_context / tls_server_context.
share(all)
tls_free_context(ctx<TlsContext>)<Void> -> {
    vyb_tls_ctx_free(ctx.ctx)
}

# Wrap an already-connected fd in a TLS stream under `ctx`. `host` (if non-empty)
# is sent as the SNI server name. The fd is owned by the stream and closed by
# tls_close().
share(all)
tls_stream(ctx<TlsContext>, fd<Int>, host<String>)<TlsStream> -> {
    s<Int> = vyb_tls_stream(ctx.ctx, fd, host)
    return TlsStream { ssl = s, ctx = ctx.ctx, is_server = ctx.is_server, fd = fd }
}

# Complete the client handshake. Returns 0 on success, -1 on error.
share(all)
tls_connect(s<TlsStream>)<Int> -> {
    return vyb_tls_connect(s.ssl)
}

# Complete the server handshake. Returns 0 on success, -1 on error.
share(all)
tls_accept(s<TlsStream>)<Int> -> {
    return vyb_tls_accept(s.ssl)
}

# Send the whole of `data` on the stream. Returns bytes sent (or -1).
share(all)
tls_write(s<TlsStream>, data<String>)<Int> -> {
    return vyb_tls_write(s.ssl, data)
}

# Receive up to `max` decrypted bytes as a fresh String (empty on error/EOF).
share(all)
tls_read(s<TlsStream>, max<Int>)<String> -> {
    return vyb_tls_read(s.ssl, max)
}

# Shut down the TLS session and close the underlying fd.
share(all)
tls_close(s<TlsStream>)<Int> -> {
    return vyb_tls_close(s.ssl, s.fd)
}

# Diagnostic helpers: the last TLS operation's result (0 / "no error").
share(all)
tls_error_code()<Int> -> {
    return vyb_tls_error_code()
}

share(all)
tls_error_message()<String> -> {
    return vyb_tls_error_message()
}
