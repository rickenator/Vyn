# tls - TLS/SSL over OpenSSL (libssl/libcrypto).
#
# Everything crosses the runtime's `__vyb_tls_*` functions in
# `runtime/vyb_runtime.c`; the Vyb surface stays allocation/pointer-free. SSL
# and SSL_CTX are opaque pointers carried as Int. Server certificates are
# supplied as in-line PEM strings (memory BIOs - no file-path coupling), and the
# default client context verifies nothing (self-signed loopback tests). For
# real connections use `tls_client_context_verified(ca_pem)`, which trusts an
# in-line-pinned CA (or the system default CA paths) and checks the expected
# hostname in the peer certificate.
#
# The ergonomic API returns native optionals (the File?/net shape): absence *is*
# a failed context, stream, handshake, write, read, or close, so callers never
# test a `ctx.ctx < 0`, `ssl < 0`, or `-1` sentinel. `tls_write`/`write` return
# `Int?` (bytes written), `tls_read`/`read` return `String?` (lossless; absent
# only on error/EOF), `tls_close`/`close` return `Bool?`. Unwrap with `match`
# (or `else`) and escalate with `fail tls_error(op, host)` into the fail/trap
# framework via the shared `TlsError { op, host, message }` (which snapshots the
# last TLS diagnostic). A failed handshake leaves the stream's fd owned by the
# stream, so an absent `connect()`/`accept()` arm should still `tls_close` the
# receiver.
#
# Usage (client):
#   import network::{socket_open, socket_connect, socket_close, Socket}
#   import tls::{tls_client_context, tls_stream, tls_write, tls_read, tls_close,
#                tls_free_context, TlsError}
#
#   fd = socket_open(Socket::AF_INET, Socket::SOCK_STREAM, Socket::IPPROTO_TCP)
#   socket_connect(fd, "127.0.0.1", 8443)
#   match (tls_client_context()) {            # TlsContext?
#       ctx -> {
#           match (tls_stream(ctx, fd, "localhost")) {   # TlsStream?
#               s -> {
#                   match (s.connect()) {     # TlsStream?
#                       c -> {
#                          tls_write(c, "hello")
#                          echo = tls_read(c, 5) else ""
#                          tls_close(c)
#                      }
#                       ? -> { tls_close(s); fail tls_error("connect", "localhost") }
#                   }
#                   tls_free_context(ctx)
#               }
#               ? -> { socket_close(fd); fail tls_error("stream", "localhost") }
#           }
#       }
#       ? -> { fail tls_error("context", "localhost") }
#   }
#
# Diagnostics: `tls_error_code()` (0 = no error) and `tls_error_message()`
# report the result of the last low-level TLS operation.

# A holding SSL_CTX (client or server). Handles are opaque Ints.
share(all)
struct TlsContext {
    ctx<Int>,
    is_server<Bool>
}

# A TLS session bound to an already-connected fd. `ssl` is the SSL* handle;
# `ctx` remembers the parent context (mostly so tls_close/tls_free_context are
# well-behaved); `fd` is the underlying socket, closed by tls_close().
share(all)
struct TlsStream {
    ssl<Int>,
    ctx<Int>,
    is_server<Bool>,
    fd<Int>
}

# A shared error value for escalating a failed TLS operation into the fail/trap
# framework. `op` names the failing call ("context", "stream", "connect",
# "accept"); `host` is the peer host/name; `message` is the last diagnostic from
# `tls_error_message()`. Build with a literal or via `tls_error()`.
share(all)
struct TlsError {
    op<String>,
    host<String>,
    message<String>
}

# Behavior contracts giving each type its ergonomic method surface.
share(all)
aspect TlsContextOps {
    dispose(self<Self>) -> { }
}

share(all)
bind TlsContextOps -> TlsContext {
    dispose(self<Self>) -> {
        vyb_tls_ctx_free(self.ctx)
    }
}

share(all)
aspect TlsStreamOps {
    # Complete the client handshake: present on success (the connected stream),
    # absent on failure (caller should tls_close the receiver).
    connect(self<Self>)<TlsStream?> -> { }
    # Complete the server handshake (mirrors connect()).
    accept(self<Self>)<TlsStream?> -> { }
    write(self<Self>, data<String>)<Int?> -> { }
    read(self<Self>, max<Int>)<String?> -> { }
    close(self<Self>)<Bool?> -> { }
}

share(all)
bind TlsStreamOps -> TlsStream {
    connect(self<Self>)<TlsStream?> -> {
        if (vyb_tls_connect(self.ssl) == 0) { return TlsStream?(self) }
        return TlsStream?()
    }
    accept(self<Self>)<TlsStream?> -> {
        if (vyb_tls_accept(self.ssl) == 0) { return TlsStream?(self) }
        return TlsStream?()
    }
    write(self<Self>, data<String>)<Int?> -> {
        n<Int> = vyb_tls_write(self.ssl, data)
        if (n < 0) { return Int?() }
        return Int?(n)
    }
    read(self<Self>, max<Int>)<String?> -> { return vyb_tls_read_opt(self.ssl, max) }
    close(self<Self>)<Bool?> -> {
        r<Int> = vyb_tls_close(self.ssl, self.fd)
        if (r != 0) { return Bool?() }
        return Bool?(true)
    }
}

# A client SSL_CTX (no peer verification). Returns `TlsContext?` -- present on
# success, absent if the context could not be created.
share(all)
tls_client_context()<TlsContext?> -> {
    c<Int> = vyb_tls_client_context()
    if (c < 0) { return TlsContext?() }
    return TlsContext?(TlsContext { ctx = c, is_server = false })
}

# A client SSL_CTX that verifies the server against a pinned CA given as in-line
# PEM, or the system default CA paths when `ca_pem` is "". The expected hostname
# (the `host` passed to tls_stream) is checked against the certificate. Returns
# `TlsContext?` -- absent if the context could not be created.
share(all)
tls_client_context_verified(ca_pem<String>)<TlsContext?> -> {
    c<Int> = vyb_tls_client_context_verified(ca_pem)
    if (c < 0) { return TlsContext?() }
    return TlsContext?(TlsContext { ctx = c, is_server = false })
}

# A server SSL_CTX loaded from in-line PEM certificate / private-key strings.
# Returns `TlsContext?` -- absent if the context could not be created.
share(all)
tls_server_context(cert_pem<String>, key_pem<String>)<TlsContext?> -> {
    c<Int> = vyb_tls_server_context(cert_pem, key_pem)
    if (c < 0) { return TlsContext?() }
    return TlsContext?(TlsContext { ctx = c, is_server = true })
}

# Release an SSL_CTX returned by tls_client_context / tls_server_context.
share(all)
tls_free_context(ctx<TlsContext>) -> {
    vyb_tls_ctx_free(ctx.ctx)
}

# Wrap an already-connected fd in a TLS stream under `ctx`. `host` (if non-empty)
# is sent as the SNI server name. The fd is owned by the stream and closed by
# tls_close(). Returns `TlsStream?` -- present on success (a valid stream),
# absent if the session could not be created (the caller still owns/closed `fd`).
share(all)
tls_stream(ctx<TlsContext>, fd<Int>, host<String>)<TlsStream?> -> {
    s<Int> = vyb_tls_stream(ctx.ctx, fd, host)
    if (s < 0) { return TlsStream?() }
    return TlsStream?(TlsStream { ssl = s, ctx = ctx.ctx, is_server = ctx.is_server, fd = fd })
}

# Complete the client handshake: present on success, absent on failure.
share(all)
tls_connect(s<TlsStream>)<TlsStream?> -> {
    if (vyb_tls_connect(s.ssl) == 0) { return TlsStream?(s) }
    return TlsStream?()
}

# Complete the server handshake: present on success, absent on failure.
share(all)
tls_accept(s<TlsStream>)<TlsStream?> -> {
    if (vyb_tls_accept(s.ssl) == 0) { return TlsStream?(s) }
    return TlsStream?()
}

# Send the whole of `data` on the stream. Returns `Int?` -- present holding the
# number of bytes written, absent on failure.
share(all)
tls_write(s<TlsStream>, data<String>)<Int?> -> {
    n<Int> = vyb_tls_write(s.ssl, data)
    if (n < 0) { return Int?() }
    return Int?(n)
}

# Receive up to `max` decrypted bytes as a lossless `String?` -- present holding
# the bytes read (which may legitimately be empty), absent on error/EOF, so an
# empty read is never conflated with a failed read.
share(all)
tls_read(s<TlsStream>, max<Int>)<String?> -> {
    return vyb_tls_read_opt(s.ssl, max)
}

# Shut down the TLS session and close the underlying fd. Returns `Bool?` --
# present on success, absent if the close failed.
share(all)
tls_close(s<TlsStream>)<Bool?> -> {
    r<Int> = vyb_tls_close(s.ssl, s.fd)
    if (r != 0) { return Bool?() }
    return Bool?(true)
}

# Diagnostic helpers: the last low-level TLS operation's result (0 / "").
share(all)
tls_error_code()<Int> -> {
    return vyb_tls_error_code()
}

share(all)
tls_error_message()<String> -> {
    return vyb_tls_error_message()
}


# Build a `TlsError` carrying the current `tls_error_message()` diagnostic for
# the named `op` on `host`. Typical use is shaping an absent `TlsContext?` /
# `TlsStream?` / failed handshake into a fail:
#   match (tls_stream(ctx, fd, host)) { s -> body(s), ? -> { fail tls_error("stream", host) } }
share(all)
tls_error(op<String>, host<String>)<TlsError> -> {
    return TlsError { op = op, host = host, message = tls_error_message() }
}
