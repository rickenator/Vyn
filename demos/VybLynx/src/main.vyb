# vyblynx - a curses full-screen terminal browser, the flagship Vyb demo.
#
# Milestone-2 TUI shell (demos/VybLynx/RFE.md §14, §34, §37, §40): the terminal
# UI goes through the stdlib `curses` module *exclusively* - no raw libc/escape
# sequences in the browser. One owner (the UI loop) mutates the screen; network
# and content work only publish state, which the UI renders. Input is timed
# (curses_timeout) so the loop polls instead of blocking forever, laying the
# ground for a future async/select event loop.
#
#   VYB_LYNX_HOME=http://example.org  vyblynx   : open that URL at launch
#   <n>        follow numbered link           b  back
#   n / space  next page                      r  reload
#   p          previous page                  h  help
#   g          open a URL (prompt on stdin)   q  quit
#
# Reuses the pure-Vyb url/html renderers and the socket fetch core from the
# earlier line-mode iteration unchanged; only the terminal layer is new.
#
# Design note on ownership: the current page and history are kept as *locals* of
# the event loop and reassigned on each navigation (the same shape as the
# line-mode browser). A persistent `BrowserState` struct that holds a built
# `Page` is deferred: tearing one down at function return currently triggers a
# compiler/JIT double free (see TUI.md). The loop-local shape is clean and the
# single-owner screen rule still holds.

import url::{Url, parse_url, resolve_url, default_port}
import html::{Link, render_lines, extract_title}
import network
import term::{stdin_read_line}
import env
import asyncs::{async_sleep_ms}
import curses

version_id()<String> -> { return "0.1.0" }

# --- Polymorphic Display aspect on Url --------------------------------------
# RFE §3/§4: `aspect` + `bind` model browser behaviour. The general `show`
# helper (bounded on Display) renders any printable value.
bind Display -> Url {
    display(self<Url>)<String> -> {
        p<String> = self.path
        if (p == "") { p = "/" }
        suffix<String> = ""
        if (self.port != default_port(self.scheme)) {
            suffix = ":" + self.port.to_string()
        }
        return self.scheme + "://" + self.host + suffix + p
    }
}

# --- Interactive documents ---------------------------------------------------
# RFE §3: interactive page elements (here the rendered links) share behaviour
# through an aspect, bound per concrete struct.
struct Nav {
    href<String>,
    text<String>
}

aspect Interactive {
    describe(self)<String>
    target(self)<String>
}

bind Interactive -> Nav {
    describe(self)<String> -> {
        if (self.text.len() > 0) { return self.text }
        return self.href
    }
    target(self)<String> -> { return self.href }
}

# Generic bounded on Display (any printable value).
show<T<Display>>(thing<T>)<String> -> {
    return thing.display()
}

# Generic bounded on Interactive: render one numbered link marker.
link_line<T<Interactive>>(nav<T>, n<Int>)<String> -> {
    return "[" + n.to_string() + "] " + nav.describe()
}

# --- Page / response model ---------------------------------------------------
struct Page {
    title<String>,
    url<String>,
    lines<Vec<String>>,
    navs<Vec<Nav>>
}

struct Response {
    status<Int>,
    reason<String>,
    body<String>
}

blank_page()<Page> -> {
    return Page { title = "", url = "", lines = Vec(), navs = Vec() }
}

# --- Terminal size + invariant -----------------------------------------------
# `ensure` guards the invariant (RFE §20) and would fail closed to a sane
# default rather than draw into a 0-width screen. (Multi-value returns are a Vyb
# feature - see the test suite - but are avoided here while a codegen interaction
# with nested control flow is being tracked; see TUI.md.)
content_width()<Int> -> {
    vr<Int> = curses_rows()
    vc<Int> = curses_cols()
    ensure vr >= 1 && vc >= 1 else return 40
    w<Int> = vc - 2
    if (w < 20) { w = 20 }
    return w
}

# --- Security: strip control bytes from remote text --------------------------
# Content is never trusted at the screen boundary. Control bytes (except tab /
# LF / CR) become spaces by copying the safe runs between them, so a hostile
# page cannot inject terminal controls through the curses addstr path.
sanitize(s<String>)<String> -> {
    out<String> = ""
    runStart<Int> = 0
    i<Int> = 0
    n<Int> = s.len()
    while (i < n) {
        c<Int> = s.char_at(i)
        if ((c < 32 && c != 9 && c != 10 && c != 13) || c == 127) {
            if (i > runStart) { out = out + s.substring(runStart, i) }
            out = out + " "
            runStart = i + 1
        }
        i = i + 1
    }
    if (runStart < n) { out = out + s.substring(runStart, n) }
    return out
}

# --- HTTP fetch core (unchanged from the line-mode browser) ------------------
parse_int(s<String>)<Int> -> {
    n<Int> = 0
    i<Int> = 0
    neg<Bool> = false
    while (i < s.len()) {
        c<Int> = s.char_at(i)
        if (c == 45 && i == 0) {
            neg = true
        } else if (c >= 48 && c <= 57) {
            n = n * 10 + (c - 48)
        }
        i = i + 1
    }
    if (neg) { n = 0 - n }
    return n
}

header_int(head<String>, name<String>)<Int> -> {
    hl<String> = head.to_lower()
    needle<String> = name.to_lower() + ":"
    idx<Int> = hl.index_of(needle)
    if (idx < 0) { return -1 }
    rest<String> = hl.substring(idx + needle.len(), hl.len())
    nl<Int> = rest.index_of("\r\n")
    if (nl >= 0) { rest = rest.substring(0, nl) }
    return parse_int(rest.trim())
}

header_str(head<String>, name<String>)<String> -> {
    hl<String> = head.to_lower()
    needle<String> = name.to_lower() + ":"
    idx<Int> = hl.index_of(needle)
    if (idx < 0) { return "" }
    rest<String> = hl.substring(idx + needle.len(), hl.len())
    nl<Int> = rest.index_of("\r\n")
    if (nl >= 0) { rest = rest.substring(0, nl) }
    return rest.trim()
}

parse_response(raw<String>)<Response> -> {
    bad<Response> = Response { status = -1, reason = "", body = "" }
    sep<String> = "\r\n\r\n"
    idx<Int> = raw.index_of(sep)
    head<String> = raw
    body<String> = ""
    if (idx >= 0) {
        head = raw.substring(0, idx)
        body = raw.substring(idx + 4, raw.len())
    }
    first<String> = head
    nl<Int> = head.index_of("\r\n")
    if (nl >= 0) { first = head.substring(0, nl) }
    status<Int> = 0
    reason<String> = ""
    sp1<Int> = first.index_of(" ")
    if (sp1 >= 0) {
        after<String> = first.substring(sp1 + 1, first.len())
        sp2<Int> = after.index_of(" ")
        codeStr<String> = after
        if (sp2 >= 0) {
            codeStr = after.substring(0, sp2)
            reason = after.substring(sp2 + 1, after.len())
        }
        status = parse_int(codeStr)
    }
    if (status == 0) { return bad }
    cl<Int> = header_int(head, "content-length")
    if (cl >= 0 && body.len() > cl) {
        body = body.substring(0, cl)
    }
    return Response { status = status, reason = reason, body = body }
}

read_all(fd<Int>, cap<Int>)<String> -> {
    out<String> = ""
    while (out.len() < cap) {
        chunk<String> = socket_recv(fd, 16384)
        if (chunk.len() == 0) { break }
        out = out + chunk
    }
    return out
}

# Fetch one URL over HTTP: DNS, connect, request, read (capped), follow up to
# `hops` redirects, and never hang (timeouts surface as a status of -1).
fetch_url(u<Url>, hops<Int>)<Response> -> {
    bad<Response> = Response { status = -1, reason = "", body = "" }
    if (hops <= 0) { return bad }
    ip<String> = socket_resolve(u.host)
    if (ip.len() == 0) { return bad }
    domain<Int> = Socket::AF_INET
    if (ip.index_of(":") >= 0) { domain = Socket::AF_INET6 }
    fd<Int> = socket_open(domain, Socket::SOCK_STREAM, Socket::IPPROTO_TCP)
    if (fd < 0) { return bad }
    socket_set_timeout(fd, 12000)
    if (socket_connect(fd, ip, u.port) < 0) {
        socket_close(fd)
        return bad
    }
    hosthead<String> = u.host
    if (u.port != default_port(u.scheme)) {
        hosthead = u.host + ":" + u.port.to_string()
    }
    req<String> = "GET " + u.path + " HTTP/1.1\r\nHost: " + hosthead +
                  "\r\nUser-Agent: vyblynx/" + version_id() +
                  "\r\nAccept: text/html\r\nConnection: close\r\n\r\n"
    socket_send(fd, req)
    raw<String> = read_all(fd, 262144)
    socket_close(fd)
    resp<Response> = parse_response(raw)
    if (resp.status == 301 || resp.status == 302 || resp.status == 303 ||
        resp.status == 307 || resp.status == 308) {
        locStr<String> = header_str(raw, "location")
        if (locStr.len() > 0) {
            return fetch_url(parse_url(resolve_url(u, locStr)), hops - 1)
        }
    }
    return resp
}

# Render raw HTML into a Page (title, wrapped lines, resolved nav links).
build_page(htmlSource<String>, base<Url>, width<Int>)<Page> -> {
    rawLinks<Vec<Link>> = Vec()
    lines<Vec<String>> = render_lines(htmlSource, borrow(rawLinks), width)
    navs<Vec<Nav>> = Vec()
    i<Int> = 0
    while (i < rawLinks.len()) {
        abs<String> = resolve_url(base, rawLinks.get(i).raw_href)
        navs.push(Nav { href = abs, text = rawLinks.get(i).text })
        i = i + 1
    }
    return Page { title = extract_title(htmlSource), url = base.display(),
                  lines = lines, navs = navs }
}

# A page describing a transport failure, so the browser never crashes.
error_page(urlStr<String>, status<Int>)<Page> -> {
    lns<Vec<String>> = Vec()
    lns.push("unable to load: " + urlStr)
    if (status == -1) {
        lns.push("connection, DNS, or timeout failure")
    } else {
        lns.push("HTTP status " + status.to_string())
    }
    lns.push("")
    lns.push("press q to quit, b to go back, or <n> to follow a link")
    return Page { title = "error", url = urlStr, lines = lns, navs = Vec() }
}

# Structured failure: a page request that cannot be satisfied `fail`s with its
# status, and the browser `trap`s it at the navigation boundary (RFE §20/§21)
# so one bad page cannot terminate the program.
fetch_page(urlStr<String>)<Page> -> {
    page<Page> = {
        resp<Response> = fetch_url(parse_url(urlStr), 6)
        if (resp.status < 200 || resp.status >= 300) {
            fail<Int>(resp.status)
        }
        build_page(resp.body, parse_url(urlStr), content_width())
    } trap (e<Int>) -> {
        error_page(urlStr, e)
    }
    return page
}

# The status line text for a freshly loaded target.
status_for(p<their<Page>>, target<String>)<String> -> {
    if (p.title == "error") {
        return "error loading " + target
    }
    return "ok  " + p.lines.len().to_string() + " lines  " +
           p.navs.len().to_string() + " links"
}

# --- Curses drawing (single screen owner) ------------------------------------
# Only these helpers touch ncurses. Every text add is clamped to the screen and
# passed through sanitize() so page content can never inject terminal escapes.
put(row<Int>, col<Int>, text<String>, maxw<Int>)<Int> -> {
    t<String> = sanitize(text)
    if (t.len() > maxw) { t = t.substring(0, maxw) }
    return curses_move_addstr(row, col, t)
}

refresh()<Int> -> {
    return curses_refresh()
}

clear_screen()<Int> -> {
    return curses_clear()
}

draw_header(p<their<Page>>, w<Int>)<Void> -> {
    title<String> = p.title
    if (title == "") { title = p.url }
    put(0, 0, title, w)
    put(1, 0, "URL  " + p.url, w)
}

draw_body(p<their<Page>>, top<Int>, r<Int>, w<Int>)<Void> -> {
    statusRow<Int> = r - 2
    bodyRows<Int> = statusRow - 2
    if (bodyRows < 3) { bodyRows = 3 }
    l<Int> = 0
    i<Int> = top
    while (l < bodyRows && i < p.lines.len()) {
        put(2 + l, 1, p.lines.get(i), w - 2)
        l = l + 1
        i = i + 1
    }
}

draw_status(p<their<Page>>, top<Int>, status<String>, loading<Bool>, r<Int>, w<Int>)<Void> -> {
    statusRow<Int> = r - 2
    text<String> = status
    if (!loading) {
        pos<String> = ""
        if (p.lines.len() > 0) {
            pos = "  pos " + top.to_string() + "/" +
                  (p.lines.len() - 1).to_string()
        }
        text = text + pos
    }
    put(statusRow, 0, text, w)
    put(r - 1, 0, "n/p page  <n> follow  g url  b back  r reload  h help  q quit", w)
}

draw_help(r<Int>, w<Int>)<Void> -> {
    lines<Vec<String>> = Vec()
    lines.push("vyblynx " + version_id() + " - curses terminal browser")
    lines.push("")
    lines.push("  <n>        follow numbered link")
    lines.push("  n / space  next page")
    lines.push("  p          previous page")
    lines.push("  g          open a URL (prompt on the real terminal)")
    lines.push("  b          back")
    lines.push("  r          reload")
    lines.push("  d          save current document to a file (next milestone)")
    lines.push("  h          close this help")
    lines.push("  q          quit")
    lines.push("")
    lines.push("The screen is owned by the UI loop; network/content only")
    lines.push("publish state (RFE single-owner rule). Input is timed.")
    bodyRows<Int> = r - 4
    if (bodyRows > lines.len()) { bodyRows = lines.len() }
    l<Int> = 0
    while (l < bodyRows) {
        put(2 + l, 1, lines.get(l), w - 2)
        l = l + 1
    }
}

redraw(p<their<Page>>, top<Int>, status<String>, loading<Bool>, help<Bool>,
       r<Int>, w<Int>)<Void> -> {
    clear_screen()
    draw_header(p, w)
    if (help) {
        draw_help(r, w)
    } else {
        draw_body(p, top, r, w)
    }
    draw_status(p, top, status, loading, r, w)
    refresh()
}

# --- Navigation --------------------------------------------------------------
# Resolve a numbered link against the page, or absent when there is no such
# link (`T?` models the absence, RFE §12/§44).
# The navs already carry absolute hrefs resolved at build_page time, so a link
# is followed by returning the stored href (fewer string copies in the borrow).
follow_page(p<their<Page>>, n<Int>)<String?> -> {
    if (n < 1 || n > p.navs.len()) { return String?() }
    return String?(p.navs.get(n - 1).href)
}

# --- Commands ----------------------------------------------------------------
enum Cmd {
    Follow,
    NextPage,
    PrevPage,
    Back,
    Reload,
    OpenUrl,
    Help,
    Quit,
    Unknown
}

cmd_of(k<Int>)<Cmd> -> {
    if (k == 113) { return Cmd::Quit }             # q
    if (k == 110 || k == 32) { return Cmd::NextPage }  # n / space
    if (k == 112) { return Cmd::PrevPage }         # p
    if (k == 98) { return Cmd::Back }              # b
    if (k == 114) { return Cmd::Reload }           # r
    if (k == 103) { return Cmd::OpenUrl }          # g
    if (k == 104) { return Cmd::Help }             # h
    if (k >= 49 && k <= 57) { return Cmd::Follow } # 1..9
    return Cmd::Unknown
}

# --- URL prompt on the real terminal -----------------------------------------
# The curses layer exposes keys, not whole lines, and there is no char->String
# builtin yet, so opening an arbitrary URL suspends curses (endwin), reads a
# line from stdin, then resumes the screen. `T?` models "cancelled/absent".
open_url_prompt()<String?> -> {
    curses_close()
    println("vyblynx> open URL: ")
    line<String> = stdin_read_line().trim()
    if (line.len() > 0) {
        if (curses_init() == 0) {
            curses_hide_cursor()
            curses_timeout(80)
            return String?(line)
        }
        println("vyblynx: could not re-enter the screen")
        return String?()
    }
    if (curses_init() != 0) {
        println("vyblynx: could not re-enter the screen")
    }
    return String?()
}

# --- A tiny async showcase ---------------------------------------------------
# RFE §10/§11: an explicit Future object represents an outstanding operation.
# Here a warm-up fiber is started and awaited at launch; the next milestone
# makes the page fetch itself a Future so the network never blocks the UI.
async warm_up(ms<Int>)<Future<Int>> -> {
    async_sleep_ms(ms)
    return ms
}

# --- The event loop ----------------------------------------------------------
# The current page and history are loop locals (reassigned on navigation), the
# same shape as the proven-clean line-mode browser; see the header note about
# the deferred BrowserState struct.
run_browser(initial<String>)<Int> -> {
    url<String> = initial
    top<Int> = 0
    page<Page> = blank_page()
    history<Vec<String>> = Vec()
    loading<Bool> = false
    help<Bool> = false
    status<String> = "ready"
    r<Int> = curses_rows()
    c<Int> = curses_cols()

    # Initial load.
    loading = true
    status = "Loading " + url
    redraw(borrow(page), top, status, loading, help, r, c)
    page = fetch_page(url)
    loading = false
    status = status_for(borrow(page), url)
    redraw(borrow(page), top, status, loading, help, r, c)

    looping<Bool> = true
    while (looping) {
        r = curses_rows()
        c = curses_cols()
        k<Int> = curses_getch()
        if (k == -1) {
            continue
        }
        cmd<Cmd> = cmd_of(k)
        if (cmd == Cmd::Quit) {
            looping = false
        } else if (cmd == Cmd::NextPage) {
            if (!help) {
                bodyRows<Int> = r - 4
                if (bodyRows < 3) { bodyRows = 3 }
                nxt<Int> = top + bodyRows
                if (nxt < page.lines.len()) { top = nxt } else { top = 0 }
                redraw(borrow(page), top, status, loading, help, r, c)
            }
        } else if (cmd == Cmd::PrevPage) {
            if (!help) {
                bodyRows<Int> = r - 4
                if (bodyRows < 3) { bodyRows = 3 }
                prev<Int> = top - bodyRows
                if (prev < 0) { prev = 0 }
                top = prev
                redraw(borrow(page), top, status, loading, help, r, c)
            }
        } else if (cmd == Cmd::Follow) {
            if (!help) {
                n<Int> = k - 48
                dest<String> = follow_page(borrow(page), n) else ""
                if (dest.len() > 0) {
                    history.push(url)
                    loading = true
                    status = "Loading " + dest
                    redraw(borrow(page), top, status, loading, help, r, c)
                    url = dest
                    top = 0
                    page = fetch_page(dest)
                    loading = false
                    status = status_for(borrow(page), dest)
                    redraw(borrow(page), top, status, loading, help, r, c)
                } else {
                    status = "no link " + n.to_string()
                    redraw(borrow(page), top, status, loading, help, r, c)
                }
            }
        } else if (cmd == Cmd::Back) {
            if (history.len() > 0) {
                prevUrl<String> = history.get(history.len() - 1)
                history.pop()
                loading = true
                status = "Loading " + prevUrl
                redraw(borrow(page), top, status, loading, help, r, c)
                url = prevUrl
                top = 0
                page = fetch_page(prevUrl)
                loading = false
                status = status_for(borrow(page), prevUrl)
                redraw(borrow(page), top, status, loading, help, r, c)
            } else {
                status = "no history"
                redraw(borrow(page), top, status, loading, help, r, c)
            }
        } else if (cmd == Cmd::Reload) {
            target<String> = url
            loading = true
            status = "Loading " + target
            redraw(borrow(page), top, status, loading, help, r, c)
            page = fetch_page(target)
            loading = false
            status = status_for(borrow(page), target)
            redraw(borrow(page), top, status, loading, help, r, c)
        } else if (cmd == Cmd::OpenUrl) {
            target<String> = open_url_prompt() else ""
            if (target.len() > 0) {
                history.push(url)
                loading = true
                status = "Loading " + target
                redraw(borrow(page), top, status, loading, help, r, c)
                url = target
                top = 0
                page = fetch_page(target)
                loading = false
                status = status_for(borrow(page), target)
                redraw(borrow(page), top, status, loading, help, r, c)
            } else {
                redraw(borrow(page), top, status, loading, help, r, c)
            }
        } else if (cmd == Cmd::Help) {
            help = !help
            redraw(borrow(page), top, status, loading, help, r, c)
        } else {
            status = "unrecognized key - press h for help"
            redraw(borrow(page), top, status, loading, help, r, c)
        }
    }
    return 0
}

main()<Int> -> {
    if (curses_init() != 0) {
        println("vyblynx: screen unavailable - run under a real terminal/TTY")
        return 1
    }
    curses_hide_cursor()
    curses_timeout(80)

    # A background fiber is started and awaited before the loop begins.
    startup<Future<Int>> = warm_up(8)
    ok<Int> = await startup

    start<String> = env_get("VYB_LYNX_HOME")
    if (start.trim().len() == 0) {
        start = "http://example.org/"
    }

    result<Int> = {
        run_browser(start)
    } ensure -> {
        curses_show_cursor()
        curses_close()
    }

    return result
}
