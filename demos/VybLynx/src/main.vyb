# vyblynx - a curses full-screen terminal browser, the flagship Vyb demo.
#
# Milestone-2 TUI shell (demos/VybLynx/RFE.md §14, §34, §37, §40): the terminal
# UI goes through the stdlib `curses` module *exclusively* - no raw libc/escape
# sequences in the browser. One owner (the UI loop) mutates the screen; network
# and content work only publish state, which the UI renders. Input is timed
# (curses_timeout) so the loop polls instead of blocking forever, and page loads
# run as background async worker fibers so the network never blocks the UI.
#
#   VYB_LYNX_HOME=http://example.org  vyblynx   : open that URL at launch
#   <n>        follow numbered link           b  back
#   n / space  next page                      r  reload
#   p          previous page                  h  help
#   g          open a URL (prompt on stdin)   q  quit
#
# Content is fetched live through the stdlib `http`/`https` modules via a
# `ResourceProvider` aspect (dispatched by URL scheme), then rendered with the
# same pure-Vyb url/html renderers as the line-mode iteration. The terminal layer
# is curses-only and the single-owner screen rule holds.
#
# The event loop owns one `BrowserState` struct that holds the current `Page`
# and navigation history. Assigning an owned `Page`/`String` into a struct field
# (through a `their` borrow) now deep-copies / retains the source so the struct
# owns data independent of the producing local - a whole-struct store used to
# shallow-copy owned pointers and double-free them at scope exit (fixed in the
# compiler; see TUI.md). The single-owner screen rule still holds.

import url::{Url, parse_url, resolve_url, default_port}
import html::{Link, render_lines, extract_title}
import http::{http_get_full, http_header, HttpResponse}
import https::{https_get_full_verified}
import term::{stdin_read_line}
import env
import asyncs::{async_sleep_ms, async_spawn, async_poll}
import curses

version_id()<String> -> { return "0.1.0" }

# --- Polymorphic Display aspect on Url --------------------------------------
# RFE §3/§4: `aspect` + `bind` model browser behaviour. The general `show`
# helper (bounded on Display) renders any printable value.
bind Display -> Url {
    display(self<Url>)<String> -> {
        p<String> = self.path
        if (p == "") { p = "/" }
        suffix<String> = ""
        if (self.port != default_port(self.scheme)) {
            suffix = ":" + self.port.to_string()
        }
        return self.scheme + "://" + self.host + suffix + p
    }
}

# --- Interactive documents ---------------------------------------------------
# RFE §3: interactive page elements (here the rendered links) share behaviour
# through an aspect, bound per concrete struct.
struct Nav {
    href<String>,
    text<String>
}

aspect Interactive {
    describe(self)<String>
    target(self)<String>
}

bind Interactive -> Nav {
    describe(self)<String> -> {
        if (self.text.len() > 0) { return self.text }
        return self.href
    }
    target(self)<String> -> { return self.href }
}

# Generic bounded on Display (any printable value).
show<T<Display>>(thing<T>)<String> -> {
    return thing.display()
}

# Generic bounded on Interactive: render one numbered link marker.
link_line<T<Interactive>>(nav<T>, n<Int>)<String> -> {
    return "[" + n.to_string() + "] " + nav.describe()
}

# --- Page model --------------------------------------------------------------
struct Page {
    title<String>,
    url<String>,
    lines<Vec<String>>,
    navs<Vec<Nav>>
}

blank_page()<Page> -> {
    return Page { title = "", url = "", lines = Vec(), navs = Vec() }
}

# The whole browser's mutable UI/navigation state, owned by the event loop.
# Pages and history live here; subsystems publish state rather than drawing
# (RFE §41 single-owner screen). The struct owns a built `Page` and tears it
# down when run_browser returns - the case that used to double-free until owned
# struct-field assignment was fixed (see TUI.md).
struct BrowserState {
    url<String>,
    page<Page>,
    history<Vec<String>>,
    top<Int>,
    loading<Bool>,
    help<Bool>,
    status<String>,
    task<Int>,
    pending<String>,
    gen<Int>
}

# --- Terminal size + invariant -----------------------------------------------
# `ensure` guards the invariant (RFE §20) and would fail closed to a sane
# default rather than draw into a 0-width screen. Multi-value returns + nested
# destructuring are a core Vyb feature (a single `tty_dims()` pair is
# destructured here and in the event loop), and nested control flow is exercised
# by `ensure`, the `if` clamp, and the loop-local reads.
tty_dims()<Int, Int> -> {
    return curses_rows(), curses_cols()
}

content_width()<Int> -> {
    vr<Int>, vc<Int>
    vr, vc = tty_dims()
    ensure vr >= 1 && vc >= 1 else return 40
    w<Int> = vc - 2
    if (w < 20) { w = 20 }
    return w
}

# --- Security: strip control bytes from remote text --------------------------
# Content is never trusted at the screen boundary. Control bytes (except tab /
# LF / CR) become spaces by copying the safe runs between them, so a hostile
# page cannot inject terminal controls through the curses addstr path.
sanitize(s<String>)<String> -> {
    out<String> = ""
    runStart<Int> = 0
    i<Int> = 0
    n<Int> = s.len()
    while (i < n) {
        c<Int> = s.char_at(i)
        if ((c < 32 && c != 9 && c != 10 && c != 13) || c == 127) {
            if (i > runStart) { out = out + s.substring(runStart, i) }
            out = out + " "
            runStart = i + 1
        }
        i = i + 1
    }
    if (runStart < n) { out = out + s.substring(runStart, n) }
    return out
}

# --- Resource providers (RFE §3/§6/§44) -------------------------------------
# Content is fetched through a `ResourceProvider` aspect, dispatched by URL
# scheme. Each provider wraps the stdlib `http`/`https` module client, so the
# browser has no raw-socket code of its own. A bounded-generic dispatcher calls
# whichever provider's `fetch` was selected, exactly like `show<T<Display>>`.
aspect ResourceProvider {
    scheme(self)<String>
    fetch(self, u<Url>)<HttpResponse>
}

struct HttpResourceProvider {}
bind ResourceProvider -> HttpResourceProvider {
    scheme(self)<String> -> { return "http" }
    fetch(self, u<Url>)<HttpResponse> -> {
        return http_get_full(u.host, u.port, u.path)
    }
}

struct HttpsResourceProvider {}
bind ResourceProvider -> HttpsResourceProvider {
    scheme(self)<String> -> { return "https" }
    fetch(self, u<Url>)<HttpResponse> -> {
        # Verified TLS with the system trust store and hostname/SNI check.
        return https_get_full_verified(u.host, u.port, u.path, "")
    }
}

# Generic bounded on ResourceProvider: one call site for any provider.
fetch_with<T<ResourceProvider>>(p<T>, u<Url>)<HttpResponse> -> {
    return p.fetch(u)
}

# Dispatch a URL to its provider by scheme and follow up to `hops` redirects
# (a bad round-trip yields a status of -1 instead of a crash).
fetch_resource(urlStr<String>, hops<Int>)<HttpResponse> -> {
    bad<HttpResponse> = HttpResponse { status = -1, reason = "",
                                       headers = Vec<String>(), body = "" }
    if (hops <= 0) { return bad }
    u<Url> = parse_url(urlStr)
    resp<HttpResponse> = bad
    if (u.scheme == "https") {
        resp = fetch_with(HttpsResourceProvider {}, u)
    } else {
        resp = fetch_with(HttpResourceProvider {}, u)
    }
    if (resp.status == 301 || resp.status == 302 || resp.status == 303 ||
        resp.status == 307 || resp.status == 308) {
        locHdr<String> = http_header(resp, "location")
        if (locHdr.len() > 0) {
            next<String> = resolve_url(u, locHdr)
            return fetch_resource(next, hops - 1)
        }
    }
    return resp
}

# Render raw HTML into a Page (title, wrapped lines, resolved nav links).
build_page(htmlSource<String>, base<Url>, width<Int>)<Page> -> {
    rawLinks<Vec<Link>> = Vec()
    lines<Vec<String>> = render_lines(htmlSource, borrow(rawLinks), width)
    navs<Vec<Nav>> = Vec()
    i<Int> = 0
    while (i < rawLinks.len()) {
        abs<String> = resolve_url(base, rawLinks.get(i).raw_href)
        navs.push(Nav { href = abs, text = rawLinks.get(i).text })
        i = i + 1
    }
    return Page { title = extract_title(htmlSource), url = base.display(),
                  lines = lines, navs = navs }
}

# A page describing a transport failure, so the browser never crashes.
error_page(urlStr<String>, status<Int>)<Page> -> {
    lns<Vec<String>> = Vec()
    lns.push("unable to load: " + urlStr)
    if (status == -1) {
        lns.push("connection, DNS, or timeout failure")
    } else {
        lns.push("HTTP status " + status.to_string())
    }
    lns.push("")
    lns.push("press q to quit, b to go back, or <n> to follow a link")
    return Page { title = "error", url = urlStr, lines = lns, navs = Vec() }
}

# Structured failure: a page request that cannot be satisfied `fail`s with its
# status, and the browser `trap`s it at the navigation boundary (RFE §20/§21)
# so one bad page cannot terminate the program.
fetch_page_at(urlStr<String>, width<Int>)<Page> -> {
    page<Page> = {
        resp<HttpResponse> = fetch_resource(urlStr, 6)
        if (resp.status < 200 || resp.status >= 300) {
            fail<Int>(resp.status)
        }
        build_page(resp.body, parse_url(urlStr), width)
    } trap (e<Int>) -> {
        error_page(urlStr, e)
    }
    return page
}

# The status line text for a freshly loaded target.
status_for(p<their<Page>>, target<String>)<String> -> {
    if (p.title == "error") {
        return "error loading " + target
    }
    return "ok  " + p.lines.len().to_string() + " lines  " +
           p.navs.len().to_string() + " links"
}

# --- Async fetch state published by a worker fiber (RFE §8/§38) --------------
# The curses UI loop must never block on the network, so navigation spawns a
# worker fiber that does the whole fetch AND render off the main thread. A fiber
# can only return an Int, so the built `Page` comes back through these module
# globals. `fetch_req_gen` is bumped on every load_url request; a worker only
# publishes if its generation still matches (a superseded fetch can never clobber
# a newer navigation). The UI loop polls the handle each tick (non-blocking
# async_poll) and, on completion, `commit_fetch` deep-copies the published Page
# into the owned state and resets the scratch.
fetch_req_gen<Int> = 0
fetch_pub_gen<Int> = 0
fetch_pub_done<Int> = 0
fetch_pub_page<Page> = blank_page()

# Poll the in-flight navigation and, when the latest request has published,
# commit its Page to the owned state. Returns true when the screen changed.
commit_fetch(st<their<BrowserState>>)<Bool> -> {
    if (!st.loading || st.task == 0) { return false }
    res<Int> = async_poll(st.task)
    if (res < 0) { return false }
    if (fetch_pub_done == 1 && fetch_pub_gen == st.gen) {
        st.page = fetch_pub_page
        fetch_pub_page = blank_page()
        fetch_pub_done = 0
        st.task = 0
        st.loading = false
        st.status = status_for(borrow(st.page), st.pending)
        return true
    }
    return false
}

# --- Curses drawing (single screen owner) ------------------------------------
# Only these helpers touch ncurses. Every text add is clamped to the screen and
# passed through sanitize() so page content can never inject terminal escapes.
put(row<Int>, col<Int>, text<String>, maxw<Int>)<Int> -> {
    t<String> = sanitize(text)
    if (t.len() > maxw) { t = t.substring(0, maxw) }
    return curses_move_addstr(row, col, t)
}

refresh()<Int> -> {
    return curses_refresh()
}

clear_screen()<Int> -> {
    return curses_clear()
}

draw_header(p<their<Page>>, w<Int>)<Void> -> {
    title<String> = p.title
    if (title == "") { title = p.url }
    put(0, 0, title, w)
    put(1, 0, "URL  " + p.url, w)
}

draw_body(p<their<Page>>, top<Int>, r<Int>, w<Int>)<Void> -> {
    statusRow<Int> = r - 2
    bodyRows<Int> = statusRow - 2
    if (bodyRows < 3) { bodyRows = 3 }
    l<Int> = 0
    i<Int> = top
    while (l < bodyRows && i < p.lines.len()) {
        put(2 + l, 1, p.lines.get(i), w - 2)
        l = l + 1
        i = i + 1
    }
}

draw_status(p<their<Page>>, top<Int>, status<String>, loading<Bool>, r<Int>, w<Int>)<Void> -> {
    statusRow<Int> = r - 2
    text<String> = status
    if (!loading) {
        pos<String> = ""
        if (p.lines.len() > 0) {
            pos = "  pos " + top.to_string() + "/" +
                  (p.lines.len() - 1).to_string()
        }
        text = text + pos
    }
    put(statusRow, 0, text, w)
    put(r - 1, 0, "n/p page  <n> follow  g url  b back  r reload  h help  q quit", w)
}

draw_help(r<Int>, w<Int>)<Void> -> {
    lines<Vec<String>> = Vec()
    lines.push("vyblynx " + version_id() + " - curses terminal browser")
    lines.push("")
    lines.push("  <n>        follow numbered link")
    lines.push("  n / space  next page")
    lines.push("  p          previous page")
    lines.push("  g          open a URL (prompt on the real terminal)")
    lines.push("  b          back")
    lines.push("  r          reload")
    lines.push("  d          save current document to a file (next milestone)")
    lines.push("  h          close this help")
    lines.push("  q          quit")
    lines.push("")
    lines.push("The screen is owned by the UI loop; network/content only")
    lines.push("publish state (RFE single-owner rule). Input is timed.")
    bodyRows<Int> = r - 4
    if (bodyRows > lines.len()) { bodyRows = lines.len() }
    l<Int> = 0
    while (l < bodyRows) {
        put(2 + l, 1, lines.get(l), w - 2)
        l = l + 1
    }
}

redraw(p<their<Page>>, top<Int>, status<String>, loading<Bool>, help<Bool>,
       r<Int>, w<Int>)<Void> -> {
    clear_screen()
    draw_header(p, w)
    if (help) {
        draw_help(r, w)
    } else {
        draw_body(p, top, r, w)
    }
    draw_status(p, top, status, loading, r, w)
    refresh()
}

# --- Navigation --------------------------------------------------------------
# Resolve a numbered link against the page, or absent when there is no such
# link (`T?` models the absence, RFE §12/§44).
# The navs already carry absolute hrefs resolved at build_page time, so a link
# is followed by returning the stored href (fewer string copies in the borrow).
follow_page(p<their<Page>>, n<Int>)<String?> -> {
    if (n < 1 || n > p.navs.len()) { return String?() }
    return String?(p.navs.get(n - 1).href)
}

# --- Commands ----------------------------------------------------------------
enum Cmd {
    Follow,
    NextPage,
    PrevPage,
    Back,
    Reload,
    OpenUrl,
    Help,
    Quit,
    Unknown
}

cmd_of(k<Int>)<Cmd> -> {
    if (k == 113) { return Cmd::Quit }             # q
    if (k == 110 || k == 32) { return Cmd::NextPage }  # n / space
    if (k == 112) { return Cmd::PrevPage }         # p
    if (k == 98) { return Cmd::Back }              # b
    if (k == 114) { return Cmd::Reload }           # r
    if (k == 103) { return Cmd::OpenUrl }          # g
    if (k == 104) { return Cmd::Help }             # h
    if (k >= 49 && k <= 57) { return Cmd::Follow } # 1..9
    return Cmd::Unknown
}

# --- URL prompt on the real terminal -----------------------------------------
# The curses layer exposes keys, not whole lines, and there is no char->String
# builtin yet, so opening an arbitrary URL suspends curses (endwin), reads a
# line from stdin, then resumes the screen. `T?` models "cancelled/absent".
open_url_prompt()<String?> -> {
    curses_close()
    println("vyblynx> open URL: ")
    line<String> = stdin_read_line().trim()
    if (line.len() > 0) {
        if (curses_init() == 0) {
            curses_hide_cursor()
            curses_timeout(80)
            return String?(line)
        }
        println("vyblynx: could not re-enter the screen")
        return String?()
    }
    if (curses_init() != 0) {
        println("vyblynx: could not re-enter the screen")
    }
    return String?()
}

# --- A tiny async showcase ---------------------------------------------------
# RFE §10/§11: an explicit Future object represents an outstanding operation.
# A warm-up fiber is started and awaited at launch before the event loop begins.
async warm_up(ms<Int>)<Future<Int>> -> {
    async_sleep_ms(ms)
    return ms
}

# --- The event loop ----------------------------------------------------------
# One `BrowserState` is owned by the loop. Navigation commits into it by
# borrowing the struct; a freshly built `Page` is stored into the `page` field
# (an owned field, so the compiler deep-copies/transfers the source into
# independent storage) and read back via `borrow(st.page)` by the single-owner
# screen helpers.
# Start a background fetch of `target` and return immediately so the UI loop
# stays responsive (the network/TLS never runs on the main thread). The whole
# fetch AND render happen on a worker fiber, which publishes its Page into the
# module scratch; the UI loop's commit_fetch polls that task each tick and
# commits the result. `gen` is bumped per navigation so a superseded fetch can
# never clobber the newest one.
load_url(st<their<BrowserState>>, target<String>)<Void> -> {
    fetch_req_gen = fetch_req_gen + 1
    st.gen = fetch_req_gen
    st.pending = target
    st.url = target
    st.loading = true
    st.status = "Loading " + target
    st.top = 0
    r<Int>, c<Int>
    r, c = tty_dims()
    if (r < 1) { r = 24 }
    if (c < 1) { c = 80 }
    # Show the loading frame immediately so the first paint and navigation
    # feedback are instant, independent of how long the fetch takes.
    redraw(borrow(st.page), st.top, st.status, st.loading, st.help, r, c)
    wd<Int> = content_width()
    g<Int> = st.gen
    h<Int> = async_spawn(|| -> {
        pg<Page> = fetch_page_at(target, wd)
        if (fetch_req_gen == g) {
            fetch_pub_page = pg
            fetch_pub_gen = g
            fetch_pub_done = 1
        }
        return 0
    })
    if (h == 0) {
        # No worker could be scheduled: fetch synchronously on this thread so
        # navigation still works (and never hangs forever).
        st.page = fetch_page_at(target, wd)
        st.task = 0
        st.loading = false
        st.status = status_for(borrow(st.page), target)
    } else {
        st.task = h
    }
}

scroll_page(st<their<BrowserState>>, r<Int>, forward<Bool>)<Void> -> {
    bodyRows<Int> = r - 4
    if (bodyRows < 3) { bodyRows = 3 }
    if (forward) {
        nxt<Int> = st.top + bodyRows
        if (nxt < st.page.lines.len()) { st.top = nxt } else { st.top = 0 }
    } else {
        prev<Int> = st.top - bodyRows
        if (prev < 0) { prev = 0 }
        st.top = prev
    }
}

run_browser(initial<String>)<Int> -> {
    state<BrowserState> = BrowserState {
        url = initial,
        page = blank_page(),
        history = Vec(),
        top = 0,
        loading = false,
        help = false,
        status = "ready",
        task = 0,
        pending = "",
        gen = 0
    }

    load_url(borrow(state), initial)
    r<Int>, c<Int>
    r, c = tty_dims()
    if (r < 1) { r = 24 }
    if (c < 1) { c = 80 }
    redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c)

    looping<Bool> = true
    while (looping) {
        r<Int>, c<Int>
        r, c = tty_dims()
        if (r < 1) { r = 24 }
        if (c < 1) { c = 80 }
        # Non-blocking: if a background fetch finished, commit it and repaint.
        done<Bool> = commit_fetch(borrow(state))
        if (done) {
            redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c)
        }
        k<Int> = curses_getch()
        if (k == -1) {
            continue
        }
        cmd<Cmd> = cmd_of(k)
        if (cmd == Cmd::Quit) {
            looping = false
        } else if (cmd == Cmd::NextPage) {
            if (!state.help) {
                scroll_page(borrow(state), r, true)
                redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c)
            }
        } else if (cmd == Cmd::PrevPage) {
            if (!state.help) {
                scroll_page(borrow(state), r, false)
                redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c)
            }
        } else if (cmd == Cmd::Follow) {
            if (!state.help) {
                n<Int> = k - 48
                dest<String> = follow_page(borrow(state.page), n) else ""
                if (dest.len() > 0) {
                    state.history.push(state.url)
                    load_url(borrow(state), dest)
                } else {
                    state.status = "no link " + n.to_string()
                }
                redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c)
            }
        } else if (cmd == Cmd::Back) {
            if (state.history.len() > 0) {
                prevUrl<String> = state.history.get(state.history.len() - 1)
                state.history.pop()
                load_url(borrow(state), prevUrl)
            } else {
                state.status = "no history"
            }
            redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c)
        } else if (cmd == Cmd::Reload) {
            load_url(borrow(state), state.url)
            redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c)
        } else if (cmd == Cmd::OpenUrl) {
            target<String> = open_url_prompt() else ""
            if (target.len() > 0) {
                state.history.push(state.url)
                load_url(borrow(state), target)
            }
            redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c)
        } else if (cmd == Cmd::Help) {
            state.help = !state.help
            redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c)
        } else {
            state.status = "unrecognized key - press h for help"
            redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c)
        }
    }
    return 0
}

main()<Int> -> {
    if (curses_init() != 0) {
        println("vyblynx: screen unavailable - run under a real terminal/TTY")
        return 1
    }
    curses_hide_cursor()
    curses_timeout(80)

    # A background fiber is started and awaited before the loop begins.
    startup<Future<Int>> = warm_up(8)
    ok<Int> = await startup

    start<String> = env_get("VYB_LYNX_HOME")
    if (start.trim().len() == 0) {
        start = "http://example.org/"
    }

    result<Int> = {
        run_browser(start)
    } ensure -> {
        curses_show_cursor()
        curses_close()
    }

    return result
}
