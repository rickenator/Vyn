# vyblynx - a curses full-screen terminal browser, the flagship Vyb demo.
#
# Milestone-2 TUI shell (demos/VybLynx/RFE.md §14, §34, §37, §40): the terminal
# UI goes through the stdlib `curses` module *exclusively* - no raw libc/escape
# sequences in the browser. One owner (the UI loop) mutates the screen; network
# and content work only publish state, which the UI renders. Input is timed
# (curses_timeout) so the loop polls instead of blocking forever, and page loads
# run as background async worker fibers so the network never blocks the UI.
#
#   VYB_LYNX_HOME=local:///welcome.html  vyblynx : open that URL at launch
#   <n>        follow numbered link           d  download current page
#   up / down  move link focus (tab cycles)   b  back
#   enter      follow the focused link        r  reload
#   n / space  next page                      h  help
#   p          previous page                  g  type a URL in the box below
#
# Content is fetched live through the stdlib `http`/`https` modules via a
# `ResourceProvider` aspect (dispatched by URL scheme), then rendered with the
# same pure-Vyb url/html renderers as the line-mode iteration. The terminal layer
# is curses-only and the single-owner screen rule holds.
#
# RFE feature coverage at a glance:
#   aspect/bind/struct  ResourceProvider/Interactive/Display + providers & Nav
#   select              cmd_of (key classification), the scroll_page Bool
#                       direction, the run_browser command dispatcher, and the
#                       startup probe boot-status routing
#   asyncs/Future/await startup_probe() awaited then `select`ed for boot status
#   agents + channels   page downloads run on an agent worker -> dl_progress chan
#   ensure/fail/trap    screen-size invariant; fetch_page_at fails closed to an
#                       error page and is trapped at the navigation boundary
#   T? / ownership      follow_page returns String? (null = absent link) and the
#                       UI loop owns BrowserState via `their` borrows
#
# The event loop owns one `BrowserState` struct that holds the current `Page`
# and navigation history. Assigning an owned `Page`/`String` into a struct field
# (through a `their` borrow) now deep-copies / retains the source so the struct
# owns data independent of the producing local - a whole-struct store used to
# shallow-copy owned pointers and double-free them at scope exit (fixed in the
# compiler; see TUI.md). The single-owner screen rule still holds.

import url::{Url, UrlOps, parse_url, default_port, ref_scheme, is_absolute_scheme}
import html::{Link, render_lines, extract_title}
import http::{http_get_full, http_header, HttpResponse}
import https::{https_get_full_verified}
import env
import asyncs::{async_sleep_ms, async_spawn, async_poll, async_detach}
import agents
import channels
import io::{open_write, write_str, close, error_message}
import curses

version_id()<String> -> { return "0.1.0" }

# --- Polymorphic Display aspect on Url --------------------------------------
# RFE §3/§4: `aspect` + `bind` model browser behaviour. The general `show`
# helper (bounded on Display) renders any printable value.
bind Display -> Url {
    display(self<Url>)<String> -> {
        p<String> = self.path
        if (p == "") { p = "/" }
        suffix<String> = ""
        if (self.port != default_port(self.scheme)) {
            suffix = ":" + self.port.to_string()
        }
        return self.scheme + "://" + self.host + suffix + p
    }
}

# --- Interactive documents ---------------------------------------------------
# RFE §3: interactive page elements (here the rendered links) share behaviour
# through an aspect, bound per concrete struct.
struct Nav {
    href<String>,
    text<String>
}

aspect Interactive {
    describe(self)<String>
    target(self)<String>
}

bind Interactive -> Nav {
    describe(self)<String> -> {
        if (self.text.len() > 0) { return self.text }
        return self.href
    }
    target(self)<String> -> { return self.href }
}

# Generic bounded on Display (any printable value).
show<T<Display>>(thing<T>)<String> -> {
    return thing.display()
}

# Generic bounded on Interactive: render one numbered link marker.
link_line<T<Interactive>>(nav<T>, n<Int>)<String> -> {
    return "[" + n.to_string() + "] " + nav.describe()
}

# --- Page model --------------------------------------------------------------
struct Page {
    title<String>,
    url<String>,
    lines<Vec<String>>,
    navs<Vec<Nav>>
}

blank_page()<Page> -> {
    return Page { title = "", url = "", lines = Vec(), navs = Vec() }
}

# The whole browser's mutable UI/navigation state, owned by the event loop.
# Pages and history live here; subsystems publish state rather than drawing
# (RFE §41 single-owner screen). The struct owns a built `Page` and tears it
# down when run_browser returns - the case that used to double-free until owned
# struct-field assignment was fixed (see TUI.md).
struct BrowserState {
    url<String>,
    page<Page>,
    history<Vec<String>>,
    top<Int>,
    focus<Int>,
    loading<Bool>,
    help<Bool>,
    status<String>,
    task<Int>,
    pending<String>,
    gen<Int>,
    dirty<Bool>
}

# --- Download state (module scratch, owned by the UI loop) -------------------
# Downloads run on an `agents` worker fiber so the blocking network + file I/O
# never stalls the curses loop. The worker sends exactly one String result into
# this progress channel; the loop drains it with strchan_try each tick (non-
# blocking) and reports it in the status bar. `dl_running` is the agent handle
# while a transfer is in flight (0 when idle).
dl_progress<Int> = 0
dl_running<Int> = 0

# --- In-window URL editor (address bar) -------------------------------------
# Pressing `g` turns the bottom status row into a URL edit box (no more leaving
# the curses screen). Printable keys append a character, backspace removes the
# last one, enter submits, and esc cancels. While `addr_active` is set the UI
# routes every key here and `draw_status` renders the field, so the caret stays
# inside the box.
addr_text<String> = ""
addr_active<Int> = 0

# Turn a printable-ASCII key code into its one-character String. There is no
# char->String builtin yet, so the byte code addresses into a hand-ordered table
# of every printable ASCII byte, giving back a one-byte slice. Non-printable and
# extended (KEY_*) codes return "" so arrow keys never append to the URL.
printable_bytes<String> = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

char_str(k<Int>)<String> -> {
    if (k < 32 || k > 126) { return "" }
    n<Int> = k - 32
    return printable_bytes.substring(n, n + 1)
}

# --- Terminal size + invariant -----------------------------------------------
# `ensure` guards the invariant (RFE §20) and would fail closed to a sane
# default rather than draw into a 0-width screen. Multi-value returns + nested
# destructuring are a core Vyb feature (a single `tty_dims()` pair is
# destructured here and in the event loop), and nested control flow is exercised
# by `ensure`, the `if` clamp, and the loop-local reads.
tty_dims()<Int, Int> -> {
    return curses_rows(), curses_cols()
}

content_width()<Int> -> {
    vr<Int>, vc<Int>
    vr, vc = tty_dims()
    ensure vr >= 1 && vc >= 1 else return 40
    w<Int> = vc - 2
    if (w < 20) { w = 20 }
    return w
}

# --- Security: strip control bytes from remote text --------------------------
# Content is never trusted at the screen boundary. Control bytes (except tab /
# LF / CR) become spaces by copying the safe runs between them, so a hostile
# page cannot inject terminal controls through the curses addstr path.
sanitize(s<String>)<String> -> {
    out<String> = ""
    runStart<Int> = 0
    i<Int> = 0
    n<Int> = s.len()
    while (i < n) {
        c<Int> = s.char_at(i)
        # char_at yields a *signed* byte; normalize to 0..255 or every UTF-8
        # byte (>= 0x80) reads as negative and is wrongly treated as a control.
        if (c < 0) { c = c + 256 }
        if ((c < 32 && c != 9 && c != 10 && c != 13) || c == 127) {
            if (i > runStart) { out = out + s.substring(runStart, i) }
            out = out + " "
            runStart = i + 1
        }
        i = i + 1
    }
    if (runStart < n) { out = out + s.substring(runStart, n) }
    return out
}

# The module http/https clients expose the native `HttpResponse?` shape (absence
# IS a failed round-trip). The browser keeps an `HttpResponse` internally, so a
# failed request surfaces as this status -1 sentinel that navigation treats like
# any other non-2xx page.
bad_http()<HttpResponse> -> {
    return HttpResponse { status = -1, reason = "",
                          headers = Vec<String>(), body = "" }
}

# --- Resource providers (RFE §3/§6/§44) -------------------------------------
# Content is fetched through a `ResourceProvider` aspect, dispatched by URL
# scheme. Each provider wraps the stdlib `http`/`https` module client, so the
# browser has no raw-socket code of its own. A bounded-generic dispatcher calls
# whichever provider's `fetch` was selected, exactly like `show<T<Display>>`.
aspect ResourceProvider {
    scheme(self)<String>
    fetch(self, u<Url>)<HttpResponse>
}

struct HttpResourceProvider {}
bind ResourceProvider -> HttpResourceProvider {
    scheme(self)<String> -> { return "http" }
    fetch(self, u<Url>)<HttpResponse> -> {
        match (http_get_full(u.host, u.port, u.path)) {
            r -> { return r }
            ? -> { return bad_http() }
        }
    }
}

struct HttpsResourceProvider {}
bind ResourceProvider -> HttpsResourceProvider {
    scheme(self)<String> -> { return "https" }
    fetch(self, u<Url>)<HttpResponse> -> {
        # Verified TLS with the system trust store and hostname/SNI check.
        match (https_get_full_verified(u.host, u.port, u.path, "")) {
            r -> { return r }
            ? -> { return bad_http() }
        }
    }
}

# Generic bounded on ResourceProvider: one call site for any provider.
fetch_with<T<ResourceProvider>>(p<T>, u<Url>)<HttpResponse> -> {
    return p.fetch(u)
}

# --- Bundled offline pages (the `local:` scheme) ----------------------------
# VybLynx also serves a few hand-bundled pages under `local:///`, so the demo
# runs completely offline (and the home URL needs no network at all). Each page
# is ordinary HTML the shared renderer understands, kept short. They let a bare
# launch exercise focus/enter/back, an in-box URL, and agent downloads without
# a connection.

offline_welcome()<String> -> {
    return "<html><head><title>VybLynx Offline Home</title></head><body>" +
           "<p>Welcome to VybLynx: a full-screen curses terminal browser." +
           " This home page is bundled into the binary, so it loads with no network at all.</p>" +
           "<p><a href=\"/page2.html\">Open the second page</a> and " +
           "<a href=\"/about.html\">read about this build</a>.</p>" +
           "<p>Type <b>h</b> for help, <b>d</b> to download this page to a file, " +
           "and <b>g</b> to type any URL in the box at the bottom of the window.</p>" +
           "</body></html>"
}

offline_page2()<String> -> {
    return "<html><head><title>VybLynx · Second Page</title></head><body>" +
           "<p>This is page two. The back key (<b>b</b>) returns to the offline home, " +
           "and agent downloads work here too.</p>" +
           "<p><a href=\"/welcome.html\">Back to the offline home</a> and " +
           "<a href=\"/readme.txt\">a bundled plain page</a> you can download.</p>" +
           "</body></html>"
}

offline_about()<String> -> {
    return "<html><head><title>VybLynx · About</title></head><body>" +
           "<p>VybLynx is the Vyb flagship demo: a box-drawn curses browser with " +
           "color anchors, keyboard focus, history/back, background fetches, and " +
           "threaded downloads - all through the stdlib modules.</p>" +
           "<p><a href=\"/welcome.html\">Back to the offline home</a>.</p>" +
           "</body></html>"
}

offline_readme()<String> -> {
    return "<html><head><title>VybLynx README (offline)</title></head><body>" +
           "<p>This bundled plain page exercises the download (<b>d</b>) path offline: " +
           "press <b>d</b> and VybLynx saves it to a local file through the agents module.</p>" +
           "<p><a href=\"/welcome.html\">Back to the offline home</a>.</p>" +
           "</body></html>"
}

# Serve one bundled page by its local path. Unknown paths fall back to the home.
local_doc(urlStr<String>)<HttpResponse> -> {
    u<Url> = parse_url(urlStr)
    body<String> = offline_welcome()
    if (u.path == "/page2.html") { body = offline_page2() }
    else if (u.path == "/about.html") { body = offline_about() }
    else if (u.path == "/readme.txt") { body = offline_readme() }
    return HttpResponse { status = 200, reason = "OK",
                          headers = Vec<String>(), body = body }
}

# Dispatch a URL to its provider by scheme and follow up to `hops` redirects
# (a bad round-trip yields a status of -1 instead of a crash).
fetch_resource(urlStr<String>, hops<Int>)<HttpResponse> -> {
    if (hops <= 0) { return bad_http() }
    u<Url> = parse_url(urlStr)
    if (u.scheme == "local") { return local_doc(urlStr) }
    resp<HttpResponse> = bad_http()
    if (u.scheme == "https") {
        resp = fetch_with(HttpsResourceProvider {}, u)
    } else {
        resp = fetch_with(HttpResourceProvider {}, u)
    }
    if (resp.status == 301 || resp.status == 302 || resp.status == 303 ||
        resp.status == 307 || resp.status == 308) {
        locHdr<String> = http_header(resp, "location")
        if (locHdr.len() > 0) {
            next<String> = u.resolve(locHdr)
            return fetch_resource(next, hops - 1)
        }
    }
    return resp
}

# Direct-scheme fetch for the download agent. This mirrors `fetch_resource` but
# dispatches by URL scheme *without* the bounded-generic ResourceProvider aspect:
# a generic/trait bound hanging inside an agent worker thread would stall the
# download forever (the worker never publishes its result). Direct calls are used
# throughout the worker path so downloading cannot block on that edge.
download_fetch(urlStr<String>, hops<Int>)<HttpResponse> -> {
    if (hops <= 0) { return bad_http() }
    u<Url> = parse_url(urlStr)
    if (u.scheme == "local") { return local_doc(urlStr) }
    resp<HttpResponse> = bad_http()
    if (u.scheme == "https") {
        match (https_get_full_verified(u.host, u.port, u.path, "")) {
            r -> { resp = r }
            ? -> { }
        }
    } else {
        match (http_get_full(u.host, u.port, u.path)) {
            r -> { resp = r }
            ? -> { }
        }
    }
    if (resp.status == 301 || resp.status == 302 || resp.status == 303 ||
        resp.status == 307 || resp.status == 308) {
        locHdr<String> = http_header(resp, "location")
        if (locHdr.len() > 0) {
            return download_fetch(u.resolve(locHdr), hops - 1)
        }
    }
    return resp
}

# Render raw HTML into a Page (title, wrapped lines, resolved nav links).
build_page(htmlSource<String>, base<Url>, width<Int>)<Page> -> {
    rawLinks<Vec<Link>> = Vec()
    lines<Vec<String>> = render_lines(htmlSource, borrow(rawLinks), width)
    navs<Vec<Nav>> = Vec()
    i<Int> = 0
    while (i < rawLinks.len()) {
        abs<String> = base.resolve(rawLinks.get(i).raw_href)
        navs.push(Nav { href = abs, text = rawLinks.get(i).text })
        i = i + 1
    }
    return Page { title = extract_title(htmlSource), url = base.display(),
                  lines = lines, navs = navs }
}

# A page describing a transport failure, so the browser never crashes.
error_page(urlStr<String>, status<Int>)<Page> -> {
    lns<Vec<String>> = Vec()
    lns.push("unable to load: " + urlStr)
    if (status == -1) {
        lns.push("this machine appears to be offline (connection, DNS, or timeout)")
        lns.push("")
        lns.push("network pages can't be reached here, but the bundled local:")
        lns.push("pages need no network at all - press  g , type")
        lns.push("local:///welcome.html , then enter to reopen the home page.")
    } else {
        lns.push("HTTP status " + status.to_string())
        lns.push("")
        lns.push("the page returned an error status; b goes back, or g opens a")
        lns.push("new URL in the box at the bottom of the window.")
    }
    lns.push("q quit    b back    g address bar")
    return Page { title = "error", url = urlStr, lines = lns, navs = Vec() }
}

# Structured failure: a page request that cannot be satisfied `fail`s with its
# status, and the browser `trap`s it at the navigation boundary (RFE §20/§21)
# so one bad page cannot terminate the program.
fetch_page_at(urlStr<String>, width<Int>)<Page> -> {
    page<Page> = {
        resp<HttpResponse> = fetch_resource(urlStr, 6)
        if (resp.status < 200 || resp.status >= 300) {
            fail<Int>(resp.status)
        }
        build_page(resp.body, parse_url(urlStr), width)
    } trap (e<Int>) -> {
        error_page(urlStr, e)
    }
    return page
}

# The status line text for a freshly loaded target.
status_for(p<their<Page>>, target<String>)<String> -> {
    if (p.title == "error") {
        return "error loading " + target
    }
    return "ok  " + p.lines.len().to_string() + " lines  " +
           p.navs.len().to_string() + " links"
}

# --- Async fetch state published by a worker fiber (RFE §8/§38) --------------
# The curses UI loop must never block on the network, so navigation spawns a
# worker fiber that does the whole fetch AND render off the main thread. A fiber
# can only return an Int, so the built `Page` comes back through these module
# globals. `fetch_req_gen` is bumped on every load_url request; a worker only
# publishes if its generation still matches (a superseded fetch can never clobber
# a newer navigation). The UI loop polls the handle each tick (non-blocking
# async_poll) and, on completion, `commit_fetch` deep-copies the published Page
# into the owned state and resets the scratch.
fetch_req_gen<Int> = 0
fetch_pub_gen<Int> = 0
fetch_pub_done<Int> = 0
fetch_pub_page<Page> = blank_page()

# Poll the in-flight navigation and, when the latest request has published,
# commit its Page to the owned state. The completed fiber is reclaimed via
# async_detach so its stack/env is released rather than waiting for exit.
# Returns true when the screen changed.
commit_fetch(st<their<BrowserState>>)<Bool> -> {
    if (!st.loading || st.task == 0) { return false }
    res<Int> = async_poll(st.task) else -1
    if (res < 0) { return false }
    if (fetch_pub_done == 1 && fetch_pub_gen == st.gen) {
        h<Int> = st.task
        st.page = fetch_pub_page
        fetch_pub_page = blank_page()
        fetch_pub_done = 0
        st.task = 0
        st.loading = false
        st.status = status_for(borrow(st.page), st.pending)
        async_detach(h)
        return true
    }
    return false
}

# Only these helpers touch ncurses. Every text add is clamped to the screen and
# passed through sanitize() so page content can never inject terminal escapes.
# The window is a box-drawn rectangle; the header, anchors, status bar and border
# carry color pairs (with plain-attribute fallbacks when the terminal has no
# color support). Anchors appear as `[n]` markers: the focused one draws in the
# focus color/bold, the rest in the link color/bold. Color is initialized once at
# startup, and the module `color_ok` flag records whether pairs are usable.
color_ok<Int> = 1

init_colors()<Void> -> {
    if (curses_has_color() == 0) {
        color_ok = 0
        return
    }
    if (curses_start_color() != 0) {
        color_ok = 0
        return
    }
    curses_init_pair(1, CursColor::Cyan, CursColor::Default)
    curses_init_pair(2, CursColor::Red, CursColor::Default)
    curses_init_pair(3, CursColor::White, CursColor::Blue)
    curses_init_pair(4, CursColor::White, CursColor::Magenta)
    color_ok = 1
}

title_attr()<Int> -> {
    if (color_ok == 1) { return curses_color_pair(1) }
    return curses_attr_bold()
}

link_attr()<Int> -> {
    if (color_ok == 1) { return curses_color_pair(2) | curses_attr_bold() }
    return curses_attr_bold() | curses_attr_underline()
}

focus_attr()<Int> -> {
    if (color_ok == 1) { return curses_color_pair(4) | curses_attr_bold() }
    return curses_attr_reverse() | curses_attr_bold()
}

status_attr()<Int> -> {
    if (color_ok == 1) { return curses_color_pair(3) }
    return curses_attr_reverse()
}

bar_attr()<Int> -> {
    if (color_ok == 1) { return curses_color_pair(3) }
    return curses_attr_reverse()
}

put(row<Int>, col<Int>, text<String>, maxw<Int>)<Int> -> {
    t<String> = sanitize(text)
    if (t.len() > maxw) { t = t.substring(0, maxw) }
    return curses_move_addstr(row, col, t)
}

# Raw add-str for box-drawing UTF-8 cells (put()'s byte-width clamp would
# truncate a multi-byte column glyph). sanitize() still runs at the boundary.
bput(row<Int>, col<Int>, text<String>)<Int> -> {
    return curses_move_addstr(row, col, sanitize(text))
}

refresh()<Int> -> {
    return curses_refresh()
}

clear_screen()<Int> -> {
    return curses_clear()
}

# A single `[n]` marker found in a rendered line (start byte index + link number).
struct Mark { start<Int>, num<Int> }

# Scan a wrapped line for `[n]` markers (n >= 1). They drive both the colorful
# anchors and keyboard focus, and derive purely from the rendered text, so the
# html renderer needs no per-line anchor bookkeeping.
markers(s<String>)<Vec<Mark>> -> {
    out<Vec<Mark>> = Vec()
    i<Int> = 0
    n<Int> = s.len()
    while (i < n) {
        if (s.char_at(i) == 91) {
            j<Int> = i + 1
            num<Int> = 0
            got<Bool> = false
            while (j < n) {
                ch<Int> = s.char_at(j)
                if (ch < 48 || ch > 57) { break }
                num = num * 10 + (ch - 48)
                j = j + 1
                got = true
            }
            if (got && j < n && s.char_at(j) == 93) {
                out.push(Mark { start = i, num = num })
                i = j + 1
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    return out
}

body_rows(r<Int>)<Int> -> {
    b<Int> = r - 5
    if (b < 3) { b = 3 }
    return b
}

draw_hborder(row<Int>, c<Int>, left<String>, hor<String>, right<String>)<Void> -> {
    a<Int> = bar_attr()
    if (a != 0) { curses_attr_on(a) }
    bl<Int> = 0
    s<String> = left
    while (bl < c - 2) { s = s + hor; bl = bl + 1 }
    s = s + right
    bput(row, 0, s)
    if (a != 0) { curses_attr_off(a) }
}

draw_border(r<Int>, c<Int>)<Void> -> {
    draw_hborder(0, c, "┌", "─", "┐")
    l<Int> = 1
    while (l < r - 1) {
        a<Int> = bar_attr()
        if (a != 0) { curses_attr_on(a) }
        bput(l, 0, "│")
        bput(l, c - 1, "│")
        if (a != 0) { curses_attr_off(a) }
        l = l + 1
    }
    draw_hborder(r - 1, c, "└", "─", "┘")
}

draw_header(p<their<Page>>, c<Int>)<Void> -> {
    title<String> = p.title
    if (title == "") { title = p.url }
    a<Int> = title_attr()
    if (a != 0) { curses_attr_on(a) }
    put(1, 1, title, c - 2)
    if (a != 0) { curses_attr_off(a) }
    put(2, 1, "URL  " + p.url, c - 2)
}

# Draw one body line, colouring `[n]` anchors (link color) and the focused
# anchor (focus color). Non-anchor runs draw plain.
draw_line(row<Int>, col<Int>, line<String>, maxw<Int>, focus<Int>, navCount<Int>)<Void> -> {
    ms<Vec<Mark>> = markers(line)
    if (ms.len() == 0) {
        put(row, col, line, maxw)
        return
    }
    cur<Int> = 0
    m<Int> = 0
    while (m < ms.len()) {
        mk<Mark> = ms.get(m)
        numStr<String> = "[" + mk.num.to_string() + "]"
        mlen<Int> = numStr.len()
        if (mk.start > cur) {
            put(row, col + cur, line.substring(cur, mk.start), maxw)
        }
        a<Int> = 0
        if (mk.num >= 1 && mk.num <= navCount) {
            if (mk.num == focus + 1) {
                a = focus_attr()
            } else {
                a = link_attr()
            }
        }
        if (a != 0) { curses_attr_on(a) }
        put(row, col + mk.start, numStr, maxw)
        if (a != 0) { curses_attr_off(a) }
        cur = mk.start + mlen
        m = m + 1
    }
    if (cur < line.len()) {
        put(row, col + cur, line.substring(cur, line.len()), maxw)
    }
}

draw_body(p<their<Page>>, top<Int>, r<Int>, c<Int>, focus<Int>)<Void> -> {
    bodyRows<Int> = body_rows(r)
    l<Int> = 0
    i<Int> = top
    while (l < bodyRows && i < p.lines.len()) {
        draw_line(3 + l, 1, p.lines.get(i), c - 2, focus, p.navs.len())
        l = l + 1
        i = i + 1
    }
}

draw_status(p<their<Page>>, top<Int>, status<String>, loading<Bool>, r<Int>, c<Int>, focus<Int>)<Void> -> {
    statusRow<Int> = r - 2
    if (addr_active == 1) {
        field<String> = "url> " + addr_text
        a<Int> = status_attr()
        if (a != 0) { curses_attr_on(a) }
        bl<Int> = field.len()
        pad<String> = ""
        while (bl < c - 2) { pad = pad + " "; bl = bl + 1 }
        put(statusRow, 1, field + pad, c - 2)
        if (a != 0) { curses_attr_off(a) }
        # Sit the caret right after the typed text so the box edits in place.
        caret<Int> = field.len()
        if (caret >= c - 2) { caret = c - 2 }
        curses_move(statusRow, 1 + caret)
        return
    }
    text<String> = status
    if (!loading) {
        pos<String> = "  link " + focus.to_string() + "/" + p.navs.len().to_string()
        if (p.lines.len() > 0) {
            pos = pos + "  pos " + top.to_string() + "/" +
                  (p.lines.len() - 1).to_string()
        }
        text = text + pos
    }
    a<Int> = status_attr()
    if (a != 0) { curses_attr_on(a) }
    bl<Int> = text.len()
    pad<String> = ""
    while (bl < c - 2) { pad = pad + " "; bl = bl + 1 }
    put(statusRow, 1, text + pad, c - 2)
    if (a != 0) { curses_attr_off(a) }
}

draw_help(r<Int>, c<Int>)<Void> -> {
    lines<Vec<String>> = Vec()
    lines.push("vyblynx " + version_id() + " - curses terminal browser")
    lines.push("")
    lines.push("  <n> / enter   follow numbered / focused link")
    lines.push("  up / down     move link focus (tab cycles, enter opens)")
    lines.push("  n / space     next page")
    lines.push("  p             previous page")
    lines.push("  g             type a URL in the box at the bottom")
    lines.push("                (enter go, esc cancel, <-- backspace)")
    lines.push("  d             download current page to a file (agents)")
    lines.push("  b             back")
    lines.push("  r             reload")
    lines.push("  h             close this help")
    lines.push("  q             quit")
    lines.push("")
    lines.push("The screen is owned by the UI loop; network/content and")
    lines.push("downloads run on background agents/workers that publish state.")
    bodyRows<Int> = body_rows(r)
    if (bodyRows > lines.len()) { bodyRows = lines.len() }
    l<Int> = 0
    while (l < bodyRows) {
        put(3 + l, 1, lines.get(l), c - 2)
        l = l + 1
    }
}

redraw(p<their<Page>>, top<Int>, status<String>, loading<Bool>, help<Bool>,
       r<Int>, c<Int>, focus<Int>)<Void> -> {
    clear_screen()
    draw_border(r, c)
    draw_header(p, c)
    if (help) {
        draw_help(r, c)
    } else {
        draw_body(p, top, r, c, focus)
    }
    draw_status(p, top, status, loading, r, c, focus)
    refresh()
}

# --- Navigation --------------------------------------------------------------
# Resolve a numbered link against the page, or absent when there is no such
# link (`T?` models the absence, RFE §12/§44).
# The navs already carry absolute hrefs resolved at build_page time, so a link
# is followed by returning the stored href (fewer string copies in the borrow).
follow_page(p<their<Page>>, n<Int>)<String?> -> {
    if (n < 1 || n > p.navs.len()) { return String?() }
    return String?(p.navs.get(n - 1).href)
}

# --- Commands ----------------------------------------------------------------
enum Cmd {
    Follow,
    FollowEnter,
    FocusNext,
    FocusPrev,
    Download,
    NextPage,
    PrevPage,
    Back,
    Reload,
    OpenUrl,
    Help,
    Quit,
    Unknown
}

# A key code is classified by `select` (a value-returning pattern match) rather
# than a long if/else-if ladder. Int literal arms bind specific curses key codes;
# the wildcard `?` catches everything else. This is the RFE §... `select`
# flow-of-control idiom.
cmd_of(k<Int>)<Cmd> -> {
    return select (k) -> {
        113 -> Cmd::Quit,                # q
        110 -> Cmd::NextPage,            # n
        32 -> Cmd::NextPage,             # space
        112 -> Cmd::PrevPage,            # p
        98 -> Cmd::Back,                 # b
        114 -> Cmd::Reload,              # r
        103 -> Cmd::OpenUrl,             # g
        104 -> Cmd::Help,                # h
        100 -> Cmd::Download,            # d
        258 -> Cmd::FocusNext,           # down
        9 -> Cmd::FocusNext,             # tab
        259 -> Cmd::FocusPrev,           # up
        343 -> Cmd::FollowEnter,         # enter
        10 -> Cmd::FollowEnter,          # line feed
        13 -> Cmd::FollowEnter,          # carriage return
        49 -> Cmd::Follow, 50 -> Cmd::Follow, 51 -> Cmd::Follow,
        52 -> Cmd::Follow, 53 -> Cmd::Follow, 54 -> Cmd::Follow,
        55 -> Cmd::Follow, 56 -> Cmd::Follow, 57 -> Cmd::Follow,
        ? -> Cmd::Unknown
    }
}

# --- In-window URL editor helpers -------------------------------------------
# Enters address mode (`g`): starts with an empty field, shows the caret, and
# sets the module flag so the loop routes keys to the editor and draw_status
# renders the field at the bottom row. No part of this suspends the screen -
# the box stays up the whole time.
enter_address_mode()<Void> -> {
    addr_text = ""
    addr_active = 1
    curses_show_cursor()
}

# Park the edit caret just past the typed address (used after every redraw so
# the cursor never jumps back to the screen corner).
place_addr_caret(r<Int>, c<Int>)<Void> -> {
    statusRow<Int> = r - 2
    caret<Int> = 5 + addr_text.len()
    if (caret >= c - 2) { caret = c - 2 }
    curses_move(statusRow, 1 + caret)
}

# --- Async + Future driving flow of control ----------------------------------
# RFE §10/§11: an explicit Future object models an outstanding operation. The
# startup probe runs on a worker fiber (asyncs module) and is `await`ed at
# launch; the awaited result is then routed through a `select` to choose the
# browser's initial status line -- so async/await + Future + `select` cooperate
# as flow of control, not as cast-aside scaffolding.
async startup_probe(ms<Int>)<Future<Int>> -> {
    async_sleep_ms(ms)
    return 0
}

# --- The event loop ----------------------------------------------------------
# One `BrowserState` is owned by the loop. Navigation commits into it by
# borrowing the struct; a freshly built `Page` is stored into the `page` field
# (an owned field, so the compiler deep-copies/transfers the source into
# independent storage) and read back via `borrow(st.page)` by the single-owner
# screen helpers.
# Start a background fetch of `target` and return immediately so the UI loop
# stays responsive (the network/TLS never runs on the main thread). The whole
# fetch AND render happen on a worker fiber, which publishes its Page into the
# module scratch; the UI loop's commit_fetch polls that task each tick and
# commits the result. `gen` is bumped per navigation so a superseded fetch can
# never clobber the newest one.
load_url(st<their<BrowserState>>, target<String>)<Void> -> {
    st.url = target
    st.status = "Loading " + target
    if (st.task != 0) {
        # A fetch is already in flight. Coalesce instead of spawning a second
        # fiber: concurrent worker fetches (each doing its own TLS handshake /
        # page render on a private fiber stack) race the shared publish scratch
        # and can crash in libcrypto. We remember the newest target and re-issue
        # it once the current fetch commits, so only one worker is ever active.
        st.dirty = true
        return
    }
    fetch_req_gen = fetch_req_gen + 1
    st.gen = fetch_req_gen
    st.pending = target
    st.loading = true
    st.top = 0
    st.focus = 0
    r<Int>, c<Int>
    r, c = tty_dims()
    if (r < 1) { r = 24 }
    if (c < 1) { c = 80 }
    # Show the loading frame immediately so the first paint and navigation
    # feedback are instant, independent of how long the fetch takes.
    redraw(borrow(st.page), st.top, st.status, st.loading, st.help, r, c, st.focus)
    wd<Int> = content_width()
    g<Int> = st.gen
    h<Int> = async_spawn(|| -> {
        pg<Page> = fetch_page_at(target, wd)
        if (fetch_req_gen == g) {
            fetch_pub_page = pg
            fetch_pub_gen = g
            fetch_pub_done = 1
        }
        return 0
}) else 0
    if (h == 0) {
        # No worker could be scheduled: fetch synchronously on this thread so
        # navigation still works (and never hangs forever).
        st.page = fetch_page_at(target, wd)
        st.task = 0
        st.loading = false
        st.status = status_for(borrow(st.page), target)
    } else {
        st.task = h
    }
}

scroll_page(st<their<BrowserState>>, r<Int>, forward<Bool>)<Void> -> {
    bodyRows<Int> = body_rows(r)
    if (bodyRows < 3) { bodyRows = 3 }
    # The scroll direction is itself a `select` over the Bool we parsed out as a
    # bare early exit, keeping the whole function pattern-match driven.
    select (forward) -> {
        true -> {
            nxt<Int> = st.top + bodyRows
            if (nxt < st.page.lines.len()) { st.top = nxt } else { st.top = 0 }
        }
        false -> {
            prev<Int> = st.top - bodyRows
            if (prev < 0) { prev = 0 }
            st.top = prev
        }
    }
}

# --- Keyboard link focus (up/down/tab/enter) --------------------------------
# The focused link is a 0-based index into `Page.navs`; it renders as the
# highlighted `[n]` marker and follows (via enter) to its URL. Focus wraps at
# both ends, and the window auto-scrolls so the focused marker stays visible.
nav_line_index(p<their<Page>>, num<Int>)<Int> -> {
    i<Int> = 0
    while (i < p.lines.len()) {
        ms<Vec<Mark>> = markers(p.lines.get(i))
        j<Int> = 0
        while (j < ms.len()) {
            if (ms.get(j).num == num) { return i }
            j = j + 1
        }
        i = i + 1
    }
    return -1
}


# Return the focused link's href ("" when there is none). The loop follows it
# through the owned `state`, matching the numbered-`<n>` path; loading inside
# here would re-borrow a `their` param and trip a generated-code ownership
# edge (the redraw after the nested borrow crashed reading the old title).
follow_focus(st<their<BrowserState>>)<String> -> {
    if (st.page.navs.len() == 0) { return "" }
    n<Int> = st.focus + 1
    return follow_page(borrow(st.page), n) else ""
}

# --- Downloads (RFE agents): non-blocking saves via an agent worker ----------
# A download runs on a dedicated agent (its own thread) so the blocking
# network fetch + file write never stalls the curses loop. The agent sends
# exactly one String (the result) into `dl_progress`; the loop drains it each
# tick with strchan_try and reports it in the status bar, then reclaims the
# agent. `safe_file_part` keeps the on-disk name free of path separators.
safe_file_part(b<String>)<String> -> {
    out<String> = ""
    start<Int> = 0
    i<Int> = 0
    n<Int> = b.len()
    while (i < n) {
        c<Int> = b.char_at(i)
        ok<Bool> = (c >= 97 && c <= 122) || (c >= 48 && c <= 57) ||
                   c == 46 || c == 95 || c == 45
        if (!ok) {
            if (i > start) { out = out + b.substring(start, i) }
            start = i + 1
        }
        i = i + 1
    }
    if (start < n) { out = out + b.substring(start, n) }
    if (out == "") { out = "download" }
    return out
}

download_path(urlStr<String>)<String> -> {
    u<Url> = parse_url(urlStr)
    seg<String> = u.path
    m<Int> = seg.len()
    idx<Int> = -1
    k<Int> = 0
    while (k < m) {
        if (seg.char_at(k) == 47) { idx = k }
        k = k + 1
    }
    if (idx >= 0) { seg = seg.substring(idx + 1, m) }
    if (seg == "" || seg == "/") { seg = "index.html" }
    hostPart<String> = u.host
    if (hostPart == "") { hostPart = "local" }
    return safe_file_part(hostPart + "-" + seg)
}

start_download(urlStr<String>)<Void> -> {
    do<Int> = agent_start_string(|s<String>| -> {
        # Derive everything from the mailbox String `s` (stable for the whole
        # behavior run). A String local in start_download is freed when this
        # function returns - before the agent thread runs - so capturing it here
        # would be a use-after-free (the worker would see garbage instead of
        # the path). The module-global dl_progress channel stays live.
        outPath<String> = download_path(s)
        resp<HttpResponse> = download_fetch(s, 6)
        if (resp.status >= 200 && resp.status < 300) {
            match (open_write(outPath)) {
                f -> {
                    nb<Int> = write_str(f, resp.body)
                    close(f)
                    strchan_send(dl_progress, "saved " + outPath + " (" + nb.to_string() + " bytes)")
                }
                ? -> {
                    strchan_send(dl_progress, "error writing " + outPath + ": " + error_message() )
                }
            }
        } else {
            strchan_send(dl_progress, "download failed: HTTP " + resp.status.to_string())
        }
    })
    if (do == 0) {
        strchan_send(dl_progress, "download could not be started")
        return
    }
    dl_running = do
    sent<Int> = agent_send_string(do, urlStr)
    if (sent == 0) {
        dl_running = 0
        agent_close(do)
        agent_free(do)
        strchan_send(dl_progress, "download message could not be delivered")
    }
}

# Drain one download result (non-blocking) into the status bar and reclaim the
# finished agent. Returns true when the status changed (caller redraws).
poll_progress(st<their<BrowserState>>)<Bool> -> {
    msg<String> = strchan_try(dl_progress)
    if (msg.len() == 0) { return false }
    st.status = msg
    if (dl_running != 0) {
        agent_close(dl_running)
        agent_free(dl_running)
        dl_running = 0
    }
    return true
}

# `initial_status` seeds the status bar (chosen by `select` over an `await`ed
# Future in main), so the async startup probe visibly drives the UI's first line.
run_browser(initial<String>, initial_status<String>)<Int> -> {
    state<BrowserState> = BrowserState {
        url = initial,
        page = blank_page(),
        history = Vec(),
        top = 0,
        focus = 0,
        loading = false,
        help = false,
        status = initial_status,
        task = 0,
        pending = "",
        gen = 0,
        dirty = false
    }

    load_url(borrow(state), initial)
    r<Int>, c<Int>
    r, c = tty_dims()
    if (r < 1) { r = 24 }
    if (c < 1) { c = 80 }
    redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c, state.focus)

    looping<Bool> = true
    while (looping) {
        r<Int>, c<Int>
        r, c = tty_dims()
        if (r < 1) { r = 24 }
        if (c < 1) { c = 80 }
        # Commit the current fetch and drain any completed download; each
        # returns true when the screen changed.
        done<Bool> = commit_fetch(borrow(state))
        # Re-issue any navigation that arrived while a fetch was in flight: now
        # that the worker slot is free, load the newest target. Keeps at most one
        # fetch worker active, which avoids concurrent-TLS crashes.
        if (!done && state.dirty && state.task == 0) {
            state.dirty = false
            load_url(borrow(state), state.url)
            done = true
        }
        pdone<Bool> = poll_progress(borrow(state))
        if (done || pdone) {
            redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c, state.focus)
        }
        k<Int> = curses_getch()
        if (k == -1) {
            continue
        }
        # While the address bar is open every key edits the field at the bottom
        # of the box: printable bytes append, backspace removes the last char,
        # enter submits, esc cancels. Arrow/function keys are ignored so they
        # never corrupt the URL, and the caret stays put after each redraw.
        if (addr_active == 1) {
            if (k >= 32 && k <= 126) {
                addr_text = addr_text + char_str(k)
                redraw(borrow(state.page), state.top, state.status,
                       state.loading, state.help, r, c, state.focus)
                place_addr_caret(r, c)
            } else if (k == 263 || k == 127 || k == 8) {
                if (addr_text.len() > 0) {
                    addr_text = addr_text.substring(0, addr_text.len() - 1)
                }
                redraw(borrow(state.page), state.top, state.status,
                       state.loading, state.help, r, c, state.focus)
                place_addr_caret(r, c)
            } else if (k == 343 || k == 10 || k == 13) {
                target<String> = addr_text.trim()
                addr_text = ""
                addr_active = 0
                curses_hide_cursor()
                if (target.len() > 0) {
                    state.history.push(state.url)
                    load_url(borrow(state), target)
                }
                redraw(borrow(state.page), state.top, state.status,
                       state.loading, state.help, r, c, state.focus)
            } else if (k == 27) {
                addr_text = ""
                addr_active = 0
                curses_hide_cursor()
                redraw(borrow(state.page), state.top, state.status,
                       state.loading, state.help, r, c, state.focus)
            }
            continue
        }
        cmd<Cmd> = cmd_of(k)
        # Dispatch the classified command with `select` as a statement: each enum
        # variant fires a side-effecting arm (navigation, focus, scroll, ...);
        # the wildcard `?` catches unrecognized commands. This is the RFE-native
        # match-style flow of control in place of an if/else-if ladder.
        select (cmd) -> {
            Quit -> {
                looping = false
            }
            NextPage -> {
                if (!state.help) {
                    scroll_page(borrow(state), r, true)
                    redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c, state.focus)
                }
            }
            PrevPage -> {
                if (!state.help) {
                    scroll_page(borrow(state), r, false)
                    redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c, state.focus)
                }
            }
            FocusNext -> {
                if (!state.help) {
                    if (state.page.navs.len() > 0) {
                        state.focus = state.focus + 1
                        if (state.focus >= state.page.navs.len()) { state.focus = 0 }
                    }
                    if (state.page.navs.len() > 0) {
                        li<Int> = nav_line_index(borrow(state.page), state.focus + 1)
                        if (li >= 0) {
                            br<Int> = body_rows(r)
                            if (li < state.top) { state.top = li }
                            else if (li >= state.top + br) { state.top = li - br + 1 }
                        }
                    }
                    redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c, state.focus)
                }
            }
            FocusPrev -> {
                if (!state.help) {
                    if (state.page.navs.len() > 0) {
                        state.focus = state.focus - 1
                        if (state.focus < 0) { state.focus = state.page.navs.len() - 1 }
                    }
                    if (state.page.navs.len() > 0) {
                        li<Int> = nav_line_index(borrow(state.page), state.focus + 1)
                        if (li >= 0) {
                            br<Int> = body_rows(r)
                            if (li < state.top) { state.top = li }
                            else if (li >= state.top + br) { state.top = li - br + 1 }
                        }
                    }
                    redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c, state.focus)
                }
            }
            Follow -> {
                if (!state.help) {
                    n<Int> = k - 48
                    dest<String> = follow_page(borrow(state.page), n) else ""
                    if (dest.len() > 0) {
                        state.history.push(state.url)
                        load_url(borrow(state), dest)
                    } else {
                        state.status = "no link " + n.to_string()
                    }
                    redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c, state.focus)
                }
            }
            FollowEnter -> {
                if (!state.help) {
                    dest<String> = follow_focus(borrow(state))
                    if (dest.len() > 0) {
                        state.history.push(state.url)
                        load_url(borrow(state), dest)
                    } else {
                        state.status = "no links to follow"
                    }
                    redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c, state.focus)
                }
            }
            Download -> {
                if (!state.help) {
                    if (dl_running == 0) {
                        start_download(state.url)
                        state.status = "downloading " + state.url
                    } else {
                        state.status = "download already in progress"
                    }
                    redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c, state.focus)
                }
            }
            Back -> {
                if (state.history.len() > 0) {
                    prevUrl<String> = state.history.get(state.history.len() - 1)
                    state.history.pop()
                    load_url(borrow(state), prevUrl)
                } else {
                    state.status = "no history"
                }
                redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c, state.focus)
            }
            Reload -> {
                load_url(borrow(state), state.url)
                redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c, state.focus)
            }
            OpenUrl -> {
                if (!state.help) {
                    enter_address_mode()
                    redraw(borrow(state.page), state.top, state.status,
                           state.loading, state.help, r, c, state.focus)
                    place_addr_caret(r, c)
                }
            }
            Help -> {
                state.help = !state.help
                redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c, state.focus)
            }
            ? -> {
                state.status = "unrecognized key - press h for help"
                redraw(borrow(state.page), state.top, state.status, state.loading, state.help, r, c, state.focus)
            }
        }
    }
    return 0
}

main()<Int> -> {
    if (curses_init() != 0) {
        println("vyblynx: screen unavailable - run under a real terminal/TTY")
        return 1
    }
    curses_hide_cursor()
    curses_timeout(80)
    init_colors()
    dl_progress = strchan_new()

    # A background probe fiber is started and awaited before the loop begins;
    # `select` turns its result into the initial status line for the browser.
    startup<Future<Int>> = startup_probe(8)
    probe<Int> = await startup
    boot<String> = select (probe) -> {
        0 -> "ready",
        ? -> "degraded"
    }

    start<String> = env_get("VYB_LYNX_HOME")
    if (start.trim().len() == 0) {
        # Bundled offline home: the demo opens and navigates with no network.
        start = "local:///welcome.html"
    }

    result<Int> = {
        run_browser(start, boot)
    } ensure -> {
        curses_show_cursor()
        curses_close()
    }

    if (dl_running != 0) {
        agent_close(dl_running)
        agent_free(dl_running)
        dl_running = 0
    }
    if (dl_progress != 0) {
        strchan_free(dl_progress)
        dl_progress = 0
    }

    return result
}
