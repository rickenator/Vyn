// VybWeb - a small native browser using the stdlib `qt` module (QWebEngineView).
//
// Shows a QMainWindow-less web app: a window whose vertical column nests a
// horizontal toolbar (back / forward / reload / address bar / Go / Quit) BELOW a
// QtWebEngine web view that fills the window above it (the chrome ducks under
// the page, just to be different). The address bar is kept in sync with the
// current URL on every loadFinished, and the title bar tracks the page title.
// Drops you on https://www.google.com/.
//
// Behaviour hangs off a `Browser` struct via the `BrowserOps` aspect + bind:
// navigation (go / back / forward / reload), address-bar sync, title sync, and
// teardown are all methods on the struct rather than free functions juggling
// raw handles. The event handler dispatches with `select` on the QtEvent kind
// (the QtEvent constants are bound to Ints and matched with == comparison arms)
// and sub-dispatches on the widget handle with == comparison patterns against
// bound identifiers. Teardown uses `defer qt_quit()` so the GUI unwinds cleanly
// on every exit path.
//
// The window is sized from the primary screen's dimensions and DPI (80% of the
// screen, floored at 1024x768) so it comes up reasonably large on any display.
// The web view renders at 1:1 by default (Ctrl+/- adjusts zoom) and shows scrollbars for content that
// overflows its viewport — the page does not scale with the window. The address
// bar normalizes scheme-less input (weather.com -> https://weather.com) and
// Enter in the bar triggers navigation (QtEvent::editReturn). Ctrl+Plus /
// Ctrl+Minus (or Ctrl+=) zoom the rendered page in and out as window-wide
// shortcuts that arrive as QtEvent::zoomIn / zoomOut events.
//
// Requires a build with Qt5 WebEngine (CMake finds Qt5WebEngineWidgets); if the
// surface is unavailable qt_web_create returns 0 and the app reports it.
//
//   build/vyb build demos/VybWeb          # package build -> target/vybweb
//   ./demos/VybWeb/target/vybweb          # run the built executable
//
// On a headless box run with a GUI value of QT_QPA_PLATFORM (offscreen works);
// a container that restricts Chromium's namespace sandbox may need
// QTWEBENGINE_DISABLE_SANDBOX=1 (or --disable-ns-setgroups) to let the renderer
// launch. Quit with the Quit button (or Ctrl-C).

import qt

# --- Browser state -----------------------------------------------------------
# All the widget handles for one browser window, collected into a struct so the
# behaviour can hang off it via aspect + bind instead of being free functions
# that take six Int arguments.
share(all)
struct Browser {
    win<Int>,
    web<Int>,
    urlBar<Int>,
    btnBack<Int>,
    btnFwd<Int>,
    btnReload<Int>,
    btnGo<Int>,
    btnQuit<Int>
}

# --- URL normalization -------------------------------------------------------
# A scheme-less address (weather.com, www.weather.com) is an invalid QUrl and
# loads to about:blank. Normalize by prepending https:// when there is no
// scheme marker ("://") and no known special-scheme prefix. Trims whitespace.
share(all)
normalize_url(raw<String>)<String> -> {
    s<String> = raw.trim()
    if (s.index_of("://") >= 0) { return s }
    if (s.starts_with("about:") || s.starts_with("data:") || s.starts_with("file:")) { return s }
    return "https://" + s
}

# --- Behaviour bound to the Browser struct ------------------------------------
# The `BrowserOps` aspect declares the operations that act on an already-built
# Browser: navigation (go / back / forward / reload), address-bar sync, title
# sync, and teardown. The bind below implements them as methods, so the event
# handler writes `b.go()` instead of `qt_web_load(b.web, qt_edit_text(b.urlBar))`.
share(all)
aspect BrowserOps {
    go(self<Browser>)<Void>
    back(self<Browser>)<Void>
    forward(self<Browser>)<Void>
    reload(self<Browser>)<Void>
    zoom_in(self<Browser>)<Void>
    zoom_out(self<Browser>)<Void>
    sync_title(self<Browser>)<Void>
    quit(self<Browser>)<Void>
}

share(all)
bind BrowserOps -> Browser {
    # Navigate to the URL currently in the address bar (normalized).
    go(self<Browser>)<Void> -> {
        qt_web_load(self.web, normalize_url(qt_edit_text(self.urlBar)))
    }

    # Go back in history.
    back(self<Browser>)<Void> -> {
        qt_web_back(self.web)
    }

    # Go forward in history.
    forward(self<Browser>)<Void> -> {
        qt_web_forward(self.web)
    }

    # Reload the current page.
    reload(self<Browser>)<Void> -> {
        qt_web_reload(self.web)
    }

    # Zoom the rendered page in/out (Ctrl+/Ctrl- in the window). The bridge
    # clamps the zoom factor, so no bounds math here.
    zoom_in(self<Browser>)<Void> -> {
        qt_web_zoom_in(self.web)
    }
    zoom_out(self<Browser>)<Void> -> {
        qt_web_zoom_out(self.web)
    }

    # Sync the address bar and window title to the rendered page (called on
    # loadFinished). The title is only pushed when non-empty so a blank page
    # doesn't clobber the "VybWeb" default.
    sync_title(self<Browser>)<Void> -> {
        qt_edit_set_text(self.urlBar, qt_web_url(self.web))
        title<String> = qt_web_title(self.web)
        if (title != "") {
            qt_window_set_title(self.win, "VybWeb - " + title)
        }
    }

    # Tear down the GUI (terminal — do not use Qt handles afterwards).
    quit(self<Browser>)<Void> -> {
        qt_quit()
    }
}

# --- Event dispatch ----------------------------------------------------------
# The qt_on_event handler is a closure over (handle, kind). `k` arrives as a
# plain Int from FFI holding a QtEvent value (click=1, loadFinished=6,
# editReturn=11, zoomIn=12, zoomOut=13), so the outer select uses == comparison
# arms against bound constants. The inner select binds each widget handle to a
# bare identifier and dispatches with == comparison patterns. Ctrl+/- arrive as
# zoomIn/zoomOut events carrying the web handle. This replaces the old nested
# if/else ladder with a declarative pattern match — the RFE select idiom.
share(all)
handle_event(b<Browser>, h<Int>, k<Int>)<Void> -> {
    hQuit<Int>   = b.btnQuit
    hBack<Int>   = b.btnBack
    hFwd<Int>    = b.btnFwd
    hReload<Int> = b.btnReload
    hGo<Int>     = b.btnGo
    hWeb<Int>    = b.web
    hUrl<Int>    = b.urlBar
    kClick<Int>   = QtEvent::click
    kLoad<Int>    = QtEvent::loadFinished
    kReturn<Int>  = QtEvent::editReturn
    kZoomIn<Int>  = QtEvent::zoomIn
    kZoomOut<Int> = QtEvent::zoomOut
    select (k) -> {
        == kClick -> {
            select (h) -> {
                == hQuit   -> { b.quit() }
                == hBack   -> { b.back() }
                == hFwd    -> { b.forward() }
                == hReload -> { b.reload() }
                == hGo     -> { b.go() }
                ? -> { }
            }
        }
        == kLoad -> {
            if (h == hWeb) {
                b.sync_title()
            }
        }
        == kReturn -> {
            if (h == hUrl) {
                b.go()
            }
        }
        == kZoomIn -> {
            if (h == hWeb) {
                b.zoom_in()
            }
        }
        == kZoomOut -> {
            if (h == hWeb) {
                b.zoom_out()
            }
        }
        ? -> { }
    }
}

# --- Window sizing -----------------------------------------------------------
# Size the window from the primary screen's dimensions and DPI: 80% of the
# screen, floored at 1024x768 so it is never tiny. Falls back to 1100x720 when
# no screen is available (offscreen/headless without a display). The DPI is
# queried for awareness; QWebEngineView handles HiDPI rendering automatically.
share(all)
window_width()<Int> -> {
    sw<Int> = qt_screen_width() else 0
    if (sw <= 0) { return 1100 }
    w<Int> = (sw * 4) / 5   # 80% of the screen width
    if (w < 1024) { w = 1024 }
    return w
}

share(all)
window_height()<Int> -> {
    sh<Int> = qt_screen_height() else 0
    if (sh <= 0) { return 720 }
    h<Int> = (sh * 4) / 5   # 80% of the screen height
    if (h < 768) { h = 768 }
    return h
}

main()<Int> -> {
    if (qt_init() == false) {
        println("VybWeb: Qt5 unavailable in this build")
        return 1
    }

    // Size the window from the screen dimensions + DPI (reasonably large).
    winW<Int> = window_width()
    winH<Int> = window_height()
    dpi<Int> = qt_screen_dpi() else 100
    println("VybWeb: screen " + (qt_screen_width() else 0).to_string() + "x" + (qt_screen_height() else 0).to_string() + " @ " + dpi.to_string() + "%, window " + winW.to_string() + "x" + winH.to_string())

    w<Int> = qt_window_create() else 0
    if (w == 0) { return 1 }
    if (!(qt_window_resize(w, winW, winH) else false)) { return 1 }
    if (!(qt_window_set_title(w, "VybWeb") else false)) { return 1 }

    // Column layout + nested toolbar row.
    col<Int> = qt_vbox(w) else 0
    if (col == 0) { return 1 }
    bar<Int> = qt_hbox(0) else 0
    if (bar == 0) { return 1 }

    // Toolbar controls (parented to the window, placed by the toolbar row).
    // Placed on the bottom of the window, because Vyb plays like that.
    btnBack<Int> = qt_button_create(w, "< Back") else 0
    btnFwd<Int>  = qt_button_create(w, "Fwd >") else 0
    btnReload<Int> = qt_button_create(w, "Reload") else 0
    url<Int>     = qt_edit_create(w, "https://www.google.com/") else 0
    btnGo<Int>   = qt_button_create(w, "Go") else 0
    btnQuit<Int> = qt_button_create(w, "Quit") else 0

    if (!(qt_layout_add(bar, btnBack) else false)) { return 1 }
    if (!(qt_layout_add(bar, btnFwd) else false)) { return 1 }
    if (!(qt_layout_add(bar, btnReload) else false)) { return 1 }
    if (!(qt_layout_add(bar, url) else false)) { return 1 }
    if (!(qt_layout_add(bar, btnGo) else false)) { return 1 }
    if (!(qt_layout_add(bar, btnQuit) else false)) { return 1 }

    web<Int> = qt_web_create(w) else 0
    if (web == 0) {
        println("VybWeb: QtWebEngine unavailable in this build")
        qt_quit()
        return 1
    }
    // Web view fills the column; the toolbar row tucks along the BOTTOM edge
    // (Qt boxes lay out top-to-bottom, so the web goes in first, then the bar).
    // The page renders at 1:1 by default; Ctrl+/- zooms in and out; QWebEngineView shows scrollbars for
    // content that overflows its viewport.
    if (!(qt_layout_add(col, web) else false)) { return 1 }
    if (!(qt_layout_add_layout(col, bar) else false)) { return 1 }
    if (!(qt_layout_set_stretch(col, 0, 1) else false)) { return 1 }

    // Collect all handles into the Browser struct; behaviour hangs off it via
    // the BrowserOps bind above.
    b<Browser> = Browser { win = w, web = web, urlBar = url, btnBack = btnBack, btnFwd = btnFwd, btnReload = btnReload, btnGo = btnGo, btnQuit = btnQuit }

    // Navigation handler: buttons drive the page; a finished load syncs the
    // address bar and window title to the rendered page; Enter in the address
    // bar navigates. The handler dispatches with select on the QtEvent kind
    // (see handle_event above).
    if (qt_on_event(|h<Int>, k<Int>| -> {
        handle_event(b, h, k)
    }) != 0) { return 1 }

    // Build the tree before showing (offscreen visibility semantics).
    if (!(qt_window_show(w) else false)) { return 1 }

    // Start on Google and hand control to Qt's native event loop. The handler
    // (above) drives everything; defer qt_quit() unwinds the GUI cleanly on
    // every exit path (Quit button, window close, or error).
    defer qt_quit()
    qt_web_load(web, "https://www.google.com/")
    qt_run()
    return 0
}
